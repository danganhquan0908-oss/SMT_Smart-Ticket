<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0c0906" />
    <title>@ViewData["Title"] · Smart Ticket - SMT</title>
    <script>
        (function () {
            var savedTheme = 'dark';
            try { savedTheme = localStorage.getItem('smartticket_theme') || 'dark'; } catch (e) {}
            document.documentElement.setAttribute('data-theme', savedTheme);
            var savedLang = 'vi';
            try { savedLang = localStorage.getItem('smartticket_lang') || 'vi'; } catch (e) {}
            document.documentElement.setAttribute('data-lang', savedLang);
        })();
    </script>
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/smart-ticket-smt-logo-32.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="64x64" href="~/images/smart-ticket-smt-logo-64.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/images/smart-ticket-smt-logo-192.png" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/smart-ticket-smt-logo-192.png" />
    <link rel="shortcut icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/operators.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/operator-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/redesign.css" asp-append-version="true" />
</head>
<body>
    <!-- AMBIENT METALLIC GLOW CANVAS (FOR IPHONE FROSTED GLASS REFRACTION) -->
    <div class="ambient-glow-canvas" aria-hidden="true">
        <div class="glow-orb orb-crimson"></div>
        <div class="glow-orb orb-purple"></div>
        <div class="glow-orb orb-rose"></div>
        <div class="glow-orb orb-bronze"></div>
    </div>

    <header class="topbar">
        <div class="topbar-inner">
            @if (User.IsInRole("OPERATOR_OWNER") || User.IsInRole("OPERATOR_DISPATCHER"))
            {
                <a class="brand" asp-controller="OperatorPortal" asp-action="Index">
                    <span class="brand-mark small"><img src="~/images/smart-ticket-smt-logo.png" alt="SMT Logo" asp-append-version="true" /></span>
                    <span class="brand-name">Smart Ticket<small data-i18n="brand_operator_slogan">SMT · ĐỐI TÁC NHÀ XE</small></span>
                </a>
            }
            else if (User.IsInRole("STATION_AGENT"))
            {
                <a class="brand" asp-controller="StationPortal" asp-action="Index">
                    <span class="brand-mark small"><img src="~/images/smart-ticket-smt-logo.png" alt="SMT Logo" asp-append-version="true" /></span>
                    <span class="brand-name">Smart Ticket<small data-i18n="brand_station_slogan">SMT · VẬN HÀNH BẾN</small></span>
                </a>
            }
            else
            {
                <a class="brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark small"><img src="~/images/smart-ticket-smt-logo.png" alt="SMT Logo" asp-append-version="true" /></span>
                    <span class="brand-name">Smart Ticket<small data-i18n="brand_slogan">SMT · VẠN DẶM BÌNH AN</small></span>
                </a>
            }

            <nav class="main-nav">
                @if (User.IsInRole("OPERATOR_OWNER") || User.IsInRole("OPERATOR_DISPATCHER"))
                {
                    <a asp-controller="OperatorPortal" asp-action="Index" data-i18n="nav_overview">Tổng quan</a>
                    <a asp-controller="OperatorPortal" asp-action="SeatTemplates" data-i18n="nav_seat_templates">Sơ đồ xe</a>
                    <a asp-controller="OperatorPortal" asp-action="Vehicles" data-i18n="nav_vehicles">Phương tiện</a>
                    <a asp-controller="OperatorPortal" asp-action="Drivers" data-i18n="nav_drivers">Tài xế</a>
                    <a asp-controller="OperatorPortal" asp-action="Trips" data-i18n="nav_trips">Chuyến xe</a>
                    <a asp-controller="StationPortal" asp-action="Index" data-i18n="nav_station">Cổng bến</a>
                    @if (User.IsInRole("OPERATOR_OWNER"))
                    {
                        <a asp-controller="OperatorFinance" asp-action="Index" data-i18n="nav_finance">Đối soát</a>
                    }
                }
                else if (User.IsInRole("STATION_AGENT"))
                {
                    <a asp-controller="StationPortal" asp-action="Index" data-i18n="nav_gate">Soát vé & xuất bến</a>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Index" data-i18n="nav_home">Tìm chuyến</a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Account" asp-action="Tickets" data-i18n="nav_my_tickets">🎟️ Vé của tôi</a>
                        <a asp-controller="Account" asp-action="Profile" data-i18n="nav_my_profile">👤 Hồ sơ</a>
                    }
                    @if (User.IsInRole("SUPER_ADMIN"))
                    {
                        <a asp-controller="Stations" asp-action="Index" data-i18n="nav_stations_admin">Bến xe</a>
                        <a asp-controller="Routes" asp-action="Index" data-i18n="nav_routes_admin">Tuyến đường</a>
                        <a asp-controller="Operators" asp-action="Index" data-i18n="nav_operators_admin">Nhà xe</a>
                        <a asp-controller="StationPortal" asp-action="Index" data-i18n="nav_gate">Cổng soát vé</a>
                    }
                }
            </nav>

            <div class="account-area">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Account" asp-action="Profile" class="user-chip-link" title="Xem hồ sơ cá nhân" data-i18n-title="nav_profile_tooltip">
                        <span class="admin-label"><i></i> @User.Identity.Name</span>
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="logout-button" data-i18n="nav_logout">Đăng xuất</button>
                    </form>
                }
                else
                {
                    <a class="login-link" asp-controller="Account" asp-action="Login">
                        <span data-i18n="nav_login">Đăng nhập</span> <span>↗</span>
                    </a>
                }
            </div>

            <!-- CONTROLS: BILINGUAL VI/EN & LIGHT/DARK THEME TOGGLE (PORTFOLIO STYLE) -->
            <div class="topbar-controls">
                <div class="lang-switch-pill" role="group" aria-label="Language selection">
                    <button type="button" class="lang-option active" data-lang="vi" id="btn-lang-vi" title="Tiếng Việt">VI</button>
                    <button type="button" class="lang-option" data-lang="en" id="btn-lang-en" title="English">EN</button>
                </div>

                <button type="button" class="theme-toggle-btn" id="btn-theme-toggle" aria-label="Toggle light/dark theme" title="Chuyển đổi giao diện Sáng / Tối">
                    <span class="theme-icon icon-sun" aria-hidden="true">☼</span>
                    <span class="theme-icon icon-moon" aria-hidden="true">☾</span>
                </button>
            </div>
        </div>
    </header>

    <main class="app-main">@RenderBody()</main>
    
    <footer class="site-footer">
        <span data-i18n="footer_copy">© @DateTime.UtcNow.Year Smart Ticket - SMT</span>
        <span data-i18n="footer_slogan">Vạn dặm bình an, chọn chỗ dễ dàng.</span>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
