@model IReadOnlyList<SmartTicket.Application.Operations.OperationsTripDto>
@{
    ViewData["Title"] = "Cổng Soát Vé & Lệnh Xuất Bến - Smart Ticket";
    var trips = Model ?? Array.Empty<SmartTicket.Application.Operations.OperationsTripDto>();
    var scheduledTrips = trips.Where(x => x.Status == "Scheduled" && !x.HasApprovedDispatch).ToList();
    var approvedTrips = trips.Where(x => x.HasApprovedDispatch && x.Status == "Scheduled").ToList();
    var runningTrips = trips.Where(x => x.Status == "Running").ToList();
    var completedTrips = trips.Where(x => x.Status == "Completed").ToList();
    var totalSold = trips.Sum(x => x.TicketCount);
    var totalCheckedIn = trips.Sum(x => x.CheckedInCount);
}

@Html.AntiForgeryToken()

<div class="station-cockpit-shell">
    <!-- COCKPIT TOPBAR -->
    <header class="cockpit-header">
        <div class="header-left">
            <span class="eyebrow-smt">
                <span class="pulse-dot"></span>
                SMT GATE CONTROL SYSTEM · VẬN HÀNH BẾN XE ĐIỆN TỬ
            </span>
            <h1 class="cockpit-title">Cổng Soát Vé & Cấp Lệnh Xuất Bến</h1>
            <p class="cockpit-subtitle">
                Xác thực mã QR vé siêu tốc (&lt;200ms), cảnh báo âm thanh chống tái sử dụng vé, kiểm định an toàn và ký số lệnh xuất bến.
            </p>
        </div>
        <div class="header-right">
            <div class="clock-badge" id="station-clock">--:--:-- · GMT+7</div>
            <div class="cockpit-pill-group">
                <span class="net-pill online" id="net-status">
                    <i class="dot"></i>
                    <span>Trực tuyến (Online)</span>
                </span>
                <span class="queue-pill" id="sync-badge" title="Lượt quét ngoại tuyến chờ gửi về máy chủ">
                    <span id="queue-count">0</span> vé chờ đồng bộ
                </span>
                <button type="button" class="btn-sync-action" id="btn-sync-now" style="display: none;">Đồng bộ ngay</button>
            </div>
            <div class="user-role-chip">
                <span class="role-icon">🛡️</span>
                <span>@ViewBag.UserRole</span>
            </div>
        </div>
    </header>

    <!-- METRICS STRIP -->
    <div class="kpi-strip">
        <div class="kpi-card">
            <span class="kpi-label">TỔNG CHUYẾN TẠI BẾN</span>
            <strong class="kpi-value">@trips.Count</strong>
            <small class="kpi-sub">@scheduledTrips.Count chuyến chờ kiểm định</small>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">TỔNG VÉ ĐÃ BÁN</span>
            <strong class="kpi-value">@totalSold</strong>
            <small class="kpi-sub">Trên các chuyến được phân công</small>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">HÀNH KHÁCH ĐÃ CHECK-IN</span>
            <strong class="kpi-value text-green">@totalCheckedIn</strong>
            <small class="kpi-sub">@(totalSold > 0 ? (totalCheckedIn * 100 / totalSold) : 0)% đã qua cổng bến</small>
        </div>
        <div class="kpi-card highlight-dod">
            <span class="kpi-label">ĐỘ TRỄ XÁC THỰC (DoD &lt; 200ms)</span>
            <strong class="kpi-value text-accent" id="live-latency">⚡ -- ms</strong>
            <small class="kpi-sub" id="dod-status">Sẵn sàng đo tốc độ</small>
        </div>
    </div>

    <!-- MAIN COCKPIT GRID -->
    <div class="cockpit-grid">
        <!-- SCANNER COCKPIT (LEFT) -->
        <section class="scanner-cockpit-panel">
            <div class="panel-head">
                <div class="panel-title-wrap">
                    <span class="panel-icon">🎟️</span>
                    <div>
                        <h2>Trạm Soát Vé Tự Động</h2>
                        <span class="panel-desc">Sử dụng máy quét mã vạch (Barcode Gun) hoặc Camera</span>
                    </div>
                </div>
                <div class="panel-actions">
                    <button type="button" class="btn-sound-toggle" id="btn-sound-toggle" title="Bật/Tắt âm thanh cảnh báo">
                        <span id="sound-icon">🔊</span> Âm thanh: <strong id="sound-state">BẬT</strong>
                    </button>
                </div>
            </div>

            <!-- DEV / DEMO TESTING BAR -->
            <div class="dev-quick-test-bar">
                <span class="dev-tag">DEMO TEST:</span>
                <button type="button" class="btn-dev-action" id="btn-load-sample" title="Tự động nạp mã vé thật từ cơ sở dữ liệu để quét">
                    ⚡ Thử quét vé thật (Demo Ticket)
                </button>
                <button type="button" class="btn-dev-action alarm-btn" id="btn-load-duplicate" title="Quét lại vé đã check-in để thử còi báo động và viền đỏ chớp">
                    🚨 Thử quét vé đã dùng lần 2 (Alarm)
                </button>
                <button type="button" class="btn-dev-action" id="btn-toggle-offline-sim" title="Bật chế độ mất mạng để thử hàng đợi POS và xác thực ngoại tuyến">
                    📴 Giả lập Mất mạng (Offline POS)
                </button>
            </div>

            <!-- SCANNER INPUT BAR -->
            <div class="scanner-input-container">
                <div class="scanner-input-box">
                    <span class="input-prefix-icon">🔍</span>
                    <input id="ticket-token" 
                           type="text" 
                           placeholder="Quét mã QR trên vé hoặc nhập mã JWT..." 
                           autocomplete="off" 
                           autofocus />
                    <button type="button" class="btn-clear-input" id="btn-clear" title="Xóa ô nhập">&times;</button>
                </div>
                <div class="scanner-btn-group">
                    <button type="button" class="btn-smt-primary" id="verify-ticket">
                        <span>Xác thực vé</span>
                        <kbd>Enter</kbd>
                    </button>
                    <button type="button" class="btn-smt-outline" id="start-camera">
                        <span>📷 Mở Camera</span>
                    </button>
                </div>
            </div>

            <!-- CAMERA VIEWFINDER (TOGGLEABLE) -->
            <div class="camera-viewfinder-wrapper" id="camera-wrapper" style="display: none;">
                <div class="camera-frame">
                    <video id="camera" playsinline></video>
                    <div class="reticle-overlay">
                        <div class="reticle-corner top-left"></div>
                        <div class="reticle-corner top-right"></div>
                        <div class="reticle-corner bottom-left"></div>
                        <div class="reticle-corner bottom-right"></div>
                        <div class="laser-scanner-line"></div>
                        <div class="reticle-hint">Hướng khung camera vào mã QR vé</div>
                    </div>
                </div>
                <div class="camera-controls-bar">
                    <button type="button" class="btn-cam-switch" id="btn-cam-switch">🔄 Đổi Camera</button>
                    <button type="button" class="btn-cam-close" id="btn-cam-close">✕ Tắt Camera</button>
                </div>
            </div>

            <!-- RESULT DISPLAY CARD -->
            <div id="scan-result-card" class="scan-result-card idle">
                <div class="result-status-icon" id="res-icon">🛡️</div>
                <div class="result-body">
                    <div class="result-headline" id="res-headline">SẴN SÀNG SOÁT VÉ</div>
                    <div class="result-main-text" id="res-message">Hướng máy quét barcode hoặc camera vào mã QR trên vé hành khách.</div>
                    
                    <div class="result-meta-grid" id="res-meta-grid" style="display: none;">
                        <div class="meta-item seat-highlight">
                            <span class="meta-label">SỐ GHẾ</span>
                            <strong class="meta-val" id="res-seat-code">--</strong>
                        </div>
                        <div class="meta-item">
                            <span class="meta-label">TUYẾN ĐƯỜNG</span>
                            <span class="meta-val" id="res-trip-name">--</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-label">GIỜ KHỞI HÀNH</span>
                            <span class="meta-val" id="res-departure-time">--</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-label">TỐC ĐỘ XÁC THỰC</span>
                            <span class="meta-val text-green" id="res-scan-time">-- ms</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- AUDIT LOG: RECENT SCANS -->
            <div class="recent-scans-block">
                <div class="recent-scans-head">
                    <h3>Nhật ký lượt quét gần nhất trong ca</h3>
                    <button type="button" class="btn-clear-log" id="btn-clear-log">Xóa nhật ký ca</button>
                </div>
                <div class="table-scroll-mini">
                    <table class="recent-table">
                        <thead>
                            <tr>
                                <th>Thời gian</th>
                                <th>Ghế</th>
                                <th>Chuyến</th>
                                <th>Trạng thái</th>
                                <th>Chế độ</th>
                                <th>Độ trễ</th>
                            </tr>
                        </thead>
                        <tbody id="recent-scans-body">
                            <tr class="empty-row">
                                <td colspan="6">Chưa có lượt quét nào trong phiên làm việc này.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- STATION TRIPS & DISPATCH CLEARANCE (RIGHT) -->
        <section class="trips-manifest-panel">
            <div class="panel-head">
                <div class="panel-title-wrap">
                    <span class="panel-icon">🚌</span>
                    <div>
                        <h2>Danh Sách Chuyến & Lệnh Xuất Bến</h2>
                        <span class="panel-desc">Kiểm soát hành trình, tải khách và cấp lệnh xuất bến điện tử</span>
                    </div>
                </div>
                <div class="filter-chip-group">
                    <button type="button" class="filter-chip active" data-filter="all">Tất cả (@trips.Count)</button>
                    <button type="button" class="filter-chip" data-filter="scheduled">Chờ duyệt (@scheduledTrips.Count)</button>
                    <button type="button" class="filter-chip" data-filter="approved">Đã duyệt (@approvedTrips.Count)</button>
                    <button type="button" class="filter-chip" data-filter="running">Đang chạy (@runningTrips.Count)</button>
                </div>
            </div>

            <div class="trips-list-container">
                @if (trips.Count == 0)
                {
                    <div class="no-trips-card">
                        <span class="no-trips-icon">🏢</span>
                        <h3>Chưa có chuyến xe liên quan</h3>
                        <p>Hiện không có chuyến xe nào xuất bến hoặc cập bến tại bến xe được phân công của bạn.</p>
                    </div>
                }

                @foreach (var trip in trips)
                {
                    var departLocal = trip.DepartureTimeUtc.AddHours(7);
                    var percent = trip.TicketCount > 0 ? (trip.CheckedInCount * 100 / trip.TicketCount) : 0;
                    var filterClass = trip.Status == "Scheduled" 
                        ? (trip.HasApprovedDispatch ? "cat-approved" : "cat-scheduled") 
                        : (trip.Status == "Running" ? "cat-running" : "cat-completed");

                    <article class="trip-manifest-card @filterClass" data-trip-id="@trip.Id">
                        <div class="card-main-info">
                            <div class="route-line-badge">
                                <strong class="route-name">@trip.DepartureStation → @trip.ArrivalStation</strong>
                                <span class="depart-clock">Khởi hành: <strong>@departLocal.ToString("HH:mm")</strong> (@departLocal.ToString("dd/MM/yyyy"))</span>
                            </div>
                            
                            <div class="vehicle-driver-row">
                                <span class="op-badge">@trip.Operator</span>
                                <span class="plate-badge-smt">@trip.VehiclePlate</span>
                                <span class="driver-info">
                                    Tài xế: <strong>@trip.Driver</strong> 
                                    @if (!string.IsNullOrWhiteSpace(trip.DriverPhone))
                                    {
                                        <a href="tel:@trip.DriverPhone" class="tel-link">📞 @trip.DriverPhone</a>
                                    }
                                </span>
                            </div>

                            <!-- BOARDING PROGRESS BAR -->
                            <div class="boarding-progress-block">
                                <div class="progress-labels">
                                    <span>Hành khách đã soát vé: <strong>@trip.CheckedInCount / @trip.TicketCount vé</strong> (@percent%)</span>
                                    <span>Sức chứa xe: <strong>@trip.TotalCapacity ghế</strong></span>
                                </div>
                                <div class="progress-track">
                                    <div class="progress-fill" style="width: @percent%;"></div>
                                </div>
                            </div>
                        </div>

                        <!-- STATUS & DISPATCH BADGE -->
                        <div class="card-status-actions">
                            <div class="dispatch-status-banner">
                                @if (trip.HasApprovedDispatch)
                                {
                                    <div class="badge-approved-dispatch" title="Đã ký duyệt xuất bến điện tử">
                                        <span class="check-icon">✓</span>
                                        <div>
                                            <strong>ĐÃ CẤP LỆNH XUẤT BẾN</strong>
                                            <small>Ký số: @(trip.DispatchSignature?.Substring(0, Math.Min(16, trip.DispatchSignature?.Length ?? 0)) ?? "APPROVED")...</small>
                                        </div>
                                    </div>
                                }
                                else if (trip.Status == "Scheduled")
                                {
                                    <div class="badge-pending-dispatch">
                                        <span class="clock-icon">⏳</span>
                                        <div>
                                            <strong>CHỜ KIỂM ĐỊNH & CẤP LỆNH</strong>
                                            <small>Cần hoàn tất 4 tiêu chuẩn an toàn</small>
                                        </div>
                                    </div>
                                }
                                else if (trip.Status == "Running")
                                {
                                    <div class="badge-running-dispatch">
                                        <span class="bus-icon">🚀</span>
                                        <div>
                                            <strong>ĐANG TRÊN HÀNH TRÌNH</strong>
                                            <small>Đã rời bến an toàn</small>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="badge-completed-dispatch">
                                        <span class="done-icon">🏁</span>
                                        <div>
                                            <strong>HOÀN TẤT CHUYẾN</strong>
                                            <small>Lộ trình kết thúc</small>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="action-buttons-row">
                                <button type="button" 
                                        class="btn-view-manifest" 
                                        onclick="openManifestModal('@trip.Id', '@trip.DepartureStation', '@trip.ArrivalStation', '@departLocal.ToString("HH:mm dd/MM/yyyy")', '@trip.VehiclePlate', '@trip.Driver')">
                                    📋 Danh sách hành khách
                                </button>

                                @if (ViewBag.IsStationAgent == true && trip.Status == "Scheduled" && !trip.HasApprovedDispatch)
                                {
                                    <button type="button" 
                                            class="btn-sign-dispatch" 
                                            onclick="openDispatchModal('@trip.Id', '@trip.DepartureStation → @trip.ArrivalStation', '@trip.VehiclePlate', '@trip.Driver', '@departLocal.ToString("HH:mm dd/MM/yyyy")', @trip.TicketCount, @trip.TotalCapacity)">
                                        ✍️ Kiểm định & Ký lệnh
                                    </button>
                                }

                                @if (trip.HasApprovedDispatch)
                                {
                                    <button type="button" 
                                            class="btn-print-dispatch" 
                                            onclick="printDispatchOrder('@trip.Id', '@trip.DepartureStation', '@trip.ArrivalStation', '@trip.Operator', '@trip.VehiclePlate', '@trip.Driver', '@departLocal.ToString("HH:mm dd/MM/yyyy")', @trip.TicketCount, '@trip.DispatchSignature', '@trip.DispatchedAtUtc?.AddHours(7).ToString("dd/MM/yyyy HH:mm")')">
                                        🖨️ In Lệnh Xuất Bến
                                    </button>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>
    </div>
</div>

<!-- MODAL 1: PASSENGER MANIFEST & MANUAL CHECK-IN -->
<div class="smt-modal-overlay" id="manifest-modal" style="display: none;">
    <div class="smt-modal-container manifest-modal-box">
        <header class="smt-modal-head">
            <div>
                <span class="eyebrow-smt">DANH SÁCH HÀNH KHÁCH & VÉ CHUYẾN XE</span>
                <h3 id="mf-trip-title">-- → --</h3>
                <p id="mf-trip-sub">Biển số: -- · Khởi hành: --</p>
            </div>
            <button type="button" class="btn-close-modal" onclick="closeManifestModal()">&times;</button>
        </header>

        <div class="manifest-toolbar">
            <div class="search-box">
                <input type="text" id="manifest-search" placeholder="Tìm theo số ghế hoặc tên khách..." oninput="filterManifestList()" />
            </div>
            <div class="manifest-counts">
                <span class="chip-count">Đã bán: <strong id="mf-sold-count">0</strong></span>
                <span class="chip-count text-green">Đã soát vé: <strong id="mf-checked-count">0</strong></span>
                <span class="chip-count text-amber">Chưa lên xe: <strong id="mf-pending-count">0</strong></span>
            </div>
        </div>

        <div class="manifest-table-wrapper">
            <table class="manifest-table">
                <thead>
                    <tr>
                        <th>Ghế</th>
                        <th>Hành khách</th>
                        <th>Số điện thoại</th>
                        <th>Giá vé</th>
                        <th>Trạng thái soát vé</th>
                        <th class="text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="manifest-tbody">
                    <tr><td colspan="6" class="loading-cell">Đang tải dữ liệu danh sách vé...</td></tr>
                </tbody>
            </table>
        </div>

        <footer class="smt-modal-footer">
            <button type="button" class="button button-outline" onclick="closeManifestModal()">Đóng</button>
            <button type="button" class="button button-primary" onclick="window.print()">🖨️ In Danh Sách Lên Xe</button>
        </footer>
    </div>
</div>

<!-- MODAL 2: 4-POINT SAFETY CHECKLIST & DISPATCH CLEARANCE -->
<div class="smt-modal-overlay" id="dispatch-modal" style="display: none;">
    <div class="smt-modal-container dispatch-modal-box">
        <header class="smt-modal-head">
            <div>
                <span class="eyebrow-smt">QUY CHUẨN BỘ GIAO THÔNG VẬN TẢI & BẾN XE</span>
                <h3>Kiểm Định An Toàn & Ký Lệnh Xuất Bến Điện Tử</h3>
                <p id="dp-trip-info">Chuyến: -- · Xe: -- · Tài xế: --</p>
            </div>
            <button type="button" class="btn-close-modal" onclick="closeDispatchModal()">&times;</button>
        </header>

        <form id="dispatch-form" class="dispatch-checklist-body">
            <input type="hidden" id="dp-trip-id" />
            <div class="notice-checklist-info">
                <strong>QUY ĐỊNH BẮT BUỘC:</strong> Kiểm soát viên bến xe phải kiểm tra trực tiếp phương tiện và tài xế. Cần đạt cả 4 tiêu chuẩn an toàn bên dưới trước khi ký duyệt lệnh xuất bến.
            </div>

            <div class="checklist-items">
                <label class="check-item-card">
                    <input type="checkbox" id="chk-vehicle" name="vehicleDocumentsValid" onchange="validateDispatchForm()" />
                    <div class="check-item-content">
                        <strong>1. Hồ sơ kỹ thuật phương tiện & Thiết bị giám sát</strong>
                        <p>Giấy đăng kiểm còn hạn; Tem kiểm định an toàn kỹ thuật; Bảo hiểm TNDS bắt buộc; Thiết bị giám sát hành trình (GPS) và camera trong xe đang truyền dữ liệu về Cục Đường bộ.</p>
                    </div>
                </label>

                <label class="check-item-card">
                    <input type="checkbox" id="chk-license" name="driverLicenseValid" onchange="validateDispatchForm()" />
                    <div class="check-item-content">
                        <strong>2. Giấy phép lái xe tài xế</strong>
                        <p>Tài xế xuất trình bằng lái xe còn hiệu lực, đúng hạng theo quy định (Hạng E đối với xe khách trên 30 chỗ / giường nằm).</p>
                    </div>
                </label>

                <label class="check-item-card">
                    <input type="checkbox" id="chk-health" name="driverFitForDuty" onchange="validateDispatchForm()" />
                    <div class="check-item-content">
                        <strong>3. Sức khỏe & Nồng độ cồn tài xế</strong>
                        <p>Đã kiểm tra qua máy đo nồng độ cồn = 0.00 mg/L khí thở (Nghị định 100/123); Âm tính với chất kích thích/ma túy; Thần kinh tỉnh táo, đủ điều kiện lái xe an toàn.</p>
                    </div>
                </label>

                <label class="check-item-card">
                    <input type="checkbox" id="chk-capacity" name="passengerCapacityValid" onchange="validateDispatchForm()" />
                    <div class="check-item-content">
                        <strong>4. Tải khách & Trật tự an toàn trong khoang</strong>
                        <p>Hành khách ngồi đúng ghế vé; Tuyệt đối không chở quá số ghế quy định (<span id="dp-capacity-note">--</span>); Hành lý và hàng hóa xếp gọn trong khoang hành lý, không chở hàng nguy hiểm/cháy nổ.</p>
                    </div>
                </label>
            </div>

            <div class="notes-field-wrap">
                <label for="dp-notes">Ghi chú kiểm soát viên bến xe (Tùy chọn):</label>
                <input type="text" id="dp-notes" maxlength="500" placeholder="VD: Kiểm tra xe đạt tiêu chuẩn, xuất bến đúng giờ..." />
            </div>

            <footer class="smt-modal-footer">
                <button type="button" class="button button-outline" onclick="closeDispatchModal()">Hủy bỏ</button>
                <button type="submit" class="button button-primary" id="btn-submit-dispatch" disabled>
                    ✍️ Ký số & Cấp Lệnh Xuất Bến
                </button>
            </footer>
        </form>
    </div>
</div>

<!-- PRINTABLE DISPATCH ORDER SHEET (HIDDEN UNTIL PRINT) -->
<div id="print-dispatch-sheet" class="print-dispatch-sheet" style="display: none;">
    <div class="print-header">
        <div class="gov-title">
            <strong>CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</strong>
            <small>Độc lập - Tự do - Hạnh phúc</small>
            <div class="underline-gov"></div>
        </div>
        <div class="smt-brand-print">
            <strong>SMART TICKET - SMT</strong>
            <small>HỆ THỐNG QUẢN LÝ BẾN XE VÀ ĐIỀU HÀNH VẬN TẢI</small>
        </div>
    </div>

    <div class="print-sheet-title">
        <h2>LỆNH VẬN CHUYỂN & BIÊN BẢN XUẤT BẾN ĐIỆN TỬ</h2>
        <span id="p-sign-date">Ngày cấp lệnh: --</span>
    </div>

    <table class="print-info-table">
        <tr>
            <td style="width: 20%;"><strong>Đơn vị vận tải:</strong></td>
            <td id="p-operator" style="width: 30%;">--</td>
            <td style="width: 20%;"><strong>Biển số xe:</strong></td>
            <td id="p-plate" style="width: 30%;">--</td>
        </tr>
        <tr>
            <td><strong>Tuyến hoạt động:</strong></td>
            <td id="p-route">--</td>
            <td><strong>Tài xế điều khiển:</strong></td>
            <td id="p-driver">--</td>
        </tr>
        <tr>
            <td><strong>Giờ xuất bến:</strong></td>
            <td id="p-depart">--</td>
            <td><strong>Số lượng khách:</strong></td>
            <td id="p-passengers">--</td>
        </tr>
    </table>

    <div class="print-checklist-box">
        <strong>KẾT QUẢ KIỂM TRA ĐIỀU KIỆN AN TOÀN TRƯỚC KHI XUẤT BẾN:</strong>
        <ol>
            <li>[X] Phương tiện đảm bảo an toàn kỹ thuật, bảo vệ môi trường, có GPS và camera giám sát hoạt động.</li>
            <li>[X] Người lái xe có giấy phép lái xe phù hợp, còn giá trị sử dụng.</li>
            <li>[X] Người lái xe đã được kiểm tra nồng độ cồn = 0.00 mg/L và âm tính với chất kích thích.</li>
            <li>[X] Số lượng hành khách trên xe không vượt quá tải trọng và số ghế thiết kế.</li>
        </ol>
    </div>

    <div class="print-signature-section">
        <div class="sig-box">
            <span>ĐẠI DIỆN ĐƠN VỊ VẬN TẢI</span>
            <small>(Ký, ghi rõ họ tên)</small>
            <div class="sig-space"></div>
        </div>
        <div class="sig-box">
            <span>KIỂM SOÁT VIÊN BẾN XE</span>
            <small>(Ký số điện tử bảo mật)</small>
            <div class="sig-space">
                <div class="digital-seal-stamp">
                    <strong>ĐÃ PHÊ DUYỆT XUẤT BẾN</strong>
                    <small id="p-sig-hash">HMAC-SHA256 SIGNED</small>
                    <span id="p-sig-time">SMT SECURE GATEWAY</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* SMT GATE CONTROL SYSTEM STYLES */
:root {
    --smt-crimson: #c81d4a;
    --smt-purple: #5e17eb;
    --smt-rose: #f72585;
    --smt-bronze: #8c5a36;
    --smt-gold: #d4af37;
    --smt-dark: #141124;
    --smt-dark-surface: #1d1833;
    --smt-dark-border: #332b56;
    --smt-text-muted: #8e87a2;
}

.station-cockpit-shell {
    max-width: 1480px;
    margin: 12px auto 40px;
    padding: 0 16px;
    color: #1a162b;
}

/* TOPBAR */
.cockpit-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    padding: 24px 28px;
    background: radial-gradient(circle at 90% 10%, rgba(200, 29, 74, 0.18), transparent 40%), linear-gradient(135deg, #181429 0%, #25183d 60%, #36174d 100%);
    border: 1px solid #3c2a5e;
    border-radius: 20px;
    color: #fff;
    box-shadow: 0 14px 40px rgba(24, 20, 41, 0.25);
}

.eyebrow-smt {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--smt-gold);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-transform: uppercase;
}

.pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.3);
    animation: pulseDot 2s infinite;
}

@@keyframes pulseDot {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.6; }
}

.cockpit-title {
    margin: 6px 0 8px;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.8px;
    color: #fff;
}

.cockpit-subtitle {
    margin: 0;
    color: #d1c9dc;
    font-size: 13px;
    max-width: 650px;
    line-height: 1.5;
}

.header-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
}

.clock-badge {
    padding: 6px 14px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 30px;
    font-family: monospace;
    font-size: 13px;
    font-weight: 700;
    color: #f1ecf9;
}

.cockpit-pill-group {
    display: flex;
    align-items: center;
    gap: 8px;
}

.net-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
}

.net-pill.online {
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
}

.net-pill.offline {
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.3);
}

.net-pill .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
}

.queue-pill {
    padding: 5px 12px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    font-size: 11px;
    color: #cbd5e1;
}

.btn-sync-action {
    padding: 4px 12px;
    background: var(--smt-purple);
    border: 0;
    border-radius: 20px;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s;
}

.btn-sync-action:hover {
    background: #4a0ebf;
}

.user-role-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background: rgba(212, 175, 55, 0.15);
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 8px;
    font-size: 11px;
    font-weight: 700;
    color: var(--smt-gold);
}

/* KPI STRIP */
.kpi-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin: 18px 0;
}

.kpi-card {
    padding: 16px 20px;
    background: #fff;
    border: 1px solid #e7e2ea;
    border-radius: 14px;
    box-shadow: 0 4px 16px rgba(26, 22, 43, 0.04);
}

.kpi-label {
    display: block;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.8px;
    color: #8c8699;
}

.kpi-value {
    display: block;
    margin: 4px 0 2px;
    font-size: 26px;
    font-weight: 800;
    color: #1a162b;
    letter-spacing: -0.6px;
}

.kpi-sub {
    font-size: 11px;
    color: #71697f;
}

.kpi-card.highlight-dod {
    background: linear-gradient(135deg, #181429 0%, #2b173e 100%);
    border-color: #492a70;
    color: #fff;
}

.kpi-card.highlight-dod .kpi-label {
    color: var(--smt-gold);
}

.kpi-card.highlight-dod .kpi-sub {
    color: #d1c9dc;
}

.text-green { color: #10b981 !important; }
.text-amber { color: #f59e0b !important; }
.text-accent { color: #38bdf8 !important; }

/* MAIN GRID */
.cockpit-grid {
    display: grid;
    grid-template-columns: minmax(460px, 1.15fr) minmax(540px, 1.35fr);
    gap: 20px;
    align-items: start;
}

.scanner-cockpit-panel, .trips-manifest-panel {
    background: #fff;
    border: 1px solid #e7e2ea;
    border-radius: 18px;
    padding: 24px;
    box-shadow: 0 6px 24px rgba(26, 22, 43, 0.05);
}

.panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    padding-bottom: 18px;
    border-bottom: 1px solid #f0ecf3;
    margin-bottom: 20px;
}

.panel-title-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
}

.panel-icon {
    font-size: 26px;
}

.panel-title-wrap h2 {
    margin: 0;
    font-size: 18px;
    font-weight: 800;
    color: #1a162b;
}

.panel-desc {
    font-size: 12px;
    color: #8c8699;
}

.btn-sound-toggle {
    padding: 6px 12px;
    background: #f4f0f8;
    border: 1px solid #ded6e7;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 700;
    color: #5e17eb;
    cursor: pointer;
    transition: all 0.15s;
}

.btn-sound-toggle:hover {
    background: #ede4f8;
}

/* DEV / DEMO TESTING BAR */
.dev-quick-test-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    padding: 8px 12px;
    background: #fdf2f6;
    border: 1px dashed #f58abb;
    border-radius: 10px;
    flex-wrap: wrap;
}

.dev-tag {
    font-size: 10px;
    font-weight: 800;
    color: #c81d4a;
    letter-spacing: 0.5px;
}

.btn-dev-action {
    padding: 5px 11px;
    background: #fff;
    border: 1px solid #d9d2e3;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    color: #4b149b;
    cursor: pointer;
    transition: all 0.15s;
}

.btn-dev-action:hover {
    background: #5e17eb;
    color: #fff;
    border-color: #5e17eb;
}

.btn-dev-action.alarm-btn {
    color: #c81d4a;
    border-color: #f7aabf;
}

.btn-dev-action.alarm-btn:hover {
    background: #c81d4a;
    color: #fff;
    border-color: #c81d4a;
}

/* SCANNER INPUT SECTION */
.scanner-input-container {
    display: grid;
    gap: 12px;
    margin-bottom: 20px;
}

.scanner-input-box {
    position: relative;
    display: flex;
    align-items: center;
}

.input-prefix-icon {
    position: absolute;
    left: 14px;
    font-size: 18px;
    color: #8c8699;
    pointer-events: none;
}

.scanner-input-box input {
    width: 100%;
    height: 52px;
    padding: 0 42px 0 44px;
    background: #faf8fc;
    border: 2px solid #d9d2e3;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    color: #1a162b;
    outline: none;
    transition: all 0.2s ease;
}

.scanner-input-box input:focus {
    border-color: var(--smt-purple);
    background: #fff;
    box-shadow: 0 0 0 4px rgba(94, 23, 235, 0.12);
}

.btn-clear-input {
    position: absolute;
    right: 12px;
    width: 26px;
    height: 26px;
    background: #eae4f0;
    border: 0;
    border-radius: 50%;
    color: #635c70;
    font-size: 16px;
    cursor: pointer;
    display: grid;
    place-items: center;
}

.scanner-btn-group {
    display: flex;
    gap: 10px;
}

.btn-smt-primary {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 46px;
    background: linear-gradient(135deg, var(--smt-crimson) 0%, #ad163e 100%);
    border: 0;
    border-radius: 10px;
    color: #fff;
    font-size: 13px;
    font-weight: 750;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(200, 29, 74, 0.28);
    transition: transform 0.15s, box-shadow 0.15s;
}

.btn-smt-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 22px rgba(200, 29, 74, 0.35);
}

.btn-smt-primary kbd {
    background: rgba(0, 0, 0, 0.25);
    padding: 3px 7px;
    border-radius: 6px;
    font-size: 10px;
    font-family: inherit;
}

.btn-smt-outline {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 46px;
    padding: 0 18px;
    background: #fff;
    border: 1.5px solid #d9d2e3;
    border-radius: 10px;
    color: #4b149b;
    font-size: 13px;
    font-weight: 750;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
}

.btn-smt-outline:hover {
    background: #f6f2fb;
    border-color: #5e17eb;
}

/* CAMERA VIEWFINDER */
.camera-viewfinder-wrapper {
    margin-bottom: 20px;
    border: 2px solid #5e17eb;
    border-radius: 16px;
    overflow: hidden;
    background: #000;
}

.camera-frame {
    position: relative;
    width: 100%;
    height: 280px;
    overflow: hidden;
    background: #0b0914;
}

.camera-frame video {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.reticle-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
}

.laser-scanner-line {
    position: absolute;
    left: 15%;
    right: 15%;
    height: 3px;
    background: linear-gradient(90deg, transparent, #10b981, #34d399, transparent);
    box-shadow: 0 0 12px #10b981;
    animation: laserSweep 2s ease-in-out infinite alternate;
}

@@keyframes laserSweep {
    0% { top: 20%; }
    100% { top: 80%; }
}

.reticle-corner {
    position: absolute;
    width: 28px;
    height: 28px;
    border-color: #10b981;
    border-style: solid;
}

.top-left { top: 25%; left: 20%; border-width: 4px 0 0 4px; }
.top-right { top: 25%; right: 20%; border-width: 4px 4px 0 0; }
.bottom-left { bottom: 25%; left: 20%; border-width: 0 0 4px 4px; }
.bottom-right { bottom: 25%; right: 20%; border-width: 0 4px 4px 0; }

.reticle-hint {
    position: absolute;
    bottom: 12px;
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
}

.camera-controls-bar {
    display: flex;
    justify-content: space-between;
    padding: 10px 14px;
    background: #181429;
}

.btn-cam-switch, .btn-cam-close {
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    border: 0;
}

.btn-cam-switch { background: #332b56; color: #fff; }
.btn-cam-close { background: #c81d4a; color: #fff; }

/* RESULT CARD */
.scan-result-card {
    display: flex;
    gap: 18px;
    padding: 22px;
    border-radius: 16px;
    margin-bottom: 22px;
    transition: all 0.25s ease;
}

.scan-result-card.idle {
    background: #f8f6fb;
    border: 1.5px dashed #d5cde0;
    color: #635c70;
}

.scan-result-card.success {
    background: #ecfdf5;
    border: 2px solid #10b981;
    color: #064e3b;
    box-shadow: 0 8px 24px rgba(16, 185, 129, 0.2);
}

.scan-result-card.alarm {
    background: #fef2f2;
    border: 3px solid var(--smt-crimson);
    color: #7f1d1d;
    box-shadow: 0 8px 30px rgba(200, 29, 74, 0.35);
    animation: alarmStrobe 1s ease-in-out infinite;
}

@@keyframes alarmStrobe {
    0%, 100% { background: #fef2f2; border-color: var(--smt-crimson); }
    50% { background: #fee2e2; border-color: #ff0044; }
}

.scan-result-card.rejected {
    background: #fffbeb;
    border: 2px solid #f59e0b;
    color: #78350f;
}

.scan-result-card.pending {
    background: #f5f3ff;
    border: 2px solid var(--smt-purple);
    color: #3b0764;
}

.result-status-icon {
    font-size: 40px;
    line-height: 1;
}

.result-body {
    flex: 1;
}

.result-headline {
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.4px;
    margin-bottom: 4px;
}

.result-main-text {
    font-size: 13px;
    line-height: 1.5;
}

.result-meta-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
}

.meta-item {
    display: flex;
    flex-direction: column;
}

.meta-label {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.6px;
    opacity: 0.75;
}

.meta-val {
    font-size: 13px;
    font-weight: 750;
}

.meta-item.seat-highlight .meta-val {
    font-size: 20px;
    font-weight: 900;
    color: var(--smt-crimson);
}

/* RECENT SCANS LOG */
.recent-scans-block {
    margin-top: 10px;
}

.recent-scans-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.recent-scans-head h3 {
    margin: 0;
    font-size: 13px;
    font-weight: 800;
    color: #4b4556;
}

.btn-clear-log {
    background: none;
    border: 0;
    color: #8c8699;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
}

.btn-clear-log:hover {
    color: var(--smt-crimson);
}

.table-scroll-mini {
    max-height: 220px;
    overflow-y: auto;
    border: 1px solid #eee9f2;
    border-radius: 10px;
}

.recent-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 11px;
}

.recent-table th {
    position: sticky;
    top: 0;
    padding: 9px 12px;
    text-align: left;
    font-size: 10px;
    font-weight: 850;
    font-family: 'Plus Jakarta Sans', sans-serif !important;
}

[data-theme="dark"] .recent-table th, :root:not([data-theme="light"]) .recent-table th {
    background: rgba(22, 14, 8, 0.98) !important;
    color: #fbe0a6 !important;
    border-bottom: 2px solid rgba(229, 169, 80, 0.45) !important;
}

[data-theme="light"] .recent-table th {
    background: rgba(245, 237, 225, 0.98) !important;
    color: #4a2d10 !important;
    border-bottom: 2px solid rgba(184, 123, 51, 0.4) !important;
}

.recent-table td {
    padding: 8px 12px;
    font-family: 'Plus Jakarta Sans', sans-serif !important;
}

[data-theme="dark"] .recent-table td, :root:not([data-theme="light"]) .recent-table td {
    border-bottom: 1px solid rgba(229, 169, 80, 0.15) !important;
    color: var(--ink) !important;
}

[data-theme="light"] .recent-table td {
    border-bottom: 1px solid rgba(184, 123, 51, 0.12) !important;
    color: var(--ink) !important;
}

.status-badge-mini {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 12px;
    font-weight: 750;
    font-size: 10px;
}

.status-badge-mini.success { background: #d1fae5; color: #065f46; }
.status-badge-mini.alarm { background: #fee2e2; color: #991b1b; }
.status-badge-mini.rejected { background: #fef3c7; color: #92400e; }
.status-badge-mini.pending { background: #ede9fe; color: #5b21b6; }

/* TRIPS & MANIFEST PANEL */
.filter-chip-group {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
}

.filter-chip {
    padding: 5px 12px;
    background: #f4f0f8;
    border: 1px solid #e2d9eb;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    color: #635c70;
    cursor: pointer;
    transition: all 0.15s;
}

.filter-chip.active {
    background: #5e17eb;
    border-color: #5e17eb;
    color: #fff;
}

.trips-list-container {
    display: grid;
    gap: 16px;
    max-height: 820px;
    overflow-y: auto;
    padding-right: 4px;
}

.trip-manifest-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 18px 20px;
    background: #fff;
    border: 1px solid #e7e2ea;
    border-radius: 14px;
    transition: border-color 0.2s, box-shadow 0.2s;
}

.trip-manifest-card:hover {
    border-color: #baa7d6;
    box-shadow: 0 6px 20px rgba(26, 22, 43, 0.06);
}

.route-line-badge {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
}

.route-name {
    font-size: 16px;
    font-weight: 800;
    color: #1a162b;
}

.depart-clock {
    font-size: 12px;
    color: #71697f;
}

.vehicle-driver-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 8px 0;
    flex-wrap: wrap;
    font-size: 12px;
}

.op-badge {
    padding: 3px 8px;
    background: #f2edf8;
    border-radius: 6px;
    font-weight: 750;
    color: #5e17eb;
}

.plate-badge-smt {
