@@media (max-width: 900px) {
    .trust-grid { grid-template-columns: 1fr; }
    .compact-assurance-strip { flex-direction: column; align-items: flex-start; }
}

@@media (max-width: 950px) {
    .modern-trip-card {
        grid-template-columns: 1fr 1fr; gap: 14px; padding: 18px;
    }
    .trip-operator { grid-column: 1 / -1; }
    .trip-route-line-box { grid-column: 1 / -1; order: 3; }
    .trip-price-actions {
        grid-column: 1 / -1; order: 4; flex-direction: row; justify-content: space-between; align-items: center;
        border-top: 1px solid var(--line); padding-top: 12px;
    }
}
@@media (max-width: 600px) {
    .quick-routes-bar { display: none; }
    .search-swap-btn { display: none; }
}
</style>

@section Scripts {
<script>
    function swapStations() {
        const dep = document.getElementById('depStationSelect');
        const arr = document.getElementById('arrStationSelect');
        if (dep && arr) {
            const temp = dep.value;
            dep.value = arr.value;
            arr.value = temp;
            onStationChanged();
        }
    }

    function onStationChanged() {
        const dep = document.getElementById('depStationSelect');
        const arr = document.getElementById('arrStationSelect');
        const warn = document.getElementById('searchValidationWarning');
        if (dep && arr && warn) {
            if (dep.value && arr.value && dep.value === arr.value) {
                warn.textContent = '⚠️ Điểm khởi hành và điểm đến không được trùng nhau. Vui lòng chọn hai bến xe khác nhau.';
                warn.style.display = 'block';
            } else {
                warn.style.display = 'none';
            }
        }
    }

    function validateSearchForm() {
        const dep = document.getElementById('depStationSelect')?.value;
        const arr = document.getElementById('arrStationSelect')?.value;
        const warn = document.getElementById('searchValidationWarning');
        if (dep && arr && dep === arr) {
            if (warn) {
                warn.textContent = '⚠️ Điểm khởi hành và điểm đến không được trùng nhau. Vui lòng chọn hai bến xe khác nhau.';
                warn.style.display = 'block';
            }
            return false;
        }
        return true;
    }

    function quickSelectRoute(depKeyword, arrKeyword) {
        const depSelect = document.getElementById('depStationSelect');
        const arrSelect = document.getElementById('arrStationSelect');
        if (!depSelect || !arrSelect) return;

        let depFound = false;
        for (const opt of depSelect.options) {
            if (opt.text.toLowerCase().includes(depKeyword.toLowerCase())) {
                depSelect.value = opt.value;
                depFound = true;
                break;
            }
        }

        let arrFound = false;
        for (const opt of arrSelect.options) {
            if (opt.text.toLowerCase().includes(arrKeyword.toLowerCase())) {
                arrSelect.value = opt.value;
                arrFound = true;
                break;
            }
        }

        onStationChanged();
        if (depFound && arrFound) {
            document.getElementById('searchTripForm')?.submit();
        }
    }

    function filterByVehicleType(cat) {
        document.querySelectorAll('.pill-btn').forEach(btn => {
            btn.classList.toggle('active', btn.getAttribute('onclick').includes(cat));
        });

        const cards = document.querySelectorAll('.modern-trip-card');
        cards.forEach(card => {
            const cardCat = card.getAttribute('data-category') || '';
            if (cat === 'all' || cardCat.includes(cat)) {
                card.style.display = '';
            } else {
                card.style.display = 'none';
            }
        });
    }

    function sortTripCards(sortKey) {
        const container = document.getElementById('tripResultsContainer');
        if (!container) return;

        const cards = Array.from(container.querySelectorAll('.modern-trip-card'));
        cards.sort((a, b) => {
            if (sortKey === 'price-asc') {
                return (parseInt(a.getAttribute('data-price')) || 0) - (parseInt(b.getAttribute('data-price')) || 0);
            }
            if (sortKey === 'price-desc') {
                return (parseInt(b.getAttribute('data-price')) || 0) - (parseInt(a.getAttribute('data-price')) || 0);
            }
            if (sortKey === 'time-asc') {
                return (parseInt(a.getAttribute('data-time')) || 0) - (parseInt(b.getAttribute('data-time')) || 0);
            }
            if (sortKey === 'time-desc') {
                return (parseInt(b.getAttribute('data-time')) || 0) - (parseInt(a.getAttribute('data-time')) || 0);
            }
            if (sortKey === 'seats-desc') {
                return (parseInt(b.getAttribute('data-seats')) || 0) - (parseInt(a.getAttribute('data-seats')) || 0);
            }
            return 0;
        });

        cards.forEach(card => container.appendChild(card));
    }
</script>
}
