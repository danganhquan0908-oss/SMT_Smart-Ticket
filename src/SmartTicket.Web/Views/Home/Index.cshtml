@model SmartTicket.Web.Models.TripSearchViewModel
@{
    ViewData["Title"] = "Tìm & Đặt Vé Xe Khách Trực Tuyến - Smart Ticket";
    var selectedDep = Model.Stations.FirstOrDefault(x => x.Id == Model.DepartureStationId);
    var selectedArr = Model.Stations.FirstOrDefault(x => x.Id == Model.ArrivalStationId);
}

<!-- HERO BANNER -->
<section class="landing-hero">
    <div class="landing-copy">
        <p class="eyebrow"><span class="eyebrow-mark"></span> <span data-i18n="hero_eyebrow">VẠN DẶM BÌNH AN · CHỌN CHỖ DỄ DÀNG</span></p>
        <h1 data-i18n="hero_title" data-i18n-html>Một chuyến xe tốt<br />bắt đầu từ <em>một lựa chọn dễ.</em></h1>
        <p class="landing-description" data-i18n="hero_desc">
            Nền tảng đặt vé xe khách số hóa thông minh: So sánh giá vé minh bạch của hàng chục nhà xe, chọn vị trí giường nằm 2 tầng trực quan và thanh toán VietQR Pro chuẩn xác.
        </p>
        <div class="landing-points">
            <span data-i18n="hero_point_1" data-i18n-html><b>01</b> So sánh đa nhà xe</span>
            <span data-i18n="hero_point_2" data-i18n-html><b>02</b> Khóa ghế 7 phút Realtime</span>
            <span data-i18n="hero_point_3" data-i18n-html><b>03</b> Vé điện tử chuẩn xuất bến</span>
        </div>
    </div>
    <div class="journey-art" aria-hidden="true">
        <div class="journey-sun"></div>
        <div class="journey-orbit orbit-a"></div>
        <div class="journey-orbit orbit-b"></div>
        <div class="journey-route"><span class="route-dot start-dot"></span><span class="route-dot end-dot"></span></div>
        <div class="journey-ticket">
            <span class="ticket-kicker" data-i18n="ticket_kicker">SMT XÁC THỰC</span>
            <strong data-i18n="ticket_ready">Đi thôi.</strong>
            <span class="ticket-line"></span>
            <span class="ticket-meta"><i></i> <span data-i18n="ticket_meta">100% Chuyến chính hãng</span></span>
        </div>
        <span class="journey-label label-start" data-i18n="label_start">BẾN ĐI</span>
        <span class="journey-label label-end" data-i18n="label_end">BẾN ĐẾN</span>
    </div>
</section>

<!-- SEARCH SECTION -->
<section class="booking-search" aria-label="Tìm chuyến xe">
    <div class="booking-heading">
        <div>
            <span class="booking-icon" aria-hidden="true">🚌</span>
            <div>
                <p class="eyebrow" data-i18n="search_eyebrow">TÌM KIẾM HÀNH TRÌNH</p>
                <h2 data-i18n="search_heading">Bạn muốn xuất phát từ đâu?</h2>
            </div>
        </div>
        <span class="booking-step" data-i18n="search_step" data-i18n-html>Lựa chọn chuyến xe <b>01 / 03</b></span>
    </div>

    <!-- QUICK POPULAR ROUTE CHIPS -->
    <div class="quick-routes-bar">
        <span class="quick-routes-label" data-i18n="popular_routes">Tuyến phổ biến:</span>
        <div class="quick-chips-scroll">
            <button type="button" class="quick-chip" onclick="quickSelectRoute('Miền Đông', 'Đà Lạt')">Sài Gòn → Đà Lạt</button>
            <button type="button" class="quick-chip" onclick="quickSelectRoute('Miền Đông', 'Nha Trang')">Sài Gòn → Nha Trang</button>
            <button type="button" class="quick-chip" onclick="quickSelectRoute('Miền Đông', 'Cần Thơ')">Sài Gòn → Cần Thơ</button>
            <button type="button" class="quick-chip" onclick="quickSelectRoute('Mỹ Đình', 'Huế')">Hà Nội → Huế</button>
            <button type="button" class="quick-chip" onclick="quickSelectRoute('Đà Lạt', 'Miền Đông')">Đà Lạt → Sài Gòn</button>
        </div>
    </div>

    <form method="get" class="trip-search-form" id="searchTripForm" onsubmit="return validateSearchForm()">
        <!-- BẾN ĐI -->
        <label>
            <span data-i18n="dep_station_label">ĐIỂM KHỞI HÀNH (BẾN ĐI)</span>
            <select name="departureStationId" id="depStationSelect" required onchange="onStationChanged()">
                <option value="" data-i18n="dep_station_placeholder">-- Chọn bến đi --</option>
                @foreach (var station in Model.Stations)
                {
                    <option value="@station.Id" data-name="@station.Name" data-province="@station.Province" selected="@(Model.DepartureStationId == station.Id)">
                        @station.Name · @station.Province
                    </option>
                }
            </select>
        </label>

        <!-- SWAP BUTTON -->
        <button type="button" class="search-swap-btn" onclick="swapStations()" title="Hoán đổi bến đi và bến đến" data-i18n-title="swap_tooltip" aria-label="Hoán đổi chiều đi">
            <span class="swap-icon">⇄</span>
        </button>

        <!-- BẾN ĐẾN -->
        <label>
            <span data-i18n="arr_station_label">ĐIỂM ĐẾN (BẾN ĐẾN)</span>
            <select name="arrivalStationId" id="arrStationSelect" required onchange="onStationChanged()">
                <option value="" data-i18n="arr_station_placeholder">-- Chọn bến đến --</option>
                @foreach (var station in Model.Stations)
                {
                    <option value="@station.Id" data-name="@station.Name" data-province="@station.Province" selected="@(Model.ArrivalStationId == station.Id)">
                        @station.Name · @station.Province
                    </option>
                }
            </select>
        </label>

        <!-- NGÀY KHỞI HÀNH -->
        <label class="date-field">
            <span data-i18n="travel_date_label">NGÀY KHỞI HÀNH</span>
            <input type="date" name="travelDate" id="travelDateInput" value="@Model.TravelDate.ToString("yyyy-MM-dd")" min="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" required />
        </label>

        <!-- SUBMIT -->
        <button class="button button-primary search-submit" type="submit">
            <span data-i18n="search_btn">Tìm chuyến</span>
            <b aria-hidden="true">↗</b>
        </button>
    </form>

    <div id="searchValidationWarning" class="alert-box-warning" style="display:none; margin-top: 14px;"></div>

    @if (Model.Error is not null)
    {
        <div class="alert-box-warning" style="margin-top: 14px;">
            ⚠️ @Model.Error
        </div>
    }
</section>

<!-- RESULTS OR DISCOVERY SECTION -->
<section class="results-section">
    @if (Model.DepartureStationId.HasValue && Model.ArrivalStationId.HasValue)
    {
        var depName = selectedDep != null ? $"{selectedDep.Name} ({selectedDep.Province})" : "Bến đi";
        var arrName = selectedArr != null ? $"{selectedArr.Name} ({selectedArr.Province})" : "Bến đến";

        <div class="section-heading results-header-bar">
            <div>
                <p class="eyebrow" data-i18n="results_eyebrow">KẾT QUẢ TÌM CHUYẾN XE</p>
                <h2>@depName → @arrName</h2>
                <p class="results-date-sub">Ngày khởi hành: <strong>@Model.TravelDate.ToString("dd/MM/yyyy")</strong> · Tìm thấy <strong>@Model.Results.Count</strong> chuyến đang mở bán</p>
            </div>

            @if (Model.Results.Count > 0)
            {
                <!-- FILTER & SORT CONTROLS -->
                <div class="results-controls">
                    <div class="filter-pills" id="vehicleTypeFilterPills">
                        <button type="button" class="pill-btn active" onclick="filterByVehicleType('all')" data-i18n="filter_all_vehicles">Tất cả xe</button>
                        <button type="button" class="pill-btn" onclick="filterByVehicleType('limousine')" data-i18n="filter_limousine">Limousine</button>
                        <button type="button" class="pill-btn" onclick="filterByVehicleType('giuong')" data-i18n="filter_sleeper">Giường nằm</button>
                        <button type="button" class="pill-btn" onclick="filterByVehicleType('ghe')" data-i18n="filter_seats">Ghế ngồi</button>
                    </div>

                    <div class="sort-dropdown-wrap">
                        <label for="sortTripsSelect" data-i18n="sort_label">Sắp xếp:</label>
                        <select id="sortTripsSelect" onchange="sortTripCards(this.value)">
                            <option value="time-asc" data-i18n="sort_time_asc">Giờ đi sớm nhất</option>
                            <option value="time-desc" data-i18n="sort_time_desc">Giờ đi muộn nhất</option>
                            <option value="price-asc" data-i18n="sort_price_asc">Giá vé thấp nhất</option>
                            <option value="price-desc" data-i18n="sort_price_desc">Giá vé cao nhất</option>
                            <option value="seats-desc" data-i18n="sort_seats_desc">Nhiều chỗ trống nhất</option>
                        </select>
                    </div>
                </div>
            }
        </div>

        @if (Model.Results.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-symbol">🚌</div>
                <strong>Chưa có chuyến xe nào trên tuyến này vào ngày @Model.TravelDate.ToString("dd/MM/yyyy")</strong>
                <p>Các nhà xe có thể chưa mở lịch bán vé hoặc đã hết chuyến trong ngày. Bạn hãy thử chọn ngày khác hoặc các bến xe lân cận.</p>
                <div style="margin-top: 14px;">
                    <a class="button button-outline" href="/?departureStationId=@Model.DepartureStationId&arrivalStationId=@Model.ArrivalStationId&travelDate=@Model.TravelDate.AddDays(1).ToString("yyyy-MM-dd")">
                        Tìm ngày tiếp theo (@Model.TravelDate.AddDays(1).ToString("dd/MM")) →
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="trip-results-container" id="tripResultsContainer">
                @foreach (var trip in Model.Results)
                {
                    var depLocal = trip.DepartureTimeUtc.AddHours(7);
                    var arrLocal = trip.ArrivalTimeUtc.AddHours(7);
                    var duration = arrLocal - depLocal;
                    var durationText = duration.TotalMinutes > 0
                        ? $"{(int)duration.TotalHours}h{duration.Minutes:D2}p"
                        : "Lộ trình nhanh";

                    var vType = trip.VehicleType?.ToLower() ?? "";
                    var category = vType.Contains("limousine") ? "limousine" : (vType.Contains("giường") || vType.Contains("giuong") ? "giuong" : "ghe");

                    <article class="trip-result-card modern-trip-card"
                             data-category="@category"
                             data-price="@((long)trip.Price)"
                             data-time="@depLocal.Ticks"
                             data-seats="@trip.AvailableSeats">

                        <!-- NHÀ XE & LOẠI XE -->
                        <div class="trip-operator">
                            <span class="operator-avatar">@(!string.IsNullOrWhiteSpace(trip.Operator) ? trip.Operator[..1] : "S")</span>
                            <div>
                                <strong class="operator-title">@trip.Operator</strong>
                                <span class="vehicle-subtag">@trip.VehicleType</span>
                            </div>
                        </div>

                        <!-- GIỜ ĐI -->
                        <div class="trip-times">
                            <strong>@depLocal.ToString("HH:mm")</strong>
                            <span title="@trip.DepartureStation (@trip.DepartureProvince)">@trip.DepartureStation</span>
                        </div>

                        <!-- ĐƯỜNG NỐI HÀNH TRÌNH & THỜI LƯỢNG -->
                        <div class="trip-route-line-box">
                            <span class="duration-badge">⏱️ @durationText</span>
                            <div class="route-line-visual">
                                <span class="dot-start"></span>
                                <span class="line-bar"></span>
                                <span class="dot-end"></span>
                            </div>
                            <span class="date-label">@depLocal.ToString("dd/MM") → @arrLocal.ToString("dd/MM")</span>
                        </div>

                        <!-- GIỜ ĐẾN -->
                        <div class="trip-times">
                            <strong>@arrLocal.ToString("HH:mm")</strong>
                            <span title="@trip.ArrivalStation (@trip.ArrivalProvince)">@trip.ArrivalStation</span>
                        </div>

                        <!-- GIÁ VÉ & SỐ CHỖ TRỐNG -->
                        <div class="trip-price-actions">
                            <div class="seats-avail-box">
                                @if (trip.AvailableSeats > 5)
                                {
                                    <span class="avail-badge in-stock">Còn @trip.AvailableSeats chỗ</span>
                                }
                                else if (trip.AvailableSeats > 0)
                                {
                                    <span class="avail-badge urgent">Chỉ còn @trip.AvailableSeats chỗ!</span>
                                }
                                else
                                {
                                    <span class="avail-badge sold-out">Hết chỗ</span>
                                }
                            </div>

                            <div class="price-val-box">
                                <span class="price-prefix" data-i18n="fare_prefix">Giá niêm yết</span>
                                <strong class="fare-bold">@trip.Price.ToString("N0") ₫</strong>
                            </div>

                            @if (trip.AvailableSeats > 0)
                            {
                                <a class="button button-primary choose-seat-btn" href="/trips/@trip.TripId/seats">
                                    <span data-i18n="btn_pick_seats">Chọn ghế</span>
                                    <b aria-hidden="true">↗</b>
                                </a>
                            }
                            else
                            {
                                <button class="button button-outline" disabled style="opacity:0.5; cursor:not-allowed;" data-i18n="sold_out_btn">
                                    Hết vé
                                </button>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    }
    else
    {
        <!-- COMPACT SERVICE STANDARDS & REGULATORY ASSURANCE -->
        <div class="compact-trust-container">
            <div class="trust-grid">
                <div class="trust-card">
                    <span class="trust-icon" aria-hidden="true">⌕</span>
                    <div class="trust-text">
                        <strong data-i18n="trust_item_1_title">Minh bạch giá & Tuyến đường</strong>
                        <p data-i18n="trust_item_1_desc">Công khai giá niêm yết từ nhà xe chính hãng, không phụ phí ẩn.</p>
                    </div>
                </div>

                <div class="trust-card">
                    <span class="trust-icon" aria-hidden="true">▦</span>
                    <div class="trust-text">
                        <strong data-i18n="trust_item_2_title">Sơ đồ 2 tầng & Giữ chỗ 7p</strong>
                        <p data-i18n="trust_item_2_desc">Chủ động chọn giường nằm, khóa chỗ realtime chống trùng lặp.</p>
                    </div>
                </div>

                <div class="trust-card">
                    <span class="trust-icon" aria-hidden="true">✓</span>
                    <div class="trust-text">
                        <strong data-i18n="trust_item_3_title">VietQR Pro & Vé tức thì</strong>
                        <p data-i18n="trust_item_3_desc">Quét mã 1-chạm khóa số tiền, xuất vé điện tử check-in chuẩn sau 3 giây.</p>
                    </div>
                </div>
            </div>

            <div class="compact-assurance-strip">
                <span class="assurance-icon" aria-hidden="true">🛡️</span>
                <div class="assurance-content">
                    <strong data-i18n="trust_assurance_title">Cam kết Vận tải An toàn theo Nghị định 10/2020/NĐ-CP:</strong>
                    <p data-i18n="trust_assurance_desc">100% chuyến xe trên Smart Ticket xuất phát từ các Bến xe khách liên tỉnh hợp pháp, có Lệnh xuất bến điện tử.</p>
                </div>
            </div>
        </div>
    }
</section>

<style>
.quick-routes-bar {
    display: flex; align-items: center; gap: 10px; margin: 16px 0 18px; flex-wrap: wrap;
}
.quick-routes-label { font-size: 11.5px; font-weight: 850; color: var(--ink); letter-spacing: 0.5px; }
.quick-chips-scroll { display: flex; gap: 8px; flex-wrap: wrap; }
.quick-chip {
    padding: 7px 16px; border-radius: 9999px; background: var(--btn-secondary-bg) !important;
    -webkit-backdrop-filter: blur(16px) saturate(180%) !important;
    backdrop-filter: blur(16px) saturate(180%) !important;
    border: var(--btn-secondary-border) !important; box-shadow: var(--btn-secondary-glow) !important;
    font-size: 11.5px; font-weight: 800; color: var(--ink); cursor: pointer;
    transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.18s, background 0.18s !important;
}
.quick-chip:hover {
    background: var(--btn-primary-bg) !important; color: var(--btn-primary-text) !important;
    border-color: var(--btn-primary-border) !important;
    transform: translateY(-1.5px); box-shadow: var(--btn-primary-hover-glow) !important;
}
.quick-chip:active {
    transform: scale(0.95);
}

.search-swap-btn {
    width: 48px; height: 48px; border-radius: 50% !important; border: var(--btn-secondary-border) !important;
    background: var(--btn-secondary-bg) !important;
    -webkit-backdrop-filter: blur(18px) saturate(180%) !important;
    backdrop-filter: blur(18px) saturate(180%) !important;
    box-shadow: var(--btn-secondary-glow) !important;
    color: var(--gold); font-size: 20px; font-weight: 800; cursor: pointer; display: grid; place-items: center;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s, background 0.2s; align-self: flex-end;
}
.search-swap-btn:hover {
    background: var(--btn-primary-bg) !important; color: var(--btn-primary-text) !important;
    border-color: var(--btn-primary-border) !important;
    transform: rotate(180deg) scale(1.06); box-shadow: var(--btn-primary-hover-glow) !important;
}
.search-swap-btn:active {
    transform: rotate(180deg) scale(0.94);
}

.alert-box-warning {
    padding: 10px 14px; background: rgba(217, 119, 6, 0.12); border: 1px solid rgba(217, 119, 6, 0.35); border-radius: 9px;
    color: #d97706; font-size: 12px; font-weight: 700;
}

.results-header-bar {
    align-items: flex-start; gap: 16px; margin-bottom: 22px;
}
.results-date-sub { font-size: 12.5px; color: var(--muted); margin: 4px 0 0; }
.results-controls {
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 10px;
}
.filter-pills {
    display: flex; background: var(--pill-bg); padding: 4px; border-radius: 9999px; border: 1.5px solid var(--pill-border); gap: 4px;
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
}
.pill-btn {
    border: 1px solid transparent; background: transparent; padding: 7px 16px; font-size: 12px; font-weight: 800;
    color: var(--muted); border-radius: 9999px; cursor: pointer; transition: all 0.18s ease;
}
.pill-btn:hover:not(.active) {
    background: var(--btn-secondary-bg);
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    border-color: var(--btn-secondary-border); color: var(--ink);
}
.pill-btn.active {
    background: var(--btn-primary-bg) !important; color: var(--btn-primary-text) !important; font-weight: 850;
    -webkit-backdrop-filter: blur(18px) saturate(190%) !important;
    backdrop-filter: blur(18px) saturate(190%) !important;
    border: var(--btn-primary-border) !important;
    box-shadow: var(--btn-primary-glow) !important;
}

.sort-dropdown-wrap {
    display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 800; color: var(--ink);
}
.sort-dropdown-wrap select {
    height: 36px; padding: 0 12px; border: 1.5px solid var(--pill-border); border-radius: 12px; font-size: 11.5px;
    background: var(--pill-bg); color: var(--ink); font-weight: 750;
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
}

.search-submit {
    height: 48px;
    padding: 0 24px;
    border-radius: 14px;
    font-size: 14px;
    font-weight: 850;
    background: var(--btn-primary-bg) !important;
    -webkit-backdrop-filter: blur(20px) saturate(190%) !important;
    backdrop-filter: blur(20px) saturate(190%) !important;
    color: var(--btn-primary-text) !important;
    border: var(--btn-primary-border) !important;
    box-shadow: var(--btn-primary-glow) !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s, filter 0.2s;
    align-self: flex-end;
}
.search-submit:hover {
    box-shadow: var(--btn-primary-hover-glow) !important;
    transform: translateY(-2px);
    filter: brightness(1.15);
}
.search-submit:active {
    transform: scale(0.96);
}

.modern-trip-card {
    display: grid; grid-template-columns: minmax(180px, 1.2fr) minmax(110px, 0.8fr) minmax(140px, 1fr) minmax(110px, 0.8fr) minmax(180px, 1.2fr);
    align-items: center; gap: 18px; padding: 22px 26px; background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    border: var(--glass-border); border-radius: 18px;
    box-shadow: var(--glass-specular), var(--glass-shadow); margin-bottom: 16px;
    transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.18s, box-shadow 0.18s;
}
.modern-trip-card:hover {
    transform: translateY(-2px); border-color: var(--gold); box-shadow: var(--glass-shadow-hover);
}
.operator-title { font-size: 14.5px; font-weight: 850; color: var(--ink); display: block; }
.vehicle-subtag { font-size: 11.5px; color: var(--muted); font-weight: 600; }

.trip-route-line-box {
    display: flex; flex-direction: column; align-items: center; gap: 4px;
}
.duration-badge {
    font-size: 10.5px; font-weight: 800; color: var(--gold); background: rgba(229, 169, 80, 0.14);
    border: 1px solid rgba(229, 169, 80, 0.3); padding: 2px 8px; border-radius: 12px;
}
.route-line-visual {
    width: 100%; display: flex; align-items: center;
}
.dot-start, .dot-end {
    width: 7px; height: 7px; border-radius: 50%; background: var(--gold); flex-shrink: 0;
}
.line-bar {
    flex: 1; height: 2px; background: var(--line); border-top: 1px dashed var(--gold);
}
.date-label { font-size: 10.5px; color: var(--muted); font-weight: 600; }

.trip-price-actions {
    display: flex; flex-direction: column; align-items: flex-end; gap: 8px;
}
.avail-badge {
    font-size: 10.5px; font-weight: 800; padding: 3px 8px; border-radius: 6px;
}
.avail-badge.in-stock { background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); }
.avail-badge.urgent { background: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3); }
.avail-badge.sold-out { background: rgba(100, 116, 139, 0.15); color: var(--muted); }

.price-val-box { text-align: right; }
.price-prefix { font-size: 9.5px; color: var(--muted); display: block; font-weight: 750; text-transform: uppercase; }
.fare-bold { font-size: 21px; font-weight: 900; color: var(--gold); letter-spacing: -0.5px; }
[data-theme="light"] .fare-bold { color: #8f551b; }

.choose-seat-btn {
    padding: 10px 20px !important;
    border-radius: 10px !important;
    font-size: 13px !important;
    font-weight: 850 !important;
    background: var(--btn-primary-bg) !important;
    color: var(--btn-primary-text) !important;
    border: var(--btn-primary-border) !important;
    box-shadow: var(--btn-primary-glow) !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 6px !important;
    text-decoration: none !important;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
}
.choose-seat-btn:hover {
    box-shadow: var(--btn-primary-hover-glow) !important;
    transform: translateY(-2px) !important;
    filter: brightness(1.1) !important;
    color: var(--btn-primary-text) !important;
}

.compact-trust-container {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}
.trust-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
}
.trust-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    border: var(--glass-border);
    border-radius: 16px;
    box-shadow: var(--glass-specular), var(--glass-shadow);
    transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.18s;
}
.trust-card:hover {
    transform: translateY(-2px);
    border-color: var(--gold);
}
.trust-icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: rgba(229, 169, 80, 0.15);
    border: 1.5px solid var(--gold);
    color: var(--gold);
    display: grid;
    place-items: center;
    font-size: 18px;
    font-weight: 850;
    flex-shrink: 0;
}
[data-theme="light"] .trust-icon {
    color: #8f551b;
    border-color: #8f551b;
}
.trust-text strong {
    font-size: 13.5px;
    font-weight: 850;
    color: var(--ink);
    display: block;
    margin-bottom: 2px;
}
.trust-text p {
    font-size: 11.5px;
    color: var(--muted);
    margin: 0;
    line-height: 1.45;
}
.compact-assurance-strip {
    display: flex;
