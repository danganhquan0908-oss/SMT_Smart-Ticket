@model SmartTicket.Application.Account.CustomerBookingSummaryDto
@{
    ViewData["Title"] = $"Vé xe điện tử #{Model.BookingCode} - Smart Ticket";
    var images = (Dictionary<string, string>)ViewBag.TicketQr;
    var depLocal = Model.DepartureTimeUtc.AddHours(7);
}

<div class="tickets-page-container">
    <div class="ticket-page-header no-print">
        <div class="header-left">
            <span class="booking-verified-badge" data-i18n="detail_verified_badge">✓ ĐÃ XÁC NHẬN CHÍNH CHỦ</span>
            <h1 data-i18n="detail_page_title">Vé Xe Khách Điện Tử (E-Ticket)</h1>
            <p class="ticket-subtitle">
                <span data-i18n="detail_code_label">Mã đặt chỗ:</span> <strong class="booking-code-highlight">STKT@(Model.BookingCode)</strong> · 
                <span data-i18n="detail_count_label">Số lượng:</span> <strong>@Model.Tickets.Count <span data-i18n="detail_tickets_suffix">vé</span></strong> · 
                <span data-i18n="detail_operator_label">Nhà xe:</span> <strong>@Model.OperatorName</strong>
            </p>
        </div>

        <div class="header-actions">
            <a class="button button-outline" asp-controller="Account" asp-action="Tickets" data-i18n="detail_btn_back">
                ← Vé của tôi
            </a>
            <button type="button" class="button button-outline" onclick="window.print()">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v8H6v-8z"/></svg>
                <span data-i18n="detail_btn_print">In vé / Lưu PDF</span>
            </button>
            <a class="button button-primary" asp-controller="Home" asp-action="Index" data-i18n="detail_btn_rebook">
                Đặt thêm chuyến khác →
            </a>
        </div>
    </div>

    @if (Model.Tickets.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-symbol">🎟️</div>
            <strong data-i18n="detail_empty_title">Chưa có vé nào được phát hành</strong>
            <p data-i18n="detail_empty_desc">Đơn đặt chỗ này chưa hoàn tất thanh toán hoặc đang được hệ thống đối soát. Vui lòng kiểm tra lại sau ít phút.</p>
        </div>
    }
    else
    {
        <div class="tickets-grid">
            @foreach (var ticket in Model.Tickets)
            {
                var qrBase64 = images.TryGetValue(ticket.TicketNumber, out var img) ? img : "";
                <article class="e-ticket-boarding-pass">
                    <!-- PHẦN CHÍNH CỦA VÉ -->
                    <div class="ticket-main-section">
                        <div class="ticket-brand-row">
                            <div class="ticket-logo-mark">
                                <span class="logo-box">SMT</span>
                                <div>
                                    <strong class="ticket-corp-name">SMART TICKET</strong>
                                    <small class="ticket-corp-sub"><span data-i18n="detail_legal_sub">VÉ ĐIỆN TỬ HỢP PHÁP</span> · @Model.OperatorName</small>
                                </div>
                            </div>
                            <div class="ticket-num-badge">
                                <span data-i18n="detail_ticket_num_label">SỐ VÉ:</span>
                                <strong>#@ticket.TicketNumber</strong>
                            </div>
                        </div>

                        <div class="ticket-journey-row">
                            <div class="journey-station">
                                <span class="station-lbl" data-i18n="detail_route_label">LỘ TRÌNH CHUYẾN ĐI</span>
                                <h2 class="journey-name">@Model.DepartureStation → @Model.ArrivalStation</h2>
                            </div>
                        </div>

                        <div class="ticket-meta-grid">
                            <div class="meta-cell">
                                <span class="cell-label" data-i18n="detail_dep_label">GIỜ KHỞI HÀNH</span>
                                <strong class="cell-val time-val">@depLocal.ToString("HH:mm")</strong>
                                <small class="cell-date">@depLocal.ToString("dd/MM/yyyy")</small>
                            </div>

                            <div class="meta-cell seat-cell">
                                <span class="cell-label" data-i18n="detail_seat_label">SỐ GHẾ</span>
                                <div class="seat-badge-pill">@ticket.SeatCode</div>
                            </div>

                            <div class="meta-cell">
                                <span class="cell-label" data-i18n="detail_fare_label">GIÁ VÉ NIÊM YẾT</span>
                                <strong class="cell-val price-val">@ticket.Price.ToString("N0") ₫</strong>
                                <small class="vat-sub" data-i18n="detail_vat_note">(Đã gồm thuế & bảo hiểm)</small>
                            </div>

                            <div class="meta-cell">
                                <span class="cell-label" data-i18n="detail_vehicle_type_label">LOẠI XE</span>
                                <strong class="cell-val">@Model.VehicleType</strong>
                            </div>
                        </div>

                        <div class="ticket-footer-legal">
                            <span data-i18n="detail_legal_footer">🛡️ Vé điện tử có giá trị tương đương vé giấy truyền thống theo Thông tư 12/2020/TT-BGTVT.</span>
                        </div>
                    </div>

                    <!-- ĐƯỜNG RÃNH XÉ VÉ (TEAR OFF) -->
                    <div class="tear-off-line">
                        <span class="notch-top"></span>
                        <span class="dashed-border"></span>
                        <span class="notch-bottom"></span>
                    </div>

                    <!-- PHẦN CUỐNG VÉ CHECK-IN BẰNG QR -->
                    <div class="ticket-stub-section">
                        <div class="stub-header">
                            <span class="stub-badge" data-i18n="detail_stub_title">CHECK-IN BẾN XE</span>
                            <span class="jwt-badge" data-i18n="detail_stub_valid">Mã QR hợp lệ</span>
                        </div>

                        <div class="qr-code-frame">
                            @if (!string.IsNullOrWhiteSpace(qrBase64))
                            {
                                <img src="data:image/png;base64,@qrBase64" alt="QR Check-in Vé #@ticket.TicketNumber" class="checkin-qr-img" />
                            }
                            else
                            {
                                <div class="qr-placeholder" data-i18n="detail_stub_no_qr">Không có mã QR</div>
                            }
                        </div>

                        <div class="stub-footer">
                            <span class="qr-hint" data-i18n="detail_stub_hint">Đưa mã QR cho nhân viên bến xe hoặc tài xế quét khi lên xe</span>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>

<style>
.tickets-page-container {
    max-width: 960px;
    margin: 28px auto 80px;
    padding: 0 16px;
}
.ticket-page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--glass-bg-solid, #18120c);
    border: 1px solid var(--pill-border, rgba(229, 169, 80, 0.35));
    border-radius: 20px;
    padding: 24px 28px;
    margin-bottom: 24px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
}
.ticket-page-header h1 {
    font-size: 24px;
    font-weight: 850;
    margin: 4px 0 6px;
    color: var(--ink, #fff);
}
.booking-verified-badge {
    background: rgba(16, 185, 129, 0.18);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.35);
    padding: 3px 10px;
    border-radius: 8px;
    font-size: 11.5px;
    font-weight: 800;
}
.booking-code-highlight {
    color: var(--gold, #e5a950);
    font-family: monospace;
    font-size: 15px;
}
.header-actions {
    display: flex;
    gap: 10px;
}
.tickets-grid {
    display: flex;
    flex-direction: column;
    gap: 22px;
}
.e-ticket-boarding-pass {
    display: grid;
    grid-template-columns: 1fr 20px 240px;
    background: linear-gradient(135deg, #1f1710 0%, #150f0a 100%);
    border: 1px solid var(--pill-border, rgba(229, 169, 80, 0.35));
    border-radius: 20px;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    position: relative;
}
.ticket-main-section {
    padding: 26px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}
.ticket-brand-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}
.ticket-logo-mark {
    display: flex;
    align-items: center;
    gap: 10px;
}
.logo-box {
    background: var(--gold, #e5a950);
    color: #140e08;
    font-weight: 900;
    font-size: 13px;
    padding: 4px 8px;
    border-radius: 6px;
}
.ticket-corp-name {
    display: block;
    font-size: 14px;
    font-weight: 850;
    color: var(--ink, #fff);
}
.ticket-corp-sub {
    font-size: 10px;
    color: var(--muted, #9ca3af);
    letter-spacing: 0.5px;
}
.ticket-num-badge {
    background: rgba(229, 169, 80, 0.12);
    border: 1px solid rgba(229, 169, 80, 0.35);
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 12px;
    color: var(--gold, #e5a950);
}
.journey-station .station-lbl {
    font-size: 10.5px;
    letter-spacing: 1px;
    color: var(--muted, #9ca3af);
    font-weight: 700;
}
.journey-name {
    font-size: 22px;
    font-weight: 900;
    color: var(--ink, #fff);
    margin: 4px 0 16px;
}
.ticket-meta-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 14px;
    margin-bottom: 14px;
}
.meta-cell .cell-label {
    display: block;
    font-size: 10px;
    color: var(--muted, #9ca3af);
    font-weight: 700;
    margin-bottom: 2px;
}
.meta-cell .cell-val {
    font-size: 14px;
    font-weight: 800;
    color: var(--ink, #fff);
}
.time-val { color: var(--gold, #e5a950) !important; font-size: 18px !important; }
.price-val { color: #f87171 !important; }
.seat-badge-pill {
    display: inline-block;
    background: var(--gold, #e5a950);
    color: #160f08;
    font-size: 16px;
    font-weight: 900;
    padding: 2px 10px;
    border-radius: 8px;
}
.ticket-footer-legal {
    font-size: 11px;
    color: var(--muted, #9ca3af);
}
.tear-off-line {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
}
.dashed-border {
    width: 0;
    height: 100%;
    border-left: 2px dashed rgba(229, 169, 80, 0.35);
}
.notch-top, .notch-bottom {
    width: 20px;
    height: 10px;
    background: var(--bg, #0c0906);
}
.notch-top { border-radius: 0 0 10px 10px; }
.notch-bottom { border-radius: 10px 10px 0 0; }
.ticket-stub-section {
    padding: 22px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    background: rgba(0, 0, 0, 0.35);
    text-align: center;
}
.stub-badge {
    display: block;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.5px;
    color: var(--gold, #e5a950);
}
.jwt-badge {
    display: block;
    font-size: 9.5px;
    color: var(--muted, #9ca3af);
}
.qr-code-frame {
    background: #fff;
    padding: 8px;
    border-radius: 12px;
    margin: 10px 0;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
}
.checkin-qr-img {
    width: 140px;
    height: 140px;
    display: block;
}
.qr-hint {
    font-size: 10.5px;
    color: var(--muted, #9ca3af);
    line-height: 1.3;
}
@@media print {
    .no-print { display: none !important; }
    .e-ticket-boarding-pass { break-inside: avoid; border: 1px solid #333 !important; }
    body { background: #fff !important; color: #000 !important; }
}
@@media (max-width: 768px) {
    .e-ticket-boarding-pass { grid-template-columns: 1fr; }
    .tear-off-line { display: none; }
    .ticket-meta-grid { grid-template-columns: 1fr 1fr; }
    .ticket-page-header { flex-direction: column; align-items: flex-start; gap: 14px; }
}
</style>
