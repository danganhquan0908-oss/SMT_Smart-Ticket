@model SmartTicket.Web.Models.TwoFactorViewModel
@{ ViewData["Title"] = "Xác thực hai lớp"; }
<section class="login-shell"><div class="login-card"><div class="brand-mark">SMT</div><p class="eyebrow" data-i18n="twofa_eyebrow">BẢO MẬT TÀI KHOẢN</p><h1 data-i18n="twofa_title">Nhập mã xác thực</h1><p class="muted" data-i18n="twofa_subtitle">Nhập mã 6 chữ số từ ứng dụng xác thực của bạn.</p><form asp-action="TwoFactor" method="post" class="form-stack"><input asp-for="ReturnUrl" type="hidden" /><input asp-for="RememberMe" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="Code" data-i18n="twofa_code_label">Mã xác thực</label><input asp-for="Code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" /><span asp-validation-for="Code" class="field-error"></span><button class="button button-primary button-wide" data-i18n="twofa_submit_btn">Xác minh</button></form></div></section>
