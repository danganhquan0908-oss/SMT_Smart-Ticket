@model SmartTicket.Web.Models.CustomerProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân & Bảo mật - Smart Ticket";
}

<div class="profile-page-shell">
    <div class="profile-header-banner">
        <div class="profile-header-content">
            <span class="eyebrow" data-i18n="profile_hero_eyebrow">TRUNG TÂM TÀI KHOẢN HÀNH KHÁCH</span>
            <h1 data-i18n="profile_hero_title">Hồ sơ cá nhân & Bảo mật</h1>
            <p class="muted" data-i18n="profile_hero_subtitle">Quản lý thông tin liên hệ khi nhận vé điện tử và cập nhật mật khẩu bảo vệ tài khoản.</p>
        </div>
        <div class="profile-quick-nav">
            <a class="button button-primary" asp-controller="Account" asp-action="Tickets">
                <span data-i18n="profile_btn_view_tickets">🎟️ Xem vé của tôi →</span>
            </a>
        </div>
    </div>

    @if (TempData["ProfileSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>✓ Thành công!</strong> @TempData["ProfileSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["PasswordSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>✓ Thành công!</strong> @TempData["PasswordSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["PasswordError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>⚠️ Lỗi:</strong> @TempData["PasswordError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="profile-grid">
        <!-- CỘT 1: THÔNG TIN CÁ NHÂN -->
        <div class="profile-card">
            <div class="card-header-row">
                <div class="card-icon-badge">👤</div>
                <div>
                    <h2 data-i18n="profile_info_card_title">Thông tin hành khách</h2>
                    <p class="muted" data-i18n="profile_info_card_desc">Tên và số điện thoại này sẽ tự động điền khi bạn đặt vé mới.</p>
                </div>
            </div>

            <form asp-action="Profile" method="post" class="form-stack">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="form-group-item">
                    <label asp-for="FullName"><span data-i18n="profile_label_fullname">Họ và tên hành khách</span> <span class="text-danger">*</span></label>
                    <input asp-for="FullName" class="form-control" placeholder="Ví dụ: Đặng Anh Quân" data-i18n-placeholder="profile_placeholder_fullname" maxlength="160" required />
                    <span asp-validation-for="FullName" class="field-error"></span>
                </div>

                <div class="form-group-item">
                    <label asp-for="PhoneNumber" data-i18n="profile_label_phone">Số điện thoại liên hệ</label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="Ví dụ: 0345 588 495" data-i18n-placeholder="profile_placeholder_phone" maxlength="24" />
                    <span asp-validation-for="PhoneNumber" class="field-error"></span>
                </div>

                <div class="form-group-item">
                    <label asp-for="Email" data-i18n="profile_label_email">Địa chỉ Email (Định danh tài khoản)</label>
                    <div class="input-lock-wrapper">
                        <input asp-for="Email" class="form-control input-readonly" readonly />
                        <span class="lock-shield" title="Email được cố định làm định danh đăng nhập" data-i18n="profile_email_locked">🔒 Cố định</span>
                    </div>
                    <small class="form-text text-muted" data-i18n="profile_email_hint">Email dùng để nhận vé điện tử và đăng nhập, không thể thay đổi trực tiếp.</small>
                </div>

                <button type="submit" class="button button-primary button-wide mt-3" data-i18n="profile_btn_save_info">
                    Lưu thay đổi thông tin
                </button>
            </form>
        </div>

        <!-- CỘT 2: ĐỔI MẬT KHẨU -->
        <div class="profile-card">
            <div class="card-header-row">
                <div class="card-icon-badge">🔑</div>
                <div>
                    <h2 data-i18n="profile_pwd_card_title">Đổi mật khẩu bảo mật</h2>
                    <p class="muted" data-i18n="profile_pwd_card_desc">Mật khẩu cần tối thiểu 12 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</p>
                </div>
            </div>

            <form asp-action="ChangePassword" method="post" class="form-stack">
                <div class="form-group-item">
                    <label for="CurrentPassword"><span data-i18n="profile_label_current_pwd">Mật khẩu hiện tại</span> <span class="text-danger">*</span></label>
                    <input type="password" id="CurrentPassword" name="CurrentPassword" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu đang dùng" data-i18n-placeholder="profile_placeholder_current_pwd" required />
                </div>

                <div class="form-group-item">
                    <label for="NewPassword"><span data-i18n="profile_label_new_pwd">Mật khẩu mới</span> <span class="text-danger">*</span></label>
                    <input type="password" id="NewPassword" name="NewPassword" class="form-control" autocomplete="new-password" placeholder="Tối thiểu 12 ký tự mạnh" data-i18n-placeholder="profile_placeholder_new_pwd" minlength="12" required />
                </div>

                <div class="form-group-item">
                    <label for="ConfirmPassword"><span data-i18n="profile_label_confirm_pwd">Xác nhận mật khẩu mới</span> <span class="text-danger">*</span></label>
                    <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" data-i18n-placeholder="profile_placeholder_confirm_pwd" minlength="12" required />
                </div>

                <button type="submit" class="button button-secondary button-wide mt-3" data-i18n="profile_btn_save_pwd">
                    Cập nhật mật khẩu mới
                </button>
            </form>
        </div>
    </div>
</div>

<style>
.profile-page-shell {
    max-width: 1040px;
    margin: 32px auto 80px;
    padding: 0 16px;
}
.profile-header-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: radial-gradient(circle at 85% 15%, rgba(229, 169, 80, 0.22), transparent 45%),
                linear-gradient(135deg, #181109 0%, #24170d 55%, #382414 100%);
    border: 1px solid rgba(229, 169, 80, 0.35);
    border-radius: 20px;
    padding: 28px 32px;
    margin-bottom: 24px;
    color: #fff;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.35);
}
.profile-header-content h1 {
    font-size: 24px;
    font-weight: 850;
    margin: 6px 0 8px;
    color: #fff;
}
.profile-header-content .eyebrow {
    font-size: 11.5px;
    letter-spacing: 1px;
    font-weight: 800;
    color: var(--gold, #e5a950);
}
.profile-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
}
.profile-card {
    background: var(--glass-bg-solid, #18120c);
    border: 1px solid var(--pill-border, rgba(229, 169, 80, 0.25));
    border-radius: 18px;
    padding: 26px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
}
.card-header-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line, rgba(255, 255, 255, 0.08));
}
.card-icon-badge {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(229, 169, 80, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
}
.card-header-row h2 {
    font-size: 18px;
    font-weight: 800;
    margin: 0 0 2px;
    color: var(--ink, #fff);
}
.form-group-item {
    margin-bottom: 16px;
}
.form-group-item label {
    display: block;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 6px;
    color: var(--ink, #fff);
}
.form-control {
    width: 100%;
    height: 44px;
    border: 1.5px solid var(--line, rgba(255, 255, 255, 0.15));
    border-radius: 10px;
    padding: 0 14px;
    font-size: 14px;
    background: var(--soft, #1e1710);
    color: var(--ink, #fff);
    outline: none;
    box-sizing: border-box;
    transition: all 0.2s;
}
.form-control:focus {
    border-color: var(--gold, #e5a950);
    box-shadow: 0 0 0 3px rgba(229, 169, 80, 0.2);
}
.input-lock-wrapper {
    position: relative;
    display: flex;
    align-items: center;
}
.input-readonly {
    background: rgba(255, 255, 255, 0.04) !important;
    color: var(--muted, #9ca3af) !important;
    cursor: not-allowed;
    padding-right: 90px;
}
.lock-shield {
    position: absolute;
    right: 12px;
    font-size: 11.5px;
    font-weight: 750;
    color: var(--gold, #e5a950);
    background: rgba(229, 169, 80, 0.12);
    padding: 2px 8px;
    border-radius: 6px;
}
@@media (max-width: 800px) {
    .profile-grid { grid-template-columns: 1fr; }
    .profile-header-banner { flex-direction: column; align-items: flex-start; gap: 16px; }
}
</style>
