@model SmartTicket.Web.Models.PassengerRegistrationViewModel
@{ ViewData["Title"] = "Đăng ký hành khách"; }
<section class="login-shell">
    <aside class="login-brand-panel">
        <div class="login-logo-frame"><img src="~/images/smart-ticket-smt-logo.png" alt="Logo Smart Ticket - SMT" asp-append-version="true" /></div>
        <p class="eyebrow" data-i18n="reg_brand_eyebrow">SMART TICKET - SMT</p>
        <h2 data-i18n="reg_brand_heading" data-i18n-html>Hành trình mới<br /><em>bắt đầu từ đây.</em></h2>
        <p class="login-brand-copy" data-i18n="reg_brand_copy">Đăng ký tài khoản hành khách để bắt đầu sử dụng Smart Ticket.</p>
        <div class="login-brand-footer"><span data-i18n="reg_brand_tagline">ĐẶT VÉ · CHỌN GHẾ · LÊN ĐƯỜNG</span><span class="login-foil-line"></span></div>
    </aside>
    <div class="login-card">
        <div class="login-mobile-brand"><img src="~/images/smart-ticket-smt-logo.png" alt="" asp-append-version="true" /><strong>Smart Ticket - SMT</strong></div>
        <p class="eyebrow" data-i18n="reg_card_eyebrow">TÀI KHOẢN HÀNH KHÁCH</p>
        <h1 data-i18n="reg_card_title">Tạo tài khoản</h1>
        <p class="muted" data-i18n="reg_card_subtitle">Đăng ký miễn phí để bắt đầu đặt vé.</p>
        <form asp-action="Register" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" class="form-stack">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <label asp-for="FullName" data-i18n="reg_label_fullname">Họ và tên hành khách</label><input asp-for="FullName" autocomplete="name" placeholder="Ví dụ: Nguyễn Văn A" data-i18n-placeholder="reg_placeholder_fullname" /><span asp-validation-for="FullName" class="field-error"></span>
            <label asp-for="Email" data-i18n="reg_label_email">Email</label><input asp-for="Email" autocomplete="email" placeholder="email@example.com" data-i18n-placeholder="reg_placeholder_email" /><span asp-validation-for="Email" class="field-error"></span>
            <label asp-for="PhoneNumber" data-i18n="reg_label_phone">Số điện thoại</label><input asp-for="PhoneNumber" autocomplete="tel" placeholder="09xx xxx xxx" data-i18n-placeholder="reg_placeholder_phone" /><span asp-validation-for="PhoneNumber" class="field-error"></span>
            <label asp-for="Password" data-i18n="reg_label_pwd">Mật khẩu</label><input asp-for="Password" autocomplete="new-password" placeholder="Ít nhất 12 ký tự" data-i18n-placeholder="reg_placeholder_pwd" /><span asp-validation-for="Password" class="field-error"></span>
            <label asp-for="ConfirmPassword" data-i18n="reg_label_confirm_pwd">Xác nhận mật khẩu</label><input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Nhập lại mật khẩu" data-i18n-placeholder="reg_placeholder_confirm_pwd" /><span asp-validation-for="ConfirmPassword" class="field-error"></span>
            <button class="button button-primary button-wide" type="submit"><span data-i18n="reg_btn_submit">Tạo tài khoản</span> <span aria-hidden="true">↗</span></button>
        </form>
        <p class="register-note"><span data-i18n="reg_has_account">Đã có tài khoản?</span> <a asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" data-i18n="reg_link_login">Đăng nhập</a></p>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
