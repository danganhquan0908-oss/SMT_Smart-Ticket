@model SmartTicket.Web.Models.CustomerTicketsViewModel
@{
    ViewData["Title"] = "Vé của tôi - Smart Ticket";
}

<div class="tickets-page-shell">
    <div class="tickets-hero-banner">
        <div>
            <span class="eyebrow">TRUNG TÂM TÀI KHOẢN HÀNH KHÁCH</span>
            <h1>Vé xe của tôi</h1>
            <p class="muted">Toàn bộ vé xe điện tử và lịch sử đặt chỗ của bạn được lưu trữ an toàn tại đây.</p>
        </div>
        <div class="tickets-hero-actions">
            <a class="button button-outline" asp-controller="Account" asp-action="Profile">
                👤 Cập nhật hồ sơ
            </a>
            <a class="button button-primary" asp-controller="Home" asp-action="Index">
                🔍 Tìm chuyến xe mới →
            </a>
        </div>
    </div>

    <!-- TABS ĐIỀU HƯỚNG TRẠNG THÁI VÉ -->
    <div class="tickets-tabs-nav" role="tablist">
        <button type="button" class="tab-pill active" onclick="switchTab('upcoming', this)">
            🚌 Sắp khởi hành <span class="tab-badge">@Model.Upcoming.Count</span>
        </button>
        <button type="button" class="tab-pill" onclick="switchTab('pending', this)">
            ⏱️ Chờ thanh toán <span class="tab-badge badge-amber">@Model.Pending.Count</span>
        </button>
        <button type="button" class="tab-pill" onclick="switchTab('history', this)">
            📜 Lịch sử chuyến đi <span class="tab-badge badge-muted">@Model.History.Count</span>
        </button>
    </div>

    <!-- TAB 1: SẮP KHỞI HÀNH -->
    <div id="tab-upcoming" class="tab-pane active">
        @if (Model.Upcoming.Count == 0)
        {
            <div class="empty-bookings-box">
                <div class="empty-icon">🎟️</div>
                <h3>Bạn chưa có vé xe nào sắp khởi hành</h3>
                <p class="muted">Hãy đặt chuyến xe mới để trải nghiệm dịch vụ xe khách chất lượng cao liên tỉnh.</p>
                <a class="button button-primary mt-2" asp-controller="Home" asp-action="Index">Đặt vé ngay bây giờ</a>
            </div>
        }
        else
        {
            <div class="bookings-grid">
                @foreach (var b in Model.Upcoming)
                {
                    var depLocal = b.DepartureTimeUtc.AddHours(7);
                    <div class="booking-ticket-card">
                        <div class="card-top-row">
                            <span class="badge-status-paid">✓ ĐÃ THANH TOÁN</span>
                            <span class="booking-code-tag">MÃ: <strong>STKT@(b.BookingCode)</strong></span>
                        </div>
                        <div class="card-route-title">
                            <h3>@b.DepartureStation <span class="route-arrow">→</span> @b.ArrivalStation</h3>
                        </div>
                        <div class="card-meta-row">
                            <div class="meta-item">
                                <span class="m-label">Khởi hành:</span>
                                <strong class="m-val text-gold">@depLocal.ToString("HH:mm · dd/MM/yyyy")</strong>
                            </div>
                            <div class="meta-item">
                                <span class="m-label">Nhà xe:</span>
                                <strong class="m-val">@b.OperatorName</strong>
                            </div>
                            <div class="meta-item">
                                <span class="m-label">Ghế đã đặt:</span>
                                <strong class="m-val seat-chips">@string.Join(", ", b.SeatCodes)</strong>
                            </div>
                            <div class="meta-item">
                                <span class="m-label">Tổng tiền:</span>
                                <strong class="m-val text-crimson font-large">@b.TotalAmount.ToString("N0") ₫</strong>
                            </div>
                        </div>
                        <div class="card-action-bar">
                            <a class="button button-primary button-wide" asp-controller="Account" asp-action="TicketDetails" asp-route-bookingId="@b.BookingId">
                                📱 Xem vé & Mã QR lên xe
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- TAB 2: CHỜ THANH TOÁN -->
    <div id="tab-pending" class="tab-pane" style="display: none;">
        @if (Model.Pending.Count == 0)
        {
            <div class="empty-bookings-box">
                <div class="empty-icon">✓</div>
                <h3>Không có đơn đặt chỗ nào đang chờ thanh toán</h3>
                <p class="muted">Tất cả các đơn đặt vé của bạn đều đã được hoàn tất hoặc giải phóng ghế an toàn.</p>
            </div>
        }
        else
        {
            <div class="bookings-grid">
                @foreach (var b in Model.Pending)
                {
                    var depLocal = b.DepartureTimeUtc.AddHours(7);
                    <div class="booking-ticket-card card-pending" id="booking-card-@b.BookingId" data-booking-id="@b.BookingId" data-expires="@b.ExpiresAtUtc.ToString("o")">
                        <div class="card-top-row">
                            <span class="badge-status-pending booking-countdown-pill" data-expires="@b.ExpiresAtUtc.ToString("o")">⏱️ Đang tính giờ...</span>
                            <span class="booking-code-tag">MÃ: <strong>STKT@(b.BookingCode)</strong></span>
                        </div>
                        <div class="card-route-title">
                            <h3>@b.DepartureStation <span class="route-arrow">→</span> @b.ArrivalStation</h3>
                        </div>
                        <div class="card-meta-row">
                            <div class="meta-item">
                                <span class="m-label">Khởi hành:</span>
                                <strong class="m-val">@depLocal.ToString("HH:mm · dd/MM/yyyy")</strong>
                            </div>
                            <div class="meta-item">
                                <span class="m-label">Ghế giữ chỗ:</span>
                                <strong class="m-val">@string.Join(", ", b.SeatCodes)</strong>
                            </div>
                            <div class="meta-item">
                                <span class="m-label">Tổng tiền cần CK:</span>
                                <strong class="m-val text-crimson font-large">@b.TotalAmount.ToString("N0") ₫</strong>
                            </div>
                        </div>
                        <div class="card-action-bar pending-actions-bar">
                            <div class="ref-copy-wrap">
                                <span class="text-muted small">Nội dung: <strong class="ref-code">STKT@(b.BookingCode)</strong></span>
                                <button type="button" class="btn-copy-chip btn-copy-inline" data-copy="STKT@(b.BookingCode)">Sao chép</button>
                            </div>
                            <button type="button" class="button-pay-submit btn-resume-pay"
                                    data-booking-id="@b.BookingId"
                                    data-booking-code="@b.BookingCode"
                                    data-amount="@b.TotalAmount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                    data-expires="@b.ExpiresAtUtc.ToString("o")">
                                <span>⚡ Tiếp tục thanh toán VietQR</span>
                                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- TAB 3: LỊCH SỬ CHUYẾN ĐI -->
    <div id="tab-history" class="tab-pane" style="display: none;">
        @if (Model.History.Count == 0)
        {
            <div class="empty-bookings-box">
                <div class="empty-icon">📜</div>
                <h3>Chưa có lịch sử chuyến đi cũ</h3>
                <p class="muted">Các chuyến xe đã hoàn thành hoặc hết hạn sẽ được lưu trữ tại đây.</p>
            </div>
        }
        else
        {
            <div class="bookings-grid">
                @foreach (var b in Model.History)
                {
                    var depLocal = b.DepartureTimeUtc.AddHours(7);
                    var isPaid = b.Status == "Paid";
                    <div class="booking-ticket-card card-history">
                        <div class="card-top-row">
                            @if (b.Status == "PaidOverdueUnassigned")
                            {
                                <span class="badge-status-warning">⚠️ THANH TOÁN TRỄ (GHẾ ĐÃ BÁN)</span>
                            }
                            else
                            {
                                <span class="@(isPaid ? "badge-status-history" : "badge-status-expired")">
                                    @(isPaid ? "✓ ĐÃ HOÀN THÀNH" : "✕ ĐÃ HẾT HẠN")
                                </span>
                            }
                            <span class="booking-code-tag">MÃ: <strong>STKT@(b.BookingCode)</strong></span>
                        </div>
                        <div class="card-route-title">
                            <h3>@b.DepartureStation <span class="route-arrow">→</span> @b.ArrivalStation</h3>
                        </div>
                        <div class="card-meta-row">
                            <div class="meta-item">
                                <span class="m-label">Khởi hành:</span>
                                <span class="m-val">@depLocal.ToString("HH:mm · dd/MM/yyyy")</span>
                            </div>
                            <div class="meta-item">
                                <span class="m-label">Nhà xe:</span>
                                <span class="m-val">@b.OperatorName</span>
                            </div>
                            <div class="meta-item">
                                <span class="m-label">Ghế:</span>
                                <span class="m-val">@string.Join(", ", b.SeatCodes)</span>
                            </div>
                            <div class="meta-item">
                                <span class="m-label">Tổng tiền:</span>
                                <span class="m-val">@b.TotalAmount.ToString("N0") ₫</span>
                            </div>
                        </div>
                        @if (b.Status == "PaidOverdueUnassigned")
                        {
                            <div class="overdue-notice-box">
                                <strong>⚠️ Giao dịch chuyển tiền sau khi hết hạn giữ chỗ:</strong>
                                <p>Hệ thống đã nhận thanh toán nhưng ghế đã bị bán cho khách khác sau khi hết hạn 7 phút. Vui lòng liên hệ hotline tổng đài <strong>1900 6868</strong> để được xếp chuyến tương đương hoặc hoàn tiền 100%.</p>
                            </div>
                        }
                        @if (isPaid && b.Tickets.Count > 0)
                        {
                            <div class="card-action-bar">
                                <a class="button button-outline button-wide" asp-controller="Account" asp-action="TicketDetails" asp-route-bookingId="@b.BookingId">
                                    Xem lại vé điện tử & In PDF
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
    <!-- MODAL VIETQR POPUP TRỰC TIẾP TRÊN TRANG (FROSTED GLASS) -->
    <div id="qr-modal-backdrop" class="qr-modal-backdrop" style="display: none;">
        <div class="qr-modal-card">
            <button type="button" class="btn-close-modal" id="btn-close-modal" title="Đóng cửa sổ">✕</button>
            
            <div class="modal-header">
                <div class="modal-badge-row">
                    <span class="badge-vietqr-brand">⚡ VietQR · Napas 247 · <span id="modal-bank-title">@(ViewBag.BankName ?? "VietinBank")</span></span>
                    <span class="badge-modal-timer" id="modal-countdown-badge">⏱️ 07:00</span>
                </div>
                <h2 class="modal-title">Quét Mã VietQR Tiếp Tục Thanh Toán</h2>
                <p class="modal-subtitle">Mở ứng dụng Ngân hàng bất kỳ hoặc MoMo/VNPay để quét mã thanh toán 1-chạm</p>
            </div>

            <div class="modal-body-layout">
                <!-- Cột trái: QR Code -->
                <div class="modal-qr-column">
                    <div class="modal-qr-frame" id="modal-qr-frame">
                        <img id="modal-qr-image" src="" alt="Mã VietQR" />
                        <div id="modal-qr-overlay-expired" class="modal-expired-overlay" style="display: none;">
                            <span class="expired-icon">⚠️</span>
                            <h4>Hết hạn giữ chỗ 7 phút</h4>
                            <p>Thời gian giữ chỗ đã hết, ghế đã được tự động giải phóng.</p>
                        </div>
                    </div>
                    <div class="modal-lock-tag">
                        <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
                        <span>Số tiền đã khóa cứng (EMVCo Tag 54)</span>
                    </div>
                </div>

                <!-- Cột phải: Thông tin chuyển khoản -->
                <div class="modal-info-column">
                    <div class="modal-specs-box">
                        <div class="modal-spec-row">
                            <span class="m-label">Ngân hàng thụ hưởng:</span>
                            <strong class="m-val" id="modal-bank-name">@(ViewBag.BankName ?? "VietinBank (Napas 247)")</strong>
                        </div>
                        <div class="modal-spec-row">
                            <span class="m-label">Số tài khoản:</span>
                            <div class="m-val-wrap">
                                <strong class="m-val font-mono" id="modal-account-num">@(ViewBag.AccountNumber ?? "")</strong>
                                <button type="button" class="btn-copy-chip" id="btn-modal-copy-acc">Sao chép</button>
                            </div>
                        </div>
                        <div class="modal-spec-row">
                            <span class="m-label">Chủ tài khoản:</span>
                            <strong class="m-val" id="modal-account-name">@(ViewBag.AccountName ?? "")</strong>
                        </div>
                        <div class="modal-spec-row">
                            <span class="m-label">Số tiền:</span>
                            <div class="m-val-wrap">
                                <strong class="m-val text-crimson font-large" id="modal-amount-display">0 ₫</strong>
                                <button type="button" class="btn-copy-chip" id="btn-modal-copy-amount">Sao chép</button>
                            </div>
                        </div>
                        <div class="modal-spec-row highlight-spec">
                            <span class="m-label">Nội dung CK:</span>
                            <div class="m-val-wrap">
                                <strong class="m-val font-mono text-gold" id="modal-ref-display">STKT...</strong>
                                <button type="button" class="btn-copy-chip" id="btn-modal-copy-ref">Sao chép</button>
                            </div>
                        </div>
                    </div>

                    <div class="modal-status-badge" id="modal-status-box">
                        <div class="status-pulse-dot"></div>
                        <div class="status-text-content">
                            <strong id="modal-status-title">Đang chờ bạn quét mã thanh toán...</strong>
                            <p id="modal-status-desc">Hệ thống tự động kích hoạt vé ngay khi giao dịch thành công.</p>
                        </div>
                    </div>

                    <div class="modal-actions-col">
                        @if (ViewBag.IsDev == true)
                        {
                            <button type="button" class="btn-modal-dev" id="btn-modal-dev-simulate">
                                ⚡ Giả lập thanh toán thành công (Môi trường Dev)
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
function switchTab(tabId, btn) {
    document.querySelectorAll('.tickets-tabs-nav .tab-pill').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.tab-pane').forEach(el => el.style.display = 'none');
    
    btn.classList.add('active');
    const target = document.getElementById('tab-' + tabId);
    if (target) target.style.display = 'block';
}

(() => {
    // Copy handlers cho các nút inline
    document.querySelectorAll('.btn-copy-inline').forEach(btn => {
        btn.addEventListener('click', () => {
            const text = btn.getAttribute('data-copy');
            if (text) {
                navigator.clipboard.writeText(text);
                const old = btn.textContent;
                btn.textContent = '✓ Đã chép';
                setTimeout(() => btn.textContent = old, 2000);
            }
        });
    });

    // Đồng hồ đếm ngược từng giây trên các thẻ giữ chỗ
    function updateCardCountdowns() {
        const now = new Date().getTime();
        document.querySelectorAll('.booking-countdown-pill').forEach(el => {
            const expiresStr = el.getAttribute('data-expires');
            if (!expiresStr) return;
            const expires = new Date(expiresStr).getTime();
            const diffSec = Math.floor((expires - now) / 1000);
            const card = el.closest('.card-pending');
            const btn = card ? card.querySelector('.btn-resume-pay') : null;

            if (diffSec <= 0) {
                el.textContent = '✕ ĐÃ HẾT HẠN GIỮ CHỖ';
                el.classList.remove('critical');
                el.classList.add('expired');
                if (card) {
                    card.classList.add('card-dimmed-expired');
                }
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<span>Đã hết hạn giữ chỗ</span>';
                }
            } else {
                const mins = String(Math.floor(diffSec / 60)).padStart(2, '0');
                const secs = String(diffSec % 60).padStart(2, '0');
                el.textContent = `⏱️ GIỮ CHỖ CÒN: ${mins}:${secs}`;
                if (diffSec <= 120) {
                    el.classList.add('critical');
                } else {
                    el.classList.remove('critical');
                }
            }
        });
    }
    setInterval(updateCardCountdowns, 1000);
    updateCardCountdowns();

    // Quản lý Modal VietQR
    let currentBookingId = null;
    let currentBookingCode = '';
    let currentAmount = 0;
    let modalTimer = null;
    let modalPollTimer = null;
    let modalRemaining = 420;
    let signalRConn = null;

    const modalBackdrop = document.getElementById('qr-modal-backdrop');
    const modalQrImg = document.getElementById('modal-qr-image');
    const modalCountdownEl = document.getElementById('modal-countdown-badge');
    const modalAmountEl = document.getElementById('modal-amount-display');
    const modalRefEl = document.getElementById('modal-ref-display');
    const modalExpiredOverlay = document.getElementById('modal-qr-overlay-expired');
    const modalStatusTitle = document.getElementById('modal-status-title');
    const modalStatusDesc = document.getElementById('modal-status-desc');
    const btnCloseModal = document.getElementById('btn-close-modal');
    const modalDevBtn = document.getElementById('btn-modal-dev-simulate');

    const defaultBankBin = '@(ViewBag.BankBin ?? "970415")';
    const defaultAccountNumber = '@(ViewBag.AccountNumber ?? "103880262473")';
    const defaultAccountName = '@(ViewBag.AccountName ?? "DANG ANH QUAN")';

    const openQrModal = async (bookingId, bookingCode, amount, expiresStr) => {
        currentBookingId = bookingId;
        currentBookingCode = bookingCode;
        currentAmount = amount;

        const expires = new Date(expiresStr).getTime();
        const now = new Date().getTime();
        modalRemaining = Math.max(0, Math.floor((expires - now) / 1000));

        const refText = 'STKT' + bookingCode;
        const amountFormatted = Number(amount).toString();

        modalAmountEl.textContent = Number(amount).toLocaleString('vi-VN') + ' ₫';
        modalRefEl.textContent = refText;
        modalExpiredOverlay.style.display = modalRemaining <= 0 ? 'flex' : 'none';
        modalStatusTitle.textContent = "Đang chờ bạn quét mã thanh toán...";
        modalStatusDesc.textContent = "Hệ thống tự động kích hoạt vé ngay khi giao dịch thành công.";
        modalStatusTitle.style.color = "var(--ink, #fff)";

        // Fast fallback image từ Napas VietQR CDN
        const vietQrUrl = `https://img.vietqr.io/image/${defaultBankBin}-${defaultAccountNumber}-compact2.png?amount=${amountFormatted}&addInfo=${encodeURIComponent(refText)}&accountName=${encodeURIComponent(defaultAccountName)}`;
        modalQrImg.src = vietQrUrl;

        modalBackdrop.style.display = 'flex';

        // Đếm ngược trong modal
        clearInterval(modalTimer);
        const updateModalCountdown = () => {
            const mins = String(Math.floor(modalRemaining / 60)).padStart(2, '0');
            const secs = String(modalRemaining % 60).padStart(2, '0');
            modalCountdownEl.textContent = `⏱️ ${mins}:${secs}`;
            if (modalRemaining <= 0) {
                clearInterval(modalTimer);
                modalExpiredOverlay.style.display = 'flex';
            } else {
                modalRemaining--;
            }
        };
        updateModalCountdown();
        modalTimer = setInterval(updateModalCountdown, 1000);

        // Gọi API lấy ảnh Base64 offline và chi tiết chính xác từ server
        try {
            const res = await fetch(`/account/bookings/${bookingId}/payment-details`);
            if (res.ok) {
                const data = await res.json();
                if (data.qrImage) modalQrImg.src = data.qrImage;
                if (data.secondsRemaining !== undefined) modalRemaining = data.secondsRemaining;
                if (data.bankName) document.getElementById('modal-bank-name').textContent = data.bankName;
                if (data.accountNumber) document.getElementById('modal-account-num').textContent = data.accountNumber;
                if (data.accountName) document.getElementById('modal-account-name').textContent = data.accountName;
            } else if (res.status === 409) {
                modalExpiredOverlay.style.display = 'flex';
            }
        } catch (err) {
            console.warn("Could not fetch detailed payment info:", err);
        }

        // Bắt đầu Polling 2.5s kiểm tra trạng thái
        clearInterval(modalPollTimer);
        modalPollTimer = setInterval(async () => {
            try {
                const pRes = await fetch(`/account/bookings/${bookingId}/payment-state`);
                if (pRes.ok) {
                    const state = await pRes.json();
                    if (state.isPaid) {
                        onPaymentSuccess();
                    } else if (state.isExpired) {
                        modalExpiredOverlay.style.display = 'flex';
                    }
                }
            } catch (e) {
                console.warn("Polling payment state failed:", e);
            }
        }, 2500);

        // Tham gia nhóm SignalR của booking này
        if (signalRConn && signalRConn.state === 'Connected') {
            try {
                await signalRConn.invoke('JoinBooking', bookingId);
            } catch (e) {
                console.warn("JoinBooking SignalR error:", e);
            }
        }
    };

    const onPaymentSuccess = () => {
        clearInterval(modalTimer);
        clearInterval(modalPollTimer);
        modalStatusTitle.textContent = "✓ Thanh toán thành công!";
        modalStatusTitle.style.color = "#10b981";
        modalStatusDesc.textContent = "Hệ thống đã nhận thanh toán. Đang chuyển tới danh sách vé...";
        setTimeout(() => {
            window.location.reload();
        }, 1000);
    };

    const closeQrModal = () => {
        modalBackdrop.style.display = 'none';
        clearInterval(modalTimer);
        clearInterval(modalPollTimer);
        if (signalRConn && signalRConn.state === 'Connected' && currentBookingId) {
            signalRConn.invoke('LeaveBooking', currentBookingId).catch(() => {});
        }
        currentBookingId = null;
    };

    if (btnCloseModal) btnCloseModal.addEventListener('click', closeQrModal);
    if (modalBackdrop) {
        modalBackdrop.addEventListener('click', (e) => {
            if (e.target === modalBackdrop) closeQrModal();
        });
    }

    // Gán sự kiện click nút Tiếp tục thanh toán
    document.querySelectorAll('.btn-resume-pay').forEach(btn => {
        btn.addEventListener('click', () => {
            const bId = btn.getAttribute('data-booking-id');
            const bCode = btn.getAttribute('data-booking-code');
            const bAmt = btn.getAttribute('data-amount');
            const bExp = btn.getAttribute('data-expires');
            openQrModal(bId, bCode, bAmt, bExp);
        });
    });

    // Copy trong modal
    const setupCopy = (id, textFn) => {
        const el = document.getElementById(id);
        if (el) {
            el.addEventListener('click', () => {
                const text = textFn();
                if (text) {
                    navigator.clipboard.writeText(text);
                    const old = el.textContent;
                    el.textContent = '✓ Đã chép';
                    setTimeout(() => el.textContent = old, 2000);
                }
            });
        }
    };
    setupCopy('btn-modal-copy-acc', () => document.getElementById('modal-account-num')?.textContent?.trim() || '');
    setupCopy('btn-modal-copy-amount', () => Number(currentAmount).toString());
    setupCopy('btn-modal-copy-ref', () => 'STKT' + currentBookingCode);

    // Nút giả lập Dev
    if (modalDevBtn) {
        modalDevBtn.addEventListener('click', async () => {
            if (!currentBookingId) return;
            modalDevBtn.disabled = true;
            modalDevBtn.textContent = 'Đang kích hoạt vé mô phỏng...';
            try {
                const res = await fetch(`/account/bookings/${currentBookingId}/simulate-payment`, { method: 'POST' });
                if (res.ok) {
                    onPaymentSuccess();
                } else {
                    alert('Lỗi mô phỏng: ' + await res.text());
                    modalDevBtn.disabled = false;
                    modalDevBtn.textContent = '⚡ Giả lập thanh toán thành công (Môi trường Dev)';
                }
            } catch (err) {
                alert('Lỗi: ' + err);
                modalDevBtn.disabled = false;
                modalDevBtn.textContent = '⚡ Giả lập thanh toán thành công (Môi trường Dev)';
            }
        });
    }

    // Kết nối SignalR
    if (window.signalR) {
        try {
            signalRConn = new window.signalR.HubConnectionBuilder()
                .withUrl('/hubs/trip-seats')
                .withAutomaticReconnect()
                .build();
            signalRConn.on('PaymentSucceeded', (data) => {
                if (data && data.bookingId === currentBookingId) {
                    onPaymentSuccess();
                }
            });
            signalRConn.start().catch(e => console.warn("SignalR start error:", e));
        } catch (e) {
            console.warn("SignalR init error:", e);
        }
    }
})();
</script>

