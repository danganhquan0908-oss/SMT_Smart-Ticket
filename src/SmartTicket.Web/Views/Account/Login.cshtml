@model SmartTicket.Web.Models.LoginViewModel
@{ ViewData["Title"] = "Đăng nhập quản trị"; }
<section class="login-shell">
    <aside class="login-brand-panel">
        <div class="login-logo-frame"><img src="~/images/smart-ticket-smt-logo.png" alt="Logo Smart Ticket - SMT" asp-append-version="true" /></div>
        <p class="eyebrow" data-i18n="login_brand_eyebrow">SMART TICKET - SMT</p>
        <h2 data-i18n="login_brand_heading">Vạn dặm bình an,<br /><em>chọn chỗ dễ dàng.</em></h2>
        <p class="login-brand-copy" data-i18n="login_brand_copy">Một hành trình thuận tiện bắt đầu từ việc chọn đúng chuyến, đúng chỗ và đúng thời điểm.</p>
        <div class="login-brand-footer"><span data-i18n="login_brand_tagline">ĐẶT VÉ · CHỌN GHẾ · LÊN ĐƯỜNG</span><span class="login-foil-line"></span></div>
    </aside>
    <div class="login-card">
        <div class="login-mobile-brand"><img src="~/images/smart-ticket-smt-logo.png" alt="" asp-append-version="true" /><strong>Smart Ticket - SMT</strong></div>
        <p class="eyebrow" data-i18n="login_card_eyebrow">KHU VỰC QUẢN TRỊ</p>
        <h1 data-i18n="login_card_title">Chào mừng trở lại</h1>
        <p class="muted" data-i18n="login_card_subtitle">Đăng nhập bằng tài khoản Smart Ticket - SMT.</p>
        <form asp-action="Login" method="post" class="form-stack">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <label asp-for="Email" data-i18n="login_email_label">Email</label><input asp-for="Email" autocomplete="username" placeholder="name@company.vn" /><span asp-validation-for="Email" class="field-error"></span>
            <label asp-for="Password" data-i18n="login_password_label">Mật khẩu</label><input asp-for="Password" autocomplete="current-password" placeholder="Nhập mật khẩu" data-i18n-placeholder="login_password_placeholder" /><span asp-validation-for="Password" class="field-error"></span>
            <label class="remember-row"><input asp-for="RememberMe" /> <span data-i18n="login_remember_me">Ghi nhớ đăng nhập</span></label>
            <button class="button button-primary button-wide" type="submit"><span data-i18n="login_submit_btn">Đăng nhập hệ thống</span> <span aria-hidden="true">↗</span></button>

            <div class="demo-account-hint">
                <div class="demo-hint-title">⚡ Tài khoản mẫu kiểm thử phân quyền đa nhà xe:</div>
                <div class="demo-chip-grid">
                    <button type="button" class="button button-secondary demo-chip-btn" onclick="document.getElementById('Email').value='nhaxe@smartticket.vn'; document.getElementById('Password').value='SmartTicket@2026';">🏢 SMT Express</button>
                    <button type="button" class="button button-secondary demo-chip-btn" onclick="document.getElementById('Email').value='phuongtrang@smartticket.vn'; document.getElementById('Password').value='SmartTicket@2026';">🚌 Phương Trang (FUTA)</button>
                    <button type="button" class="button button-secondary demo-chip-btn" onclick="document.getElementById('Email').value='hoanglong@smartticket.vn'; document.getElementById('Password').value='SmartTicket@2026';">🚍 Hoàng Long</button>
                    <button type="button" class="button button-secondary demo-chip-btn" onclick="document.getElementById('Email').value='benxe@smartticket.vn'; document.getElementById('Password').value='SmartTicket@2026';">🏣 Bến xe (Kiểm soát)</button>
                    <button type="button" class="button button-secondary demo-chip-btn" onclick="document.getElementById('Email').value='khachhang@smartticket.vn'; document.getElementById('Password').value='SmartTicket@2026';">👤 Khách hàng (Demo)</button>
                </div>
            </div>
        </form>
        <p class="register-note"><span data-i18n="login_new_user">Bạn là hành khách mới?</span> <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" data-i18n="login_create_acc">Tạo tài khoản</a></p>
        <p class="register-note"><span data-i18n="login_partner_q">Bạn là nhà xe?</span> <a asp-controller="OperatorRegistration" asp-action="Register" data-i18n="login_partner_reg">Gửi hồ sơ đăng ký</a></p>
    </div>
</section>
