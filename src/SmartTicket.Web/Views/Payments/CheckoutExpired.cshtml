@{
    ViewData["Title"] = "Lượt giữ chỗ đã hết hạn - Smart Ticket";
}

<div class="checkout-expired-container">
    <div class="expired-card">
        <div class="expired-icon-circle">⏱️</div>
        <p class="eyebrow" style="color: #c81d4a;">HẾT THỜI GIAN GIỮ CHỖ</p>
        <h1>Lượt giữ ghế đã kết thúc</h1>
        <p class="expired-desc">
            @(ViewBag.Error ?? "Mỗi lượt giữ chỗ trên hệ thống Smart Ticket được tạm khóa trong 7 phút để bạn tiến hành quét mã VietQR. Sau thời gian này, hệ thống tự động giải phóng vị trí ghế để các hành khách khác có thể đặt chỗ.")
        </p>

        <div class="expired-help-box">
            <div class="help-item">
                <span class="help-num">1</span>
                <div>
                    <strong>Ghế đã được giải phóng</strong>
                    <p>Nếu bạn chưa kịp thanh toán, bạn chỉ cần chọn lại chuyến và ghế để thực hiện giao dịch mới.</p>
                </div>
            </div>
            <div class="help-item">
                <span class="help-num">2</span>
                <div>
                    <strong>Nếu bạn đã chuyển khoản thành công</strong>
                    <p>Hệ thống tự động đối soát dựa trên mã giao dịch. Vui lòng kiểm tra lại hộp thư email hoặc liên hệ tổng đài hỗ trợ <strong>1900 888 666</strong> để được trợ giúp ngay lập tức.</p>
                </div>
            </div>
        </div>

        <div class="expired-actions">
            <a class="button button-primary button-wide" asp-controller="Home" asp-action="Index">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                Tìm & Đặt chuyến xe mới
            </a>
            <a class="button button-outline button-wide" href="tel:1900888666">
                📞 Gọi Tổng đài Hỗ trợ 24/7 (1900 888 666)
            </a>
        </div>
    </div>
</div>

<style>
.checkout-expired-container {
    max-width: 620px; margin: 40px auto 80px; padding: 0 16px;
}
.expired-card {
    background: #fff; border-radius: 20px; border: 1px solid #eee9e6;
    box-shadow: 0 12px 36px rgba(26,22,43,0.06); padding: 40px 36px; text-align: center;
}
.expired-icon-circle {
    width: 68px; height: 68px; border-radius: 50%; background: #fff0f3; color: #c81d4a;
    display: grid; place-items: center; font-size: 32px; margin: 0 auto 18px;
}
.expired-card h1 {
    font-size: 26px; font-weight: 800; color: #1a162b; margin: 6px 0 12px;
}
.expired-desc {
    font-size: 13px; color: #777486; line-height: 1.6; margin: 0 0 24px;
}
.expired-help-box {
    background: #faf7f5; border: 1px solid #eee9e6; border-radius: 14px;
    padding: 20px; text-align: left; display: flex; flex-direction: column; gap: 14px; margin-bottom: 28px;
}
.help-item { display: flex; gap: 12px; align-items: flex-start; }
.help-num {
    width: 24px; height: 24px; border-radius: 50%; background: #5e17eb; color: #fff;
    display: grid; place-items: center; font-size: 11px; font-weight: 800; flex-shrink: 0; margin-top: 2px;
}
.help-item strong { font-size: 13px; color: #1a162b; display: block; margin-bottom: 2px; }
.help-item p { font-size: 11px; color: #777486; margin: 0; line-height: 1.5; }
.expired-actions { display: flex; flex-direction: column; gap: 10px; }
</style>
