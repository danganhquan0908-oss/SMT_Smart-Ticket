@model SmartTicket.Application.Payments.PaymentCheckoutDto
@{
    ViewData["Title"] = "Thanh toán VietQR - Smart Ticket";
    var qrBase64 = ViewBag.QrImage as string;
    var bankBin = ViewBag.BankBin as string ?? "";
    var accountNumber = ViewBag.AccountNumber as string ?? "";
    var accountName = ViewBag.AccountName as string ?? "";
    var amountFormatted = Model.Amount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    var vietQrImageUrl = $"https://img.vietqr.io/image/{bankBin}-{accountNumber}-compact2.png?amount={amountFormatted}&addInfo=STKT{Model.BookingCode}&accountName={Uri.EscapeDataString(accountName)}";
    var qrFallbackUrl = "https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=" + Uri.EscapeDataString(Model.QrPayload);

    var expiresUtc = DateTime.SpecifyKind(Model.ExpiresAtUtc, DateTimeKind.Utc);
    var secondsLeft = (int)(expiresUtc - DateTime.UtcNow).TotalSeconds;
    if (secondsLeft <= 0) secondsLeft = 420; // 7 phút an toàn
}

<div class="checkout-container">
    <div class="checkout-header text-center">
        <p class="eyebrow" data-i18n="checkout_eyebrow">BƯỚC 2 · THANH TOÁN TỰ ĐỘNG</p>
        <h1 class="checkout-title" data-i18n="checkout_title">Quét Mã VietQR Để Nhận Vé</h1>
        <p class="checkout-subtitle" data-i18n="checkout_subtitle">Mở ứng dụng Ngân hàng bất kỳ hoặc MoMo/VNPay để quét mã thanh toán 1-chạm</p>
    </div>

    <div class="checkout-card">
        <!-- CỘT TRÁI: MÃ QR ĐỘNG KHÓA CỨNG SỐ TIỀN -->
        <div class="qr-column">
            <div class="countdown-badge" id="countdown-wrap">
                <span class="timer-icon">⏱️</span>
                <span data-i18n="hold_temp">Giữ chỗ tạm thời:</span>
                <strong id="countdown">07:00</strong>
            </div>

            <div class="qr-frame-box" id="qr-wrap">
                <div class="qr-img-wrapper">
                    @if (!string.IsNullOrWhiteSpace(qrBase64))
                    {
                        <img id="payment-qr" alt="Mã thanh toán VietQR" src="data:image/png;base64,@qrBase64" onerror="this.onerror=null; this.src='@vietQrImageUrl';" />
                    }
                    else
                    {
                        <img id="payment-qr" alt="Mã thanh toán VietQR" src="@vietQrImageUrl" onerror="this.onerror=null; this.src='@qrFallbackUrl';" />
                    }
                    <div id="expired-overlay">
                        <div class="expired-icon">⚠️</div>
                        <h4 data-i18n="modal_expired_title">Mã QR đã hết hạn</h4>
                        <p data-i18n="modal_expired_desc">Thời gian giữ chỗ 7 phút đã kết thúc</p>
                        <a href="/" class="button button-primary" style="margin-top: 10px; font-size: 13px;" data-i18n="nav_home">Tìm chuyến mới</a>
                    </div>
                </div>

                <div class="qr-locked-tag">
                    <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
                    <span data-i18n="modal_lock_tag">Số tiền đã khóa cứng tự động (EMVCo Tag 54)</span>
                </div>
            </div>

            <p class="qr-help-text" data-i18n="qr_help_text">Không sửa đổi số tiền hoặc nội dung để vé được xuất tự động sau 3 giây.</p>
        </div>

        <!-- CỘT PHẢI: CHI TIẾT GIAO DỊCH & THAO TÁC -->
        <div class="details-column">
            <div class="payment-specs-card">
                <h3 data-i18n="passenger_info_title">Thông tin thanh toán</h3>
                
                <div class="spec-row">
                    <span class="spec-label" data-i18n="modal_bank_label">Ngân hàng thụ hưởng:</span>
                    <strong class="spec-value">@(ViewBag.BankName ?? "")</strong>
                </div>

                <div class="spec-row">
                    <span class="spec-label" data-i18n="modal_account_num_label">Số tài khoản:</span>
                    <div style="display:flex; align-items:center; gap:8px;">
                        <strong class="spec-value font-mono">@(ViewBag.AccountNumber ?? "")</strong>
                        <button type="button" class="btn-copy-chip" onclick="navigator.clipboard.writeText('@(ViewBag.AccountNumber ?? "")'); this.textContent=(window.SMT?window.SMT.t('btn_copied'):'✓ Đã chép'); setTimeout(()=>this.textContent=(window.SMT?window.SMT.t('btn_copy'):'Sao chép'), 2000);" data-i18n="btn_copy">Sao chép</button>
                    </div>
                </div>

                <div class="spec-row">
                    <span class="spec-label" data-i18n="modal_account_name_label">Tên người nhận:</span>
                    <strong class="spec-value">@(ViewBag.AccountName ?? "")</strong>
                </div>

                <div class="spec-row highlight-row">
                    <span class="spec-label" data-i18n="modal_ref_label">Nội dung chuyển khoản:</span>
                    <div style="display:flex; align-items:center; gap:8px;">
                        <strong class="spec-value font-mono text-plum">STKT@Model.BookingCode</strong>
                        <button type="button" class="btn-copy-chip" onclick="navigator.clipboard.writeText('STKT@Model.BookingCode'); this.textContent=(window.SMT?window.SMT.t('btn_copied'):'✓ Đã chép'); setTimeout(()=>this.textContent=(window.SMT?window.SMT.t('btn_copy'):'Sao chép'), 2000);" data-i18n="btn_copy">Sao chép</button>
                    </div>
                </div>

                <div class="spec-row total-row">
                    <span class="spec-label" data-i18n="modal_amount_label">Tổng tiền thanh toán:</span>
                    <div style="display:flex; align-items:center; gap:8px;">
                        <strong class="spec-value text-crimson font-large">@Model.Amount.ToString("N0") ₫</strong>
                        <button type="button" class="btn-copy-chip" onclick="navigator.clipboard.writeText('@Model.Amount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)'); this.textContent=(window.SMT?window.SMT.t('btn_copied'):'✓ Đã chép'); setTimeout(()=>this.textContent=(window.SMT?window.SMT.t('btn_copy'):'Sao chép'), 2000);" data-i18n="btn_copy">Sao chép</button>
                    </div>
                </div>
            </div>

            <div class="action-buttons-group">
                <a class="button button-deep-app @(string.IsNullOrWhiteSpace(ViewBag.BankAppDeepLink as string) ? "" : "")" 
                   id="bank-app" 
                   href="@(ViewBag.BankAppDeepLink ?? "#")" 
                   target="_blank">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                    <span data-i18n="btn_bank_app">Mở App Ngân Hàng (DeepLink)</span>
                </a>

                <a class="button button-outline" 
                   id="save-qr" 
                   href="@(string.IsNullOrWhiteSpace(qrBase64) ? qrFallbackUrl : "data:image/png;base64," + qrBase64)" 
                   download="SmartTicket-@(Model.BookingCode).png">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
                    <span data-i18n="btn_save_qr">Lưu mã QR về máy</span>
                </a>
            </div>

            @if (ViewBag.IsDev == true)
            {
                <button type="button" id="btn-dev-simulate" class="button button-dev-simulate" data-i18n="btn_dev_simulate">
                    ⚡ Giả lập thanh toán thành công (Môi trường Dev)
                </button>
            }

            <div class="payment-status-box" id="status-box">
                <div class="status-pulse-dot"></div>
                <div class="status-text-content">
                    <strong id="status-title" data-i18n="modal_waiting_title">Đang chờ ngân hàng xác nhận giao dịch...</strong>
                    <p id="status-desc" data-i18n="modal_waiting_desc">Hệ thống tự động đồng bộ và mở vé ngay sau khi bạn quét mã.</p>
                </div>
            </div>
                <div class="status-pulse-dot"></div>
                <div class="status-text-content">
                    <strong id="status-title">Đang chờ ngân hàng xác nhận giao dịch...</strong>
                    <p id="status-desc">Hệ thống tự động đồng bộ và mở vé ngay sau khi bạn quét mã.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
  .checkout-container {
    max-width: 980px;
    margin: 30px auto 60px;
    padding: 0 16px;
  }
  .checkout-header {
    margin-bottom: 28px;
  }
  .checkout-title {
    font-size: 32px;
    font-weight: 850;
    letter-spacing: -1.2px;
    color: var(--ink, #1a162b);
    margin: 6px 0;
  }
  .checkout-subtitle {
    color: var(--muted, #777486);
    font-size: 15px;
  }
  .checkout-card {
    background: rgba(255, 255, 255, 0.76);
    -webkit-backdrop-filter: blur(24px) saturate(190%);
    backdrop-filter: blur(24px) saturate(190%);
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.95), 0 20px 50px rgba(26, 22, 43, 0.1);
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 36px;
    padding: 36px;
    position: relative;
  }
  .qr-column {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .countdown-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 20px;
    background: linear-gradient(135deg, rgba(200, 29, 74, 0.12), rgba(247, 37, 133, 0.08));
    color: var(--crimson, #c81d4a);
    border-radius: 9999px;
    font-size: 13.5px;
    font-weight: 750;
    margin-bottom: 18px;
    border: 1px solid rgba(200, 29, 74, 0.35);
    box-shadow: 0 4px 14px rgba(200, 29, 74, 0.1);
  }
  .qr-frame-box {
    background: rgba(255, 255, 255, 0.92);
    border: 1.5px solid rgba(212, 175, 55, 0.7);
    box-shadow: 0 14px 34px rgba(140, 90, 54, 0.16), inset 0 1px 1px #fff;
    border-radius: 20px;
    padding: 16px;
    position: relative;
    width: 280px;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s;
  }
  .qr-frame-box:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 42px rgba(140, 90, 54, 0.22), inset 0 1px 1px #fff;
  }
  .qr-img-wrapper {
    position: relative;
    width: 248px;
    height: 248px;
    margin: 0 auto;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: #fff;
  }
  .qr-img-wrapper img {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 8px;
    object-fit: contain;
  }
  .qr-locked-tag {
    margin-top: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 800;
    color: #8c5a36;
    letter-spacing: 0.2px;
  }
  .qr-help-text {
    font-size: 12px;
    color: var(--muted, #777486);
    margin-top: 14px;
    max-width: 280px;
    line-height: 1.5;
  }
  #expired-overlay {
    display: none;
    position: absolute;
    inset: -10px;
    background: rgba(26, 22, 43, 0.92);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-radius: 16px;
    color: #fff;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
    z-index: 10;
  }
  .qr-frame-box.expired #expired-overlay {
    display: flex;
  }
  .payment-specs-card {
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border-radius: 18px;
    border: var(--glass-border);
    box-shadow: var(--glass-specular), var(--glass-shadow);
    padding: 22px;
    margin-bottom: 22px;
  }
  .payment-specs-card h3 {
    font-size: 16px;
    font-weight: 850;
    margin: 0 0 16px;
    color: var(--ink);
    border-bottom: 1px solid var(--line);
    padding-bottom: 10px;
    letter-spacing: -0.4px;
  }
  .spec-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    font-size: 13.5px;
  }
  .spec-label {
    color: var(--muted);
    font-weight: 600;
  }
  .spec-value {
    color: var(--ink);
    font-weight: 750;
  }
  .font-mono {
    font-family: monospace;
    letter-spacing: 0.5px;
  }
  .text-plum {
    color: var(--gold) !important;
  }
  .text-crimson {
    color: var(--gold) !important;
  }
  [data-theme="light"] .text-crimson {
    color: #8f551b !important;
  }
  .font-large {
    font-size: 24px !important;
    font-weight: 900;
    letter-spacing: -0.8px;
  }
  .highlight-row {
    background: rgba(229, 169, 80, 0.12);
    padding: 10px 14px;
    border-radius: 10px;
    border: 1.5px dashed rgba(229, 169, 80, 0.45);
    margin: 14px 0;
  }
  .total-row {
    border-top: 1px solid var(--line);
    padding-top: 14px;
    margin-top: 14px;
  }
  .action-buttons-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 22px;
  }
  .button-deep-app {
    background: var(--btn-primary-bg) !important;
    -webkit-backdrop-filter: blur(20px) saturate(190%) !important;
    backdrop-filter: blur(20px) saturate(190%) !important;
    color: var(--btn-primary-text) !important;
    padding: 13px !important;
    font-size: 14px !important;
    font-weight: 850 !important;
    border-radius: 14px !important;
    border: var(--btn-primary-border) !important;
    box-shadow: var(--btn-primary-glow) !important;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), filter 0.2s, box-shadow 0.2s;
  }
  .button-deep-app:hover {
    filter: brightness(1.15);
    transform: translateY(-2px);
    box-shadow: var(--btn-primary-hover-glow) !important;
    color: var(--btn-primary-text) !important;
  }
  .button-deep-app:active {
    transform: scale(0.97);
  }
  .payment-status-box {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-radius: 14px;
    border: var(--glass-border);
    box-shadow: var(--glass-specular), var(--glass-shadow);
  }
  .status-pulse-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.25);
    animation: pulse 1.6s infinite ease-in-out;
    flex-shrink: 0;
  }
  @@keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.5); }
    70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }
  .status-text-content strong {
    display: block;
    font-size: 13px;
    color: var(--ink, #1a162b);
    font-weight: 750;
  }
  .status-text-content p {
    font-size: 12px;
    color: var(--muted, #777486);
    margin: 2px 0 0;
  }
  .btn-copy-chip {
    background: #f1edff;
    border: 1px solid #dcd3f5;
    color: var(--plum, #5e17eb);
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-copy-chip:hover {
    background: var(--plum, #5e17eb);
    color: #fff;
  }
  .button-dev-simulate {
    background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
    color: #fff;
    border: none;
    padding: 10px 14px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);
    margin-bottom: 14px;
    width: 100%;
    transition: all 0.2s;
  }
  .button-dev-simulate:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(79, 70, 229, 0.35);
  }
  @@media (max-width: 820px) {
    .checkout-card {
      grid-template-columns: 1fr;
      padding: 24px;
    }
  }
</style>

<script>
(() => {
    let remainingSeconds = @secondsLeft;
    const token = '@Model.LookupToken';
    const qrBox = document.getElementById('qr-wrap');
    const bankAppBtn = document.getElementById('bank-app');
    const saveQrBtn = document.getElementById('save-qr');
    const countdownEl = document.getElementById('countdown');
    const statusTitle = document.getElementById('status-title');
    const statusDesc = document.getElementById('status-desc');
    const devSimulateBtn = document.getElementById('btn-dev-simulate');
    let isTerminated = false;

    if (devSimulateBtn) {
        devSimulateBtn.addEventListener('click', async () => {
            devSimulateBtn.disabled = true;
            devSimulateBtn.textContent = 'Đang kích hoạt vé mô phỏng...';
            try {
                const res = await fetch(`/api/payments/simulate-dev-success?token=${encodeURIComponent(token)}`, { method: 'POST' });
                if (res.ok) {
                    const data = await res.json();
                    statusTitle.textContent = "Thanh toán thành công!";
                    statusDesc.textContent = "Mô phỏng thành công. Đang chuyển tới vé điện tử...";
                    setTimeout(() => {
                        window.location.href = data.redirectUrl || `/tickets/lookup?token=${encodeURIComponent(token)}`;
                    }, 800);
                } else {
                    alert('Lỗi mô phỏng: ' + await res.text());
                    devSimulateBtn.disabled = false;
                    devSimulateBtn.textContent = '⚡ Giả lập thanh toán thành công (Môi trường Dev)';
                }
            } catch (err) {
                alert('Lỗi kết nối: ' + err);
                devSimulateBtn.disabled = false;
                devSimulateBtn.textContent = '⚡ Giả lập thanh toán thành công (Môi trường Dev)';
            }
        });
    }

    // Countdown logic
    const updateCountdown = () => {
        const mins = String(Math.floor(remainingSeconds / 60)).padStart(2, '0');
        const secs = String(remainingSeconds % 60).padStart(2, '0');
        countdownEl.textContent = `${mins}:${secs}`;

        if (remainingSeconds < 60) {
            countdownEl.style.color = '#c81d4a';
        }

        if (remainingSeconds <= 0) {
            clearInterval(timer);
            qrBox.classList.add('expired');
            bankAppBtn.classList.add('disabled');
            bankAppBtn.removeAttribute('href');
            saveQrBtn.removeAttribute('href');
            statusTitle.textContent = "Hết hạn giữ chỗ!";
            statusDesc.textContent = "Thời gian thanh toán 7 phút đã kết thúc. Vui lòng đặt lại ghế.";
            return;
        }
        remainingSeconds--;
    };
    updateCountdown();
    const timer = setInterval(updateCountdown, 1000);

    // Polling payment state
    const pollPaymentStatus = async () => {
        if (isTerminated) return;
        try {
            const res = await fetch(`/api/payments/state?token=${encodeURIComponent(token)}`);
            if (res.ok) {
                const data = await res.json();
                if (data.status === 'Succeeded' && data.ticketLookupUrl) {
                    clearInterval(timer);
                    isTerminated = true;
                    statusTitle.textContent = "Thanh toán thành công!";
                    statusDesc.textContent = "Ngân hàng đã xác nhận giao dịch. Đang chuyển tới vé điện tử...";
                    setTimeout(() => {
                        window.location.href = data.ticketLookupUrl;
                    }, 1200);
                } else if (data.status === 'OverdueUnassigned') {
                    isTerminated = true;
                    statusTitle.textContent = "Giao dịch thanh toán muộn";
                    statusDesc.textContent = "Ghế đã được cấp lại do hết hạn 7 phút. Tổng đài viên Smart Ticket sẽ liên hệ hỗ trợ đổi chuyến hoặc hoàn tiền 100%.";
                } else if (data.status === 'Failed') {
                    isTerminated = true;
                    statusTitle.textContent = "Thanh toán chưa thành công";
                    statusDesc.textContent = "Ngân hàng báo lỗi giao dịch. Vui lòng kiểm tra lại.";
                }
            }
        } catch (err) {
            console.error("Polling error:", err);
        }
    };
    setInterval(pollPaymentStatus, 2500);
})();
</script>
