@{
    ViewData["Title"] = "Chọn ghế - Smart Ticket";
    var tripId = (Guid)ViewBag.TripId;
    decimal ticketPrice = ViewBag.TicketPrice ?? 0m;
    string operatorName = ViewBag.OperatorName ?? "Nhà xe đối tác";
    string routeName = ViewBag.RouteName ?? "Lộ trình chuyến xe";
    string vehicleType = ViewBag.VehicleType ?? "Xe khách chất lượng cao";
    DateTime departureUtc = ViewBag.DepartureTimeUtc ?? DateTime.UtcNow;
    var departureLocal = departureUtc.AddHours(7); // Giờ Việt Nam chuẩn xác và an toàn trên Windows / Linux
}

<div class="seats-page-container">
    <!-- BANNER THÔNG TIN CHUYẾN XE -->
    <div class="trip-summary-banner">
        <div class="banner-main-info">
            <p class="eyebrow" data-i18n="step1_eyebrow">BƯỚC 1 · CHỌN VỊ TRÍ GHẾ</p>
            <h1 class="trip-route-title">@routeName</h1>
            <div class="trip-meta-tags">
                <span class="meta-tag operator-tag">🚌 @operatorName</span>
                <span class="meta-tag">🚐 @vehicleType</span>
                <span class="meta-tag time-tag">⏰ <span data-i18n="dep_time_label">Khởi hành</span>: <strong>@departureLocal.ToString("HH:mm - dd/MM/yyyy")</strong></span>
            </div>
        </div>

        <div class="banner-pricing">
            <span class="price-label" data-i18n="price_label">Giá vé niêm yết công khai</span>
            <div class="price-val">@ticketPrice.ToString("N0") <small data-i18n="per_seat">₫ / ghế</small></div>
            <div class="badge-lock-note" data-i18n="lock_note">⏱️ Giữ chỗ 7 phút khi xác nhận</div>
        </div>
    </div>

    <!-- KHU VỰC CHỌN GHẾ & FORM ĐẶT CHỖ -->
    <div class="seats-selection-grid">
        <!-- CỘT TRÁI: SƠ ĐỒ GHẾ 2 TẦNG -->
        <div class="map-column">
            <!-- CHÚ THÍCH TRẠNG THÁI (LEGEND) -->
            <div class="seat-legend-bar">
                <div class="legend-item"><span class="legend-swatch available"></span> <span data-i18n="legend_available">Ghế trống</span></div>
                <div class="legend-item"><span class="legend-swatch selected">✓</span> <span data-i18n="legend_selected">Đang chọn</span></div>
                <div class="legend-item"><span class="legend-swatch holding">🔒</span> <span data-i18n="legend_holding">Đang giữ (7p)</span></div>
                <div class="legend-item"><span class="legend-swatch booked">✕</span> <span data-i18n="legend_booked">Đã bán</span></div>
            </div>

            <!-- HAI TẦNG XE -->
            <div class="bus-decks-layout">
                <!-- TẦNG DƯỚI -->
                <div class="deck-card">
                    <div class="deck-header">
                        <span class="deck-name" data-i18n="deck_1_name">TẦNG DƯỚI (Dãy A)</span>
                        <div class="steering-icon" title="Đầu xe / Vị trí tài xế">
                            <svg width="22" height="22" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8 0-.46.04-.92.13-1.36 1.83.67 3.79 1.14 5.87 1.36v2h4v-2c2.08-.22 4.04-.69 5.87-1.36.09.44.13.9.13 1.36 0 4.41-3.59 8-8 8zm0-14c1.66 0 3 1.34 3 3 0 .4-.09.77-.24 1.11-1.35-.45-2.8-.75-4.34-.87-.27-.02-.55-.04-.82-.04-.27 0-.55.02-.82.04-1.54.12-2.99.42-4.34.87-.15-.34-.24-.71-.24-1.11 0-1.66 1.34-3 3-3z"/></svg>
                            <span data-i18n="steering_text">Vô lăng</span>
                        </div>
                    </div>
                    <div id="deck-1" class="seat-deck-grid"></div>
                </div>

                <!-- TẦNG TRÊN -->
                <div class="deck-card">
                    <div class="deck-header">
                        <span class="deck-name" data-i18n="deck_2_name">TẦNG TRÊN (Dãy B)</span>
                        <div class="deck-badge-sub" data-i18n="panoramic_view">Góc nhìn thoáng</div>
                    </div>
                    <div id="deck-2" class="seat-deck-grid"></div>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: FORM THÔNG TIN & TÍNH TIỀN THỜI GIAN THỰC -->
        <div class="booking-form-column">
            <div class="booking-box-card">
                <h3 data-i18n="passenger_info_title">Thông tin hành khách</h3>
                <p class="form-subtext" data-i18n="passenger_info_sub">Vui lòng điền đúng số điện thoại để nhận mã vé và liên hệ khi lên xe</p>

                <form id="hold-form">
                    <div class="form-group">
                        <label><span data-i18n="label_passenger_name">Họ và tên hành khách</span> <span class="required">*</span></label>
                        <input name="passengerName" type="text" class="form-input" data-i18n-placeholder="placeholder_passenger_name" placeholder="Ví dụ: Nguyễn Văn A" maxlength="160" required />
                    </div>

                    <div class="form-group">
                        <label><span data-i18n="label_passenger_phone">Số điện thoại liên hệ</span> <span class="required">*</span></label>
                        <input name="passengerPhone" type="tel" class="form-input" data-i18n-placeholder="placeholder_passenger_phone" placeholder="Ví dụ: 0912 345 678" maxlength="24" required />
                    </div>

                    <div class="form-group">
                        <label data-i18n="label_passenger_email">Email (Nhận vé điện tử)</label>
                        <input name="passengerEmail" type="email" class="form-input" data-i18n-placeholder="placeholder_passenger_email" placeholder="ten@email.com (không bắt buộc)" maxlength="254" />
                    </div>

                    <!-- TÓM TẮT CHỌN GHẾ & GIÁ TIỀN -->
                    <div class="selection-summary-panel">
                        <div class="summary-line">
                            <span class="sum-label" data-i18n="sum_selected_seats">Ghế đã chọn:</span>
                            <strong class="sum-value" id="selected-seats-badge">Chưa chọn ghế</strong>
                        </div>

                        <div class="summary-line">
                            <span class="sum-label" data-i18n="sum_ticket_count">Số lượng vé:</span>
                            <strong class="sum-value" id="selected-count-badge">0 vé</strong>
                        </div>

                        <div class="summary-line total-line">
                            <span class="sum-label" data-i18n="sum_total_price">Tổng tiền:</span>
                            <strong class="sum-value total-price-val" id="total-price-display">0 ₫</strong>
                        </div>
                    </div>

                    <div id="hold-message" class="alert-message" style="display: none;"></div>

                    <button class="button-pay-submit btn-dimmed" id="btn-submit-hold" type="submit">
                        <span data-i18n="btn_hold_submit">Tiến hành giữ chỗ & Thanh toán QR</span>
                        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL VIETQR POPUP TRỰC TIẾP TRÊN TRANG (FROSTED GLASS IPHONE STYLE) -->
    <div id="qr-modal-backdrop" class="qr-modal-backdrop" style="display: none;">
        <div class="qr-modal-card">
            <button type="button" class="btn-close-modal" id="btn-close-modal" title="Đóng cửa sổ">✕</button>
            
            <div class="modal-header">
                <div class="modal-badge-row">
                    <span class="badge-vietqr-brand" data-i18n="modal_brand_tag">⚡ VietQR · Napas 247 · VietinBank</span>
                    <span class="badge-modal-timer" id="modal-countdown-badge">⏱️ 07:00</span>
                </div>
                <h2 class="modal-title" data-i18n="modal_title">Quét Mã VietQR Nhận Vé Ngay</h2>
                <p class="modal-subtitle" data-i18n="modal_subtitle">Mở ứng dụng Ngân hàng bất kỳ hoặc MoMo/VNPay để quét mã thanh toán 1-chạm</p>
            </div>

            <div class="modal-body-layout">
                <!-- Cột trái: QR Code -->
                <div class="modal-qr-column">
                    <div class="modal-qr-frame" id="modal-qr-frame">
                        <img id="modal-qr-image" src="" alt="Mã VietQR" />
                        <div id="modal-qr-overlay-expired" class="modal-expired-overlay" style="display: none;">
                            <span class="expired-icon">⚠️</span>
                            <h4 data-i18n="modal_expired_title">Hết hạn giữ chỗ 7 phút</h4>
                            <p data-i18n="modal_expired_desc">Vui lòng đóng và chọn lại ghế</p>
                        </div>
                    </div>
                    <div class="modal-lock-tag">
                        <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
                        <span data-i18n="modal_lock_tag">Số tiền đã khóa cứng (EMVCo Tag 54)</span>
                    </div>
                </div>

                <!-- Cột phải: Thông tin chuyển khoản -->
                <div class="modal-info-column">
                    <div class="modal-specs-box">
                        <div class="modal-spec-row">
                            <span class="m-label" data-i18n="modal_bank_label">Ngân hàng thụ hưởng:</span>
                            <strong class="m-val">@(ViewBag.BankName ?? "VietinBank (Napas 247)")</strong>
                        </div>
                        <div class="modal-spec-row">
                            <span class="m-label" data-i18n="modal_account_num_label">Số tài khoản:</span>
                            <div class="m-val-wrap">
                                <strong class="m-val font-mono">@(ViewBag.AccountNumber ?? "")</strong>
                                <button type="button" class="btn-copy-chip" onclick="navigator.clipboard.writeText('@(ViewBag.AccountNumber ?? "")'); this.textContent=(window.SMT?window.SMT.t('btn_copied'):'✓ Đã chép'); setTimeout(()=>this.textContent=(window.SMT?window.SMT.t('btn_copy'):'Sao chép'), 2000);" data-i18n="btn_copy">Sao chép</button>
                            </div>
                        </div>
                        <div class="modal-spec-row">
                            <span class="m-label" data-i18n="modal_account_name_label">Chủ tài khoản:</span>
                            <strong class="m-val">@(ViewBag.AccountName ?? "")</strong>
                        </div>
                        <div class="modal-spec-row">
                            <span class="m-label" data-i18n="modal_amount_label">Số tiền:</span>
                            <div class="m-val-wrap">
                                <strong class="m-val text-crimson font-large" id="modal-amount-display">0 ₫</strong>
                                <button type="button" class="btn-copy-chip" id="btn-modal-copy-amount" data-i18n="btn_copy">Sao chép</button>
                            </div>
                        </div>
                        <div class="modal-spec-row highlight-spec">
                            <span class="m-label" data-i18n="modal_ref_label">Nội dung CK:</span>
                            <div class="m-val-wrap">
                                <strong class="m-val font-mono text-plum" id="modal-ref-display">STKT...</strong>
                                <button type="button" class="btn-copy-chip" id="btn-modal-copy-ref" data-i18n="btn_copy">Sao chép</button>
                            </div>
                        </div>
                    </div>

                    <div class="modal-status-badge" id="modal-status-box">
                        <div class="status-pulse-dot"></div>
                        <div class="status-text-content">
                            <strong id="modal-status-title" data-i18n="modal_waiting_title">Đang chờ bạn quét mã thanh toán...</strong>
                            <p id="modal-status-desc" data-i18n="modal_waiting_desc">Hệ thống tự động kích hoạt vé ngay khi giao dịch thành công.</p>
                        </div>
                    </div>

                    <div class="modal-actions-col">
                        <a href="#" target="_blank" id="modal-checkout-link" class="btn-modal-checkout" data-i18n="btn_open_checkout">
                            Mở trang thanh toán riêng biệt ↗
                        </a>
                        @if (ViewBag.IsDev == true)
                        {
                            <button type="button" id="btn-modal-dev-simulate" class="btn-modal-dev" data-i18n="btn_dev_simulate">
                                ⚡ Giả lập thanh toán thành công (Môi trường Dev)
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
  .seats-page-container {
    max-width: 1140px;
    margin: 24px auto 60px;
    padding: 0 16px;
  }
  .trip-summary-banner {
    background: radial-gradient(circle at 85% 15%, rgba(229, 169, 80, 0.35), transparent 45%),
                radial-gradient(circle at 15% 85%, rgba(184, 123, 51, 0.3), transparent 50%),
                linear-gradient(135deg, #181109 0%, #24170d 55%, #382414 100%);
    border-radius: 24px;
    color: #fff;
    padding: 30px 38px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45), inset 0 1px 1px rgba(247, 213, 148, 0.3);
    border: 1px solid rgba(229, 169, 80, 0.45);
    margin-bottom: 28px;
    gap: 20px;
  }
  .trip-route-title {
    font-size: 26px;
    font-weight: 800;
    margin: 4px 0 10px;
    color: #fff;
    letter-spacing: -0.5px;
  }
  .trip-meta-tags {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .meta-tag {
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(4px);
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 600;
    color: #fff;
  }
  .operator-tag {
    background: rgba(229, 169, 80, 0.3);
    border: 1px solid rgba(229, 169, 80, 0.6);
  }
  .banner-pricing {
    text-align: right;
    min-width: 220px;
  }
  .price-label {
    font-size: 12px;
    color: #f7d594;
    display: block;
  }
  .price-val {
    font-size: 30px;
    font-weight: 900;
    color: #fce4b8;
    line-height: 1.1;
    margin: 4px 0;
  }
  .price-val small {
    font-size: 14px;
    font-weight: 600;
    color: #f7d594;
  }
  .badge-lock-note {
    font-size: 11.5px;
    color: #e5a950;
    font-weight: 700;
  }
  .seats-selection-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 28px;
    align-items: start;
  }
  .seat-legend-bar {
    display: flex;
    justify-content: space-around;
    background: var(--glass-bg);
    border-radius: 12px;
    padding: 12px 18px;
    margin-bottom: 20px;
    border: var(--glass-border);
    box-shadow: var(--glass-shadow);
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
  }
  .legend-swatch {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    display: inline-grid;
    place-items: center;
    font-size: 10px;
    font-weight: 800;
  }
  .legend-swatch.available { background: var(--glass-bg-solid); border: 1.5px solid var(--line); color: var(--ink); }
  .legend-swatch.selected { background: linear-gradient(135deg, #e5a950, #b87b33); color: #0b0805; }
  .legend-swatch.holding { background: #f59e0b; color: #fff; }
  .legend-swatch.booked { background: #cbd5e1; color: #64748b; }

  .bus-decks-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .deck-card {
    background: var(--glass-bg);
    border-radius: 16px;
    border: var(--glass-border);
    padding: 20px;
    box-shadow: var(--glass-shadow);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
  }
  .deck-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1.5px solid var(--line);
    padding-bottom: 12px;
    margin-bottom: 18px;
  }
  .deck-name {
    font-size: 15px;
    font-weight: 800;
    color: var(--gold);
  }
  .steering-icon {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    color: var(--muted);
    font-weight: 700;
  }
  .deck-badge-sub {
    font-size: 11px;
    background: var(--soft);
    color: var(--gold);
    border: 1px solid var(--line);
    padding: 3px 8px;
    border-radius: 9999px;
    font-weight: 700;
  }
  .seat-deck-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    min-height: 220px;
  }
  .btn-seat {
    height: 52px;
    border-radius: 10px;
    border: 1.5px solid var(--line);
    background: var(--glass-bg-solid);
    color: var(--ink);
    font-weight: 800;
    font-size: 13.5px;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .btn-seat:hover:not(:disabled) {
    border-color: var(--gold);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(229, 169, 80, 0.25);
  }
  .btn-seat.selected {
    background: linear-gradient(135deg, #e5a950 0%, #b87b33 100%) !important;
    border-color: #fce4b8 !important;
    color: #0b0805 !important;
    font-weight: 850 !important;
    box-shadow: 0 6px 16px rgba(229, 169, 80, 0.4) !important;
  }
  .btn-seat.holding {
    background: #fef3c7 !important;
    border-color: #f59e0b !important;
    color: #b45309 !important;
    cursor: not-allowed;
  }
  .btn-seat.booked {
    background: #e2e8f0 !important;
    border-color: #cbd5e1 !important;
    color: #94a3b8 !important;
    cursor: not-allowed;
    text-decoration: line-through;
  }

  /* FORM STYLING */
  .booking-box-card {
    background: var(--glass-bg);
    border-radius: 18px;
    border: var(--glass-border);
    padding: 26px;
    box-shadow: var(--glass-shadow);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
  }
  .booking-box-card h3 {
    font-size: 18px;
    font-weight: 800;
    margin: 0 0 4px;
    color: var(--ink);
  }
  .form-subtext {
    font-size: 12.5px;
    color: var(--muted);
    margin-bottom: 20px;
  }
  .form-group {
    margin-bottom: 16px;
  }
  .form-group label {
    display: block;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 6px;
  }
  .required {
    color: var(--crimson);
  }
  .form-input {
    width: 100%;
    height: 44px;
    border: 1.5px solid var(--line);
    border-radius: 9px;
    padding: 0 14px;
    font-size: 14px;
    outline: none;
    box-sizing: border-box;
    transition: all 0.2s;
    background: var(--glass-bg-solid);
    color: var(--ink);
  }
  .form-input:focus {
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(229, 169, 80, 0.2);
  }
  .selection-summary-panel {
    background: var(--soft);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 16px;
    margin: 20px 0;
  }
  .summary-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    font-size: 13.5px;
    color: var(--ink);
  }
  .total-line {
    border-top: 1px solid var(--line);
    padding-top: 10px;
    margin-top: 10px;
    margin-bottom: 0;
  }
  .total-price-val {
    font-size: 22px !important;
    font-weight: 900 !important;
    color: var(--gold) !important;
  }
  [data-theme="light"] .total-price-val {
    color: #8f551b !important;
  }
  .button-pay-submit {
    width: 100%;
    background: var(--btn-primary-bg) !important;
    -webkit-backdrop-filter: blur(20px) saturate(190%) !important;
    backdrop-filter: blur(20px) saturate(190%) !important;
    color: var(--btn-primary-text) !important;
    border: var(--btn-primary-border) !important;
    padding: 14px;
    border-radius: 14px;
    font-size: 15px;
    font-weight: 850;
    cursor: pointer;
    box-shadow: var(--btn-primary-glow) !important;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s, filter 0.2s !important;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .button-pay-submit:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: var(--btn-primary-hover-glow) !important;
    filter: brightness(1.15);
    color: var(--btn-primary-text) !important;
  }
  .button-pay-submit:active:not(:disabled) {
    transform: scale(0.97);
  }
  .button-pay-submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    box-shadow: none;
  }
  .button-pay-submit.btn-dimmed {
    opacity: 0.82;
  }
  .alert-message {
    padding: 10px 14px;
    background: #fff0f2;
    border: 1px solid #f5d4dc;
    color: #a81239;
    border-radius: 8px;
    font-size: 12.5px;
    font-weight: 600;
    margin-bottom: 14px;
  }
  .btn-copy-chip {
    background: var(--pill-bg);
    border: 1.5px solid var(--pill-border);
    color: var(--ink);
    padding: 3px 10px;
    border-radius: 8px;
    font-size: 11.5px;
