    border-radius: 18px;
    padding: 10px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4), 0 0 20px rgba(229, 169, 80, 0.2);
    position: relative;
    width: 220px;
    height: 220px;
    display: flex;
