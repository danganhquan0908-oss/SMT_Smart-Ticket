  .btn-modal-dev {
    background: rgba(229, 169, 80, 0.12);
    color: var(--gold-light);
    border: 1px solid rgba(229, 169, 80, 0.35);
    padding: 9px;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 700;
