@model SmartTicket.Application.Catalog.SaveBusRouteRequest
@{
    var isEdit = ViewData["RouteId"] is not null;
    ViewData["Title"] = isEdit ? "Cập nhật tuyến đường - Smart Ticket" : "Tạo tuyến đường mới - Smart Ticket";
}

<div class="route-edit-container">
    <div class="page-heading">
        <div>
            <p class="eyebrow">DANH MỤC HẠ TẦNG · EPIC 1</p>
            <h1>@(isEdit ? "Cập nhật tuyến đường" : "Tạo tuyến đường vận tải mới")</h1>
            <p>Chọn hai bến xe đang hoạt động để liên kết thành lộ trình vận chuyển hành khách liên tỉnh.</p>
        </div>
        <a class="button button-outline" asp-action="Index">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            Quay lại danh sách
        </a>
    </div>

    <div class="form-card">
        <form method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@ViewData["RouteId"]">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-grid">
                <!-- BẾN ĐI -->
                <div class="field">
                    <label asp-for="DepartureStationId">Bến xe khởi hành (Điểm đi) <span class="required">*</span></label>
                    <select asp-for="DepartureStationId" asp-items="ViewBag.Stations" class="form-select" required>
                        <option value="">-- Chọn bến xe xuất phát --</option>
                    </select>
                    <span asp-validation-for="DepartureStationId" class="field-error"></span>
                    <small class="field-help">Chỉ các bến xe đang hoạt động mới có thể chọn.</small>
                </div>

                <!-- BẾN ĐẾN -->
                <div class="field">
                    <label asp-for="ArrivalStationId">Bến xe kết thúc (Điểm đến) <span class="required">*</span></label>
                    <select asp-for="ArrivalStationId" asp-items="ViewBag.Stations" class="form-select" required>
                        <option value="">-- Chọn bến xe đích đến --</option>
                    </select>
                    <span asp-validation-for="ArrivalStationId" class="field-error"></span>
                    <small class="field-help">Bến đến phải khác hoàn toàn với bến khởi hành.</small>
                </div>

                <!-- CỰ LY KM -->
                <div class="field">
                    <label asp-for="DistanceKm">Khoảng cách lộ trình (km) <span class="required">*</span></label>
                    <div class="input-currency-wrapper">
                        <input asp-for="DistanceKm" type="number" min="0.1" step="0.1" class="form-input" placeholder="Ví dụ: 305" required />
                        <span class="currency-tag">km</span>
                    </div>
                    <span asp-validation-for="DistanceKm" class="field-error"></span>
                </div>

                <!-- THỜI LƯỢNG ƯỚC TÍNH -->
                <div class="field">
                    <label asp-for="EstimatedHours">Thời lượng di chuyển ước tính (giờ) <span class="required">*</span></label>
                    <div class="input-currency-wrapper">
                        <input asp-for="EstimatedHours" type="number" min="1" max="100" class="form-input" placeholder="Ví dụ: 6" required />
                        <span class="currency-tag">tiếng</span>
                    </div>
                    <span asp-validation-for="EstimatedHours" class="field-error"></span>
                </div>
            </div>

            <div class="notice-box-info" style="margin-top: 18px;">
                <span class="info-icon">ℹ️</span>
                <span><strong>Ràng buộc toàn vẹn:</strong> Hệ thống áp dụng ràng buộc duy nhất `UNIQUE(Bến đi, Bến đến)` trên cơ sở dữ liệu PostgreSQL. Nếu tuyến theo chiều ngược lại (Bến đến $\rightarrow$ Bến đi) cần khai thác, vui lòng tạo thêm một tuyến đường độc lập mới.</span>
            </div>

            <div class="form-footer">
                <a asp-action="Index" class="button button-outline">Hủy bỏ</a>
                <button type="submit" class="button button-primary" style="padding-inline: 24px;">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>
                    @(isEdit ? "Lưu thay đổi tuyến đường" : "Tạo tuyến đường mới")
                </button>
            </div>
        </form>
    </div>
</div>

<style>
  .route-edit-container {
    max-width: 820px;
    margin: 20px auto 50px;
  }
</style>
