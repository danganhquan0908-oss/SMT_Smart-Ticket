@model IReadOnlyList<SmartTicket.Application.Operators.OperatorApplicationDto>
@using SmartTicket.Domain.Entities
@{
    ViewData["Title"] = "Thẩm định & Quản lý Nhà xe - Smart Ticket";
    var pendingCount = Model.Count(x => x.Status == OperatorStatus.PendingVerification);
    var activeCount = Model.Count(x => x.Status == OperatorStatus.Active);
    var rejectedCount = Model.Count(x => x.Status == OperatorStatus.Rejected);
}

<div class="admin-operators-page">
    <div class="page-heading">
        <div>
            <p class="eyebrow">QUẢN TRỊ HỆ THỐNG · ĐỐI TÁC</p>
            <h1>Thẩm định & Quản lý Nhà xe</h1>
            <p>Kiểm tra tính pháp lý của giấy phép kinh doanh, duyệt hồ sơ và giám sát trạng thái kích hoạt tài khoản nhà xe.</p>
        </div>
        <div class="heading-actions">
            <span class="live-label"><i></i> Hệ thống sẵn sàng</span>
        </div>
    </div>

    @await Html.PartialAsync("_Feedback")

    <!-- METRICS CARDS -->
    <div class="admin-stats-grid">
        <div class="stat-card" data-filter="all" onclick="setFilter('all')">
            <div class="stat-icon total">🏢</div>
            <div class="stat-body">
                <span class="stat-label">Tổng hồ sơ đăng ký</span>
                <strong class="stat-value">@Model.Count</strong>
            </div>
            <div class="stat-badge">Toàn bộ</div>
        </div>

        <div class="stat-card pending" data-filter="pending" onclick="setFilter('pending')">
            <div class="stat-icon pending">⏳</div>
            <div class="stat-body">
                <span class="stat-label">Chờ thẩm định</span>
                <strong class="stat-value text-amber">@pendingCount</strong>
            </div>
            <div class="stat-badge warning">Cần xử lý</div>
        </div>

        <div class="stat-card active" data-filter="active" onclick="setFilter('active')">
            <div class="stat-icon active">✓</div>
            <div class="stat-body">
                <span class="stat-label">Đang hoạt động</span>
                <strong class="stat-value text-emerald">@activeCount</strong>
            </div>
            <div class="stat-badge success">Đã kích hoạt</div>
        </div>

        <div class="stat-card rejected" data-filter="rejected" onclick="setFilter('rejected')">
            <div class="stat-icon rejected">✕</div>
            <div class="stat-body">
                <span class="stat-label">Đã từ chối</span>
                <strong class="stat-value text-rose">@rejectedCount</strong>
            </div>
            <div class="stat-badge danger">Không đạt</div>
        </div>
    </div>

    <!-- TABLE CARD -->
    <div class="table-card" style="margin-top: 24px;">
        <div class="table-toolbar">
            <div class="toolbar-left">
                <strong>Danh sách đối tác vận tải</strong>
                <span id="recordCountLabel">(@Model.Count hồ sơ đăng ký)</span>
            </div>

            <!-- SEARCH & TABS -->
            <div class="toolbar-right">
                <div class="filter-tabs">
                    <button type="button" class="tab-btn active" onclick="setFilter('all')">Tất cả (@Model.Count)</button>
                    <button type="button" class="tab-btn" onclick="setFilter('pending')">Chờ duyệt (@pendingCount)</button>
                    <button type="button" class="tab-btn" onclick="setFilter('active')">Hoạt động (@activeCount)</button>
                    <button type="button" class="tab-btn" onclick="setFilter('rejected')">Từ chối (@rejectedCount)</button>
                </div>
                <div class="search-input-wrap">
                    <input type="text" id="searchInput" placeholder="Tìm tên nhà xe, MST, email..." oninput="handleSearch()" />
                </div>
            </div>
        </div>

        <div class="table-scroll">
            <table id="operatorsTable">
                <thead>
                    <tr>
                        <th>Doanh nghiệp & Ngày nộp</th>
                        <th>Mã số thuế & Hotline</th>
                        <th>Email đại diện</th>
                        <th>Giấy phép KD</th>
                        <th>Trạng thái</th>
                        <th class="actions-col">Thao tác thẩm định</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var statusClass = item.Status switch
                        {
                            OperatorStatus.Active => "status-active",
                            OperatorStatus.PendingVerification => "status-pending",
                            _ => "status-inactive"
                        };
                        var statusFilterValue = item.Status switch
                        {
                            OperatorStatus.Active => "active",
                            OperatorStatus.PendingVerification => "pending",
                            _ => "rejected"
                        };
                        var submittedLocal = item.SubmittedAtUtc.AddHours(7); // Giờ Việt Nam

                        <tr class="operator-row" data-status="@statusFilterValue" data-keywords="@item.CompanyName.ToLower() @item.TaxCode.ToLower() @item.Email.ToLower() @item.Hotline.ToLower()">
                            <td class="primary-cell">
                                <div class="company-name-bold">@item.CompanyName</div>
                                <small class="date-sub">Nộp lúc: @submittedLocal.ToString("dd/MM/yyyy HH:mm")</small>
                            </td>
                            <td>
                                <div class="tax-code-badge">MST: <strong>@item.TaxCode</strong></div>
                                <div class="hotline-sub">
                                    <a href="tel:@item.Hotline" class="hotline-link">📞 @item.Hotline</a>
                                </div>
                            </td>
                            <td>
                                <span class="email-badge">@item.Email</span>
                            </td>
                            <td>
                                <a asp-action="License" asp-route-id="@item.Id" target="_blank" class="license-view-btn" title="Mở file giấy phép kinh doanh">
                                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>
                                    Xem giấy phép ↗
                                </a>
                            </td>
                            <td>
                                <span class="status @statusClass">
                                    @if (item.Status == OperatorStatus.Active)
                                    {
                                        <span>✓ Đã kích hoạt</span>
                                    }
                                    else if (item.Status == OperatorStatus.PendingVerification)
                                    {
                                        <span>⏳ Chờ thẩm định</span>
                                    }
                                    else
                                    {
                                        <span>✕ Đã từ chối</span>
                                    }
                                </span>
                                @if (!string.IsNullOrWhiteSpace(item.ReviewNote))
                                {
                                    <div class="review-note-box" title="Ghi chú thẩm định">
                                        <svg width="12" height="12" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
                                        <span>@item.ReviewNote</span>
                                    </div>
                                }
                            </td>
                            <td class="actions-col">
                                <div class="row-actions">
                                    @if (item.Status == OperatorStatus.PendingVerification)
                                    {
                                        <!-- DUYỆT HỒ SƠ -->
                                        <form asp-action="Approve" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Xác nhận phê duyệt hồ sơ nhà xe @item.CompanyName? Email kích hoạt tài khoản sẽ được gửi tự động.')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="action-btn approve-btn" title="Duyệt hồ sơ và gửi link kích hoạt">
                                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>
                                                Duyệt
                                            </button>
                                        </form>

                                        <!-- TỪ CHỐI HỒ SƠ -->
                                        <button type="button" class="action-btn reject-btn" onclick="openRejectModal('@item.Id', '@item.CompanyName')" title="Từ chối hồ sơ kèm lý do">
                                            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12"/></svg>
                                            Từ chối
                                        </button>
                                    }
                                    else if (item.Status == OperatorStatus.Active)
                                    {
                                        <form asp-action="ResendActivation" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Gửi lại email liên kết kích hoạt đến @item.Email?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="action-btn resend-btn" title="Gửi lại liên kết kích hoạt">
                                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                                                Gửi lại kích hoạt
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="muted-small">Hồ sơ lưu trữ</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }

                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="empty-state">
                                <div class="empty-symbol">📂</div>
                                <strong>Chưa có hồ sơ nhà xe nào</strong>
                                <p>Các đơn đăng ký của nhà xe sẽ xuất hiện tại đây để đội ngũ quản trị thẩm định.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL TỪ CHỐI HỒ SƠ -->
<div id="rejectModal" class="reject-modal-backdrop" style="display:none;">
    <div class="reject-modal-card">
        <div class="modal-header">
            <h3>Từ chối hồ sơ đăng ký</h3>
            <button type="button" class="close-btn" onclick="closeRejectModal()">&times;</button>
        </div>
        <form id="rejectForm" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <p>Bạn đang từ chối hồ sơ nhà xe: <strong id="rejectCompanyName" style="color: #c81d4a;"></strong></p>
                <div class="field" style="margin-top: 12px;">
                    <label for="rejectNoteInput">Lý do từ chối thẩm định <span class="required">*</span></label>
                    <textarea name="note" id="rejectNoteInput" rows="3" class="form-input" style="height: auto; padding: 10px;" required placeholder="Ví dụ: Giấy phép kinh doanh không khớp thông tin MST, hoặc tệp đính kèm bị mờ không đọc được..."></textarea>
                    <small class="field-help">Lý do này sẽ được ghi nhận vào lịch sử hồ sơ để nhà xe nắm được.</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="button button-outline" onclick="closeRejectModal()">Hủy bỏ</button>
                <button type="submit" class="button button-primary" style="background:#c81d4a;">Xác nhận từ chối</button>
            </div>
        </form>
    </div>
</div>

<style>
.admin-operators-page { max-width: 1280px; margin: 0 auto; }
.admin-stats-grid {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: 18px;
}
.stat-card {
    background: rgba(255, 255, 255, 0.74);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 20px;
    padding: 20px 22px; display: flex; align-items: center; gap: 14px;
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.95), 0 8px 24px rgba(26, 22, 43, 0.05);
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s, border-color 0.2s;
}
.stat-card:hover {
    transform: translateY(-3px);
    background: rgba(255, 255, 255, 0.9);
    border-color: rgba(94, 23, 235, 0.4);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.95), 0 14px 34px rgba(26, 22, 43, 0.09);
}
.stat-icon {
    width: 48px; height: 48px; border-radius: 14px; display: grid; place-items: center;
    font-size: 20px; flex-shrink: 0;
}
.stat-icon.total { background: #f2edff; color: #5e17eb; }
.stat-icon.pending { background: #fff8e6; color: #b78103; }
.stat-icon.active { background: #eaf8f2; color: #16825d; }
.stat-icon.rejected { background: #fff0f3; color: #c81d4a; }

.stat-body { display: flex; flex-direction: column; gap: 2px; flex: 1; }
.stat-label { font-size: 11px; font-weight: 700; color: #777486; }
.stat-value { font-size: 26px; font-weight: 800; font-family: 'Plus Jakarta Sans', sans-serif; color: #1a162b; }
.text-amber { color: #b78103; }
.text-emerald { color: #16825d; }
.text-rose { color: #c81d4a; }

.stat-badge {
    font-size: 9px; font-weight: 800; padding: 4px 8px; border-radius: 20px;
    background: #f2edff; color: #5e17eb; white-space: nowrap;
}
.stat-badge.warning { background: #fff3d9; color: #946300; }
.stat-badge.success { background: #e9f8f1; color: #14724f; }
.stat-badge.danger { background: #fff0f3; color: #c81d4a; }

.toolbar-left strong { font-size: 14px; color: #1a162b; }
.toolbar-left span { font-size: 11px; color: #777486; margin-left: 6px; }
.toolbar-right { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }

.filter-tabs {
    display: flex; background: rgba(255, 255, 255, 0.6); padding: 4px; border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.85); box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.8);
}
.tab-btn {
    border: none; background: transparent; padding: 6px 14px; font-size: 11.5px;
    font-weight: 750; color: #777486; border-radius: 8px; cursor: pointer; transition: 0.15s;
}
.tab-btn.active { background: #fff; color: #5e17eb; box-shadow: 0 2px 8px rgba(94, 23, 235, 0.12); font-weight: 800; }
.search-input-wrap input {
    height: 36px; padding: 0 12px; border: 1px solid #e2dce4; border-radius: 8px;
    font-size: 12px; min-width: 220px; outline: none;
}
.search-input-wrap input:focus { border-color: #5e17eb; box-shadow: 0 0 0 3px rgba(94,23,235,0.1); }

.company-name-bold { font-weight: 800; color: #1a162b; font-size: 13px; }
.date-sub { font-size: 10px; color: #777486; display: block; margin-top: 2px; }
.tax-code-badge { font-size: 11px; color: #5e17eb; background: #f2edff; padding: 2px 7px; border-radius: 5px; display: inline-block; font-weight: 600; }
.hotline-sub { margin-top: 4px; }
.hotline-link { font-size: 11px; color: #777486; text-decoration: none; }
.hotline-link:hover { color: #c81d4a; }
.email-badge { font-size: 12px; color: #1a162b; font-weight: 600; }

.license-view-btn {
    display: inline-flex; align-items: center; gap: 5px; padding: 5px 10px;
    background: #faf7f5; border: 1px solid #d9d0e2; border-radius: 7px;
    font-size: 11px; font-weight: 700; color: #5e17eb; text-decoration: none; transition: 0.15s;
}
.license-view-btn:hover { background: #f2edff; border-color: #5e17eb; color: #5e17eb; }

.review-note-box {
    display: flex; align-items: center; gap: 4px; margin-top: 4px;
    font-size: 10px; color: #c81d4a; background: #fff0f3; padding: 3px 6px;
    border-radius: 4px; max-width: 200px;
}
.review-note-box span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.action-btn {
    display: inline-flex; align-items: center; gap: 4px; padding: 6px 12px;
    border-radius: 7px; font-size: 11px; font-weight: 700; border: none; cursor: pointer; transition: 0.15s;
}
.approve-btn { background: #eaf8f2; color: #16825d; }
.approve-btn:hover { background: #16825d; color: #fff; }
.reject-btn { background: #fff0f3; color: #c81d4a; }
.reject-btn:hover { background: #c81d4a; color: #fff; }
.resend-btn { background: #f2edff; color: #5e17eb; }
.resend-btn:hover { background: #5e17eb; color: #fff; }

/* MODAL */
.reject-modal-backdrop {
    position: fixed; inset: 0; background: rgba(26,22,43,0.6); z-index: 1000;
    display: grid; place-items: center; padding: 20px;
}
.reject-modal-card {
    background: #fff; border-radius: 16px; width: min(100%, 480px);
    box-shadow: 0 20px 60px rgba(0,0,0,0.25); overflow: hidden;
}
.modal-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 18px 22px; border-bottom: 1px solid #eee9e6;
}
.modal-header h3 { margin: 0; font-size: 16px; font-weight: 800; color: #1a162b; }
.close-btn { background: none; border: none; font-size: 24px; color: #777486; cursor: pointer; }
.modal-body { padding: 22px; }
.modal-footer {
    display: flex; justify-content: flex-end; gap: 10px;
    padding: 16px 22px; background: #faf7f5; border-top: 1px solid #eee9e6;
}

@@media (max-width: 900px) {
    .admin-stats-grid { grid-template-columns: repeat(2, 1fr); }
    .toolbar-right { width: 100%; justify-content: space-between; }
}
@@media (max-width: 600px) {
    .admin-stats-grid { grid-template-columns: 1fr; }
    .filter-tabs { width: 100%; overflow-x: auto; }
}
</style>

@section Scripts {
<script>
    let currentFilter = 'all';

    function setFilter(filter) {
        currentFilter = filter;
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.classList.toggle('active', btn.getAttribute('onclick').includes(filter));
        });
        filterRows();
    }

    function handleSearch() {
        filterRows();
    }

    function filterRows() {
        const query = (document.getElementById('searchInput')?.value || '').toLowerCase().trim();
        const rows = document.querySelectorAll('.operator-row');
        let visibleCount = 0;

        rows.forEach(row => {
            const status = row.getAttribute('data-status');
            const keywords = row.getAttribute('data-keywords') || '';
            const matchesFilter = (currentFilter === 'all' || status === currentFilter);
            const matchesSearch = !query || keywords.includes(query);

            if (matchesFilter && matchesSearch) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        const label = document.getElementById('recordCountLabel');
        if (label) {
            label.textContent = '(' + visibleCount + ' hồ sơ)';
        }
    }

    function openRejectModal(id, name) {
        const modal = document.getElementById('rejectModal');
        const form = document.getElementById('rejectForm');
        const nameEl = document.getElementById('rejectCompanyName');
        const noteInput = document.getElementById('rejectNoteInput');
        
        if (modal && form && nameEl) {
            form.action = '/admin/operators/' + id + '/reject';
            nameEl.textContent = name;
            if (noteInput) noteInput.value = '';
            modal.style.display = 'grid';
        }
    }

    function closeRejectModal() {
        const modal = document.getElementById('rejectModal');
        if (modal) modal.style.display = 'none';
    }
</script>
}
