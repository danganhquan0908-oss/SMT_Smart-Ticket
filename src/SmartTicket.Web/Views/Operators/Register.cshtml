@model SmartTicket.Web.Models.OperatorRegistrationForm
@{
    ViewData["Title"] = "Đăng ký Đối tác Nhà xe - Smart Ticket";
}

<div class="operator-register-page">
    <div class="page-heading">
        <div>
            <p class="eyebrow">ĐỐI TÁC SMART TICKET</p>
            <h1>Đăng ký mở tài khoản Nhà xe</h1>
            <p>Gia nhập mạng lưới vận tải số Smart Ticket - SMT để tiếp cận hàng triệu hành khách toàn quốc.</p>
        </div>
        <a class="button button-outline" asp-controller="Home" asp-action="Index">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            Về trang chủ
        </a>
    </div>

    <!-- ONBOARDING PROGRESSION PIPELINE -->
    <div class="onboarding-steps-container">
        <div class="onboarding-step-card active">
            <div class="step-num-badge">01</div>
            <div class="step-content">
                <strong>Nộp hồ sơ pháp lý</strong>
                <p>Khai báo MST, hotline và giấy phép kinh doanh</p>
            </div>
            <span class="step-status-tag">Đang thực hiện</span>
        </div>
        <div class="onboarding-step-arrow">→</div>
        <div class="onboarding-step-card">
            <div class="step-num-badge">02</div>
            <div class="step-content">
                <strong>Thẩm định 24h</strong>
                <p>Đội ngũ Smart Ticket kiểm tra hồ sơ hợp lệ</p>
            </div>
            <span class="step-status-tag waiting">Chờ thẩm định</span>
        </div>
        <div class="onboarding-step-arrow">→</div>
        <div class="onboarding-step-card">
            <div class="step-num-badge">03</div>
            <div class="step-content">
                <strong>Kích hoạt & 2FA</strong>
                <p>Nhận email kích hoạt, tạo mật khẩu & bật bảo mật</p>
            </div>
            <span class="step-status-tag">Bảo mật</span>
        </div>
        <div class="onboarding-step-arrow">→</div>
        <div class="onboarding-step-card">
            <div class="step-num-badge">04</div>
            <div class="step-content">
                <strong>Vận hành & Bán vé</strong>
                <p>Khai báo sơ đồ xe, chuyến chạy và niêm yết vé</p>
            </div>
            <span class="step-status-tag">Sẵn sàng</span>
        </div>
    </div>

    <div class="register-layout-grid">
        <!-- FORM CARD -->
        <div class="form-card register-main-card">
            <div class="form-header-bar">
                <div class="brand-sub-badge">SMT PARTNER</div>
                <h2>Thông tin hồ sơ doanh nghiệp</h2>
                <p class="muted">Vui lòng nhập thông tin chính xác theo giấy phép đăng ký kinh doanh vận tải hành khách.</p>
            </div>

            <form asp-action="Register" method="post" enctype="multipart/form-data" id="operatorRegisterForm">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="form-grid">
                    <!-- TÊN DOANH NGHIỆP -->
                    <div class="field field-full">
                        <label asp-for="CompanyName">
                            Tên doanh nghiệp / Nhà xe <span class="required">*</span>
                        </label>
                        <input asp-for="CompanyName" class="form-input" placeholder="Ví dụ: Công ty TNHH Vận Tải Hành Khách Phương Trang" required />
                        <span asp-validation-for="CompanyName" class="field-error"></span>
                        <small class="field-help">Tên nhà xe hiển thị với hành khách khi tìm kiếm chuyến và trên vé điện tử.</small>
                    </div>

                    <!-- MÃ SỐ THUẾ -->
                    <div class="field">
                        <label asp-for="TaxCode">
                            Mã số thuế doanh nghiệp <span class="required">*</span>
                        </label>
                        <input asp-for="TaxCode" class="form-input" placeholder="Ví dụ: 0301234567" required maxlength="20" />
                        <span asp-validation-for="TaxCode" class="field-error"></span>
                        <small class="field-help">Dùng để xác thực pháp nhân và đối soát thuế.</small>
                    </div>

                    <!-- HOTLINE -->
                    <div class="field">
                        <label asp-for="Hotline">
                            Số điện thoại Hotline nhà xe <span class="required">*</span>
                        </label>
                        <input asp-for="Hotline" type="tel" class="form-input" placeholder="Ví dụ: 1900 6067 hoặc 028 3838 6868" required />
                        <span asp-validation-for="Hotline" class="field-error"></span>
                        <small class="field-help">Số đường dây nóng để hành khách liên hệ khi cần hỗ trợ lên xe.</small>
                    </div>

                    <!-- EMAIL ĐẠI DIỆN -->
                    <div class="field field-full">
                        <label asp-for="Email">
                            Email người đại diện pháp luật <span class="required">*</span>
                        </label>
                        <input asp-for="Email" type="email" autocomplete="email" class="form-input" placeholder="dieuhanh@nhaxe.vn" required />
                        <span asp-validation-for="Email" class="field-error"></span>
                        <small class="field-help">Liên kết kích hoạt tài khoản Quản trị nhà xe sẽ được gửi về địa chỉ email này.</small>
                    </div>

                    <!-- GIẤY PHÉP KINH DOANH -->
                    <div class="field field-full">
                        <label asp-for="BusinessLicense">
                            Giấy phép kinh doanh vận tải (PDF / JPG / PNG) <span class="required">*</span>
                        </label>
                        <div class="file-upload-dropzone" id="dropzoneContainer">
                            <input asp-for="BusinessLicense" type="file" accept=".pdf,.jpg,.jpeg,.png" id="licenseFileInput" required />
                            <div class="dropzone-content">
                                <div class="dropzone-icon">
                                    <svg width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                        <path d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
                                    </svg>
                                </div>
                                <div class="dropzone-text">
                                    <strong id="dropzoneLabel">Nhấp để chọn tệp hoặc kéo thả giấy phép vào đây</strong>
                                    <span>Chấp nhận PDF, JPG, JPEG hoặc PNG · Dung lượng tối đa 10 MB</span>
                                </div>
                            </div>
                        </div>
                        <span asp-validation-for="BusinessLicense" class="field-error"></span>
                    </div>
                </div>

                <div class="security-assurance-box">
                    <svg width="22" height="22" fill="none" stroke="#16825d" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                    <div>
                        <strong>Cam kết bảo mật & lưu trữ an toàn</strong>
                        <p>Tệp giấy phép kinh doanh được mã hóa và lưu trữ tại kho riêng tư (Private License Store), chỉ phục vụ việc thẩm định pháp lý và không bao giờ chia sẻ cho bên thứ ba.</p>
                    </div>
                </div>

                <div class="form-footer">
                    <a class="button button-outline" asp-controller="Home" asp-action="Index">Hủy bỏ</a>
                    <button class="button button-primary" type="submit" id="btnSubmit">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>
                        Gửi hồ sơ thẩm định
                    </button>
                </div>
            </form>
        </div>

        <!-- RIGHT SIDEBAR / BENEFIT CARD -->
        <div class="register-sidebar">
            <div class="benefit-card">
                <h3>Đặc quyền Đối tác Smart Ticket</h3>
                <ul class="benefit-list">
                    <li>
                        <div class="b-icon">✓</div>
                        <div>
                            <strong>Bán vé tự động không giới hạn</strong>
                            <p>Sơ đồ 2 tầng, giữ chỗ realtime 10 phút qua WebSocket SignalR chống trùng chỗ tuyệt đối.</p>
                        </div>
                    </li>
                    <li>
                        <div class="b-icon">✓</div>
                        <div>
                            <strong>VietQR Pro khóa số tiền tự động</strong>
                            <p>Khách quét mã thanh toán ngay, số tiền và nội dung chuyển khoản được khóa chặt, ngăn lỗi thiếu/thừa.</p>
                        </div>
                    </li>
                    <li>
                        <div class="b-icon">✓</div>
                        <div>
                            <strong>Toàn quyền điều chỉnh giá vé</strong>
                            <p>Thay đổi linh hoạt theo mùa vụ, tự động lưu lịch sử Audit Log minh bạch.</p>
                        </div>
                    </li>
                    <li>
                        <div class="b-icon">✓</div>
                        <div>
                            <strong>Đối soát doanh thu hàng ngày</strong>
                            <p>Báo cáo dòng tiền, lệnh đối soát chuẩn xác, kết nối trực tiếp với trạm xuất bến.</p>
                        </div>
                    </li>
                </ul>

                <div class="sidebar-support-box">
                    <span class="support-title">Cần trợ giúp hồ sơ?</span>
                    <p>Bộ phận hỗ trợ đối tác Smart Ticket sẵn sàng đồng hành 24/7:</p>
                    <a href="tel:1900888666" class="support-phone">📞 1900 888 666</a>
                    <span class="support-email">support@smartticket.vn</span>
                </div>
            </div>

            <div class="already-registered-card">
                <p>Doanh nghiệp của bạn đã có tài khoản?</p>
                <a class="button button-light" asp-controller="Account" asp-action="Login">Đăng nhập tài khoản nhà xe →</a>
            </div>
        </div>
    </div>
</div>

<style>
.operator-register-page { max-width: 1200px; margin: 0 auto; }
.onboarding-steps-container {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    margin-bottom: 28px; background: #fff; padding: 20px 24px;
    border: 1px solid #eee9e6; border-radius: 16px; box-shadow: 0 4px 16px rgba(26,22,43,0.04);
}
.onboarding-step-card {
    display: flex; align-items: center; gap: 12px; flex: 1; padding: 10px 14px;
    border-radius: 12px; background: #faf7f5; border: 1px solid #eee9e6;
}
.onboarding-step-card.active {
    background: #fff0f3; border-color: #f7aabf;
}
.step-num-badge {
    width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center;
    background: #1a162b; color: #fff; font-weight: 800; font-size: 14px; flex-shrink: 0;
}
.onboarding-step-card.active .step-num-badge {
    background: #c81d4a; color: #fff;
}
.step-content { display: flex; flex-direction: column; gap: 2px; }
.step-content strong { font-size: 13px; color: #1a162b; }
.step-content p { font-size: 11px; color: #777486; margin: 0; }
.step-status-tag {
    font-size: 10px; font-weight: 700; padding: 4px 8px; border-radius: 20px;
    background: #f2edff; color: #5e17eb; margin-left: auto; white-space: nowrap;
}
.onboarding-step-card.active .step-status-tag {
    background: #c81d4a; color: #fff;
}
.step-status-tag.waiting {
    background: #eee9e6; color: #777486;
}
.onboarding-step-arrow { color: #aaa2b3; font-weight: 700; font-size: 16px; }

.register-layout-grid {
    display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(320px, 0.85fr); gap: 24px; align-items: start;
}
.register-main-card { max-width: 100%; padding: 32px; }
.form-header-bar { margin-bottom: 24px; }
.brand-sub-badge {
    display: inline-block; padding: 4px 10px; border-radius: 6px;
    background: #f2edff; color: #5e17eb; font-size: 10px; font-weight: 800;
    letter-spacing: 1px; margin-bottom: 8px;
}
.form-header-bar h2 { font-size: 22px; font-weight: 800; margin: 0 0 6px; color: #1a162b; }
.required { color: #c81d4a; font-weight: 700; }
.field-help { font-size: 11px; color: #777486; margin-top: 4px; }

.file-upload-dropzone {
    position: relative; border: 2px dashed #d9d0e2; border-radius: 12px;
    background: #faf7f5; padding: 24px 20px; text-align: center;
    transition: border-color 0.2s, background-color 0.2s; cursor: pointer;
}
.file-upload-dropzone:hover {
    border-color: #5e17eb; background: #fbf9ff;
}
.file-upload-dropzone input[type="file"] {
    position: absolute; inset: 0; opacity: 0; width: 100%; height: 100%; cursor: pointer; z-index: 2;
}
.dropzone-content { display: flex; flex-direction: column; align-items: center; gap: 10px; }
.dropzone-icon {
    width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center;
    background: #f2edff; color: #5e17eb;
}
.dropzone-text strong { display: block; font-size: 13px; color: #1a162b; margin-bottom: 4px; }
.dropzone-text span { font-size: 11px; color: #777486; }

.security-assurance-box {
    display: flex; gap: 14px; align-items: flex-start; margin-top: 22px;
    padding: 16px; background: #eaf8f2; border: 1px solid #d5efe3;
    border-radius: 12px; color: #14724f;
}
.security-assurance-box strong { font-size: 12px; display: block; margin-bottom: 2px; }
.security-assurance-box p { font-size: 11px; line-height: 1.6; margin: 0; color: #1f6b50; }

.register-sidebar { display: flex; flex-direction: column; gap: 18px; }
.benefit-card {
    background: #fff; border: 1px solid #eee9e6; border-radius: 16px;
    padding: 26px; box-shadow: 0 4px 16px rgba(26,22,43,0.04);
}
.benefit-card h3 { font-size: 16px; font-weight: 800; color: #1a162b; margin: 0 0 18px; }
.benefit-list { list-style: none; padding: 0; margin: 0 0 24px; display: flex; flex-direction: column; gap: 16px; }
.benefit-list li { display: flex; gap: 12px; align-items: flex-start; }
.b-icon {
    width: 22px; height: 22px; border-radius: 50%; background: #16825d; color: #fff;
    display: grid; place-items: center; font-size: 12px; font-weight: 800; flex-shrink: 0; margin-top: 2px;
}
.benefit-list strong { font-size: 13px; color: #1a162b; display: block; margin-bottom: 2px; }
.benefit-list p { font-size: 11px; color: #777486; line-height: 1.5; margin: 0; }

.sidebar-support-box {
    border-top: 1px solid #eee9e6; padding-top: 18px; display: flex; flex-direction: column; gap: 6px;
}
.support-title { font-size: 11px; font-weight: 800; color: #1a162b; letter-spacing: 0.5px; }
.sidebar-support-box p { font-size: 11px; color: #777486; margin: 0; }
.support-phone { font-size: 16px; font-weight: 800; color: #c81d4a; text-decoration: none; margin-top: 4px; }
.support-email { font-size: 11px; color: #5e17eb; }

.already-registered-card {
    background: #1a162b; color: #fff; border-radius: 16px; padding: 22px; text-align: center;
}
.already-registered-card p { font-size: 12px; color: #d5cddb; margin: 0 0 12px; }
.already-registered-card .button-light { width: 100%; }

@@media (max-width: 900px) {
    .onboarding-steps-container { flex-direction: column; align-items: stretch; }
    .onboarding-step-arrow { display: none; }
    .register-layout-grid { grid-template-columns: 1fr; }
}
</style>

@section Scripts {
<script>
    const fileInput = document.getElementById('licenseFileInput');
    const dropzoneLabel = document.getElementById('dropzoneLabel');
    if (fileInput && dropzoneLabel) {
        fileInput.addEventListener('change', function(e) {
            if (this.files && this.files.length > 0) {
                const file = this.files[0];
                const sizeMb = (file.size / (1024 * 1024)).toFixed(2);
                dropzoneLabel.innerHTML = '✓ Đã chọn: <strong style="color:#5e17eb;">' + file.name + '</strong> (' + sizeMb + ' MB)';
            }
        });
    }
</script>
}
