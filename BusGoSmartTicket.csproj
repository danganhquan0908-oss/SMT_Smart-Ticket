<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BusGoSmartTicket</RootNamespace>
    <AssemblyName>BusGoSmartTicket</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);.local/**;.tools/**;.vs/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(OS)' == 'Windows_NT'">
    <AutoStartLocalDatabase Condition="'$(AutoStartLocalDatabase)' == ''">true</AutoStartLocalDatabase>
    <!-- F5 must check the database even when the application binaries are unchanged. -->
    <DisableFastUpToDateCheck Condition="'$(AutoStartLocalDatabase)' == 'true'">true</DisableFastUpToDateCheck>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.14" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="StackExchange.Redis" Version="2.7.27" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="appsettings.Local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Remove="docs/**;scripts/**" />
  </ItemGroup>
  <Target Name="EnsureVisualStudioLocalDatabase"
          BeforeTargets="PrepareForBuild"
          Condition="'$(Configuration)' == 'Debug' and '$(OS)' == 'Windows_NT' and '$(BuildingInsideVisualStudio)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(AutoStartLocalDatabase)' == 'true'">
    <Message Text="Preparing local PostgreSQL and releasing the script web instance for Visual Studio Debug/F5..." Importance="high" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\start-local.ps1&quot; -DatabaseOnly -PrepareForVisualStudio"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
