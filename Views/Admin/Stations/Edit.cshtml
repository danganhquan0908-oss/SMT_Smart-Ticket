@model BusGoSmartTicket.Models.DTOs.Catalog.SaveStationRequest
@{
    var isEdit = ViewData["StationId"] is not null;
    ViewData["Title"] = isEdit ? "Cập nhật bến xe - Smart Ticket" : "Thêm bến xe mới - Smart Ticket";
}

<div class="station-edit-container">
    <div class="page-heading">
        <div>
            <p class="eyebrow">QUẢN LÝ BẾN XE VÀ TUYẾN ĐƯỜNG</p>
            <h1>@(isEdit ? "Cập nhật thông tin bến xe" : "Thêm bến xe mới")</h1>
            <p>Bến xe là cơ sở pháp lý để ký Lệnh xuất bến và xác định điểm đầu/điểm cuối của tuyến xe.</p>
        </div>
        <a class="button button-outline" asp-action="Index">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            Quay lại danh sách
        </a>
    </div>

    <div class="form-card">
        <form method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@ViewData["StationId"]">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-grid">
                <!-- MÃ BẾN XE -->
                <div class="field">
                    <label asp-for="Code">Mã bến xe (Viết hoa, viết liền) <span class="required">*</span></label>
                    <input asp-for="Code" placeholder="Ví dụ: BXMD, BXNN, BXGP" class="form-input font-mono" maxlength="12" required />
                    <span asp-validation-for="Code" class="field-error"></span>
                    <small class="field-help">Mã định danh duy nhất (2 đến 12 ký tự) dùng trên vé và hệ thống tra cứu.</small>
                </div>

                <!-- TÊN BẾN XE -->
                <div class="field">
                    <label asp-for="Name">Tên bến xe chính thức <span class="required">*</span></label>
                    <input asp-for="Name" placeholder="Ví dụ: Bến xe Miền Đông mới, Bến xe Nước Ngầm" class="form-input" maxlength="160" required />
                    <span asp-validation-for="Name" class="field-error"></span>
                    <small class="field-help">Tên sẽ hiển thị công khai trên giao diện tìm kiếm vé của hành khách.</small>
                </div>

                <!-- TỈNH / THÀNH PHỐ -->
                <div class="field field-full">
                    <label asp-for="Province">Tỉnh / Thành phố trực thuộc <span class="required">*</span></label>
                    <input asp-for="Province" placeholder="Ví dụ: TP. Hồ Chí Minh, Hà Nội, Lâm Đồng, Đà Nẵng" class="form-input" maxlength="100" required />
                    <span asp-validation-for="Province" class="field-error"></span>
                </div>

                <!-- ĐỊA CHỈ CHI TIẾT -->
                <div class="field field-full">
                    <label asp-for="Address">Địa chỉ chi tiết bến xe <span class="required">*</span></label>
                    <input asp-for="Address" placeholder="Số nhà, đường, phường/xã, quận/huyện" class="form-input" maxlength="300" required />
                    <span asp-validation-for="Address" class="field-error"></span>
                    <small class="field-help">In trên vé điện tử để hành khách nắm rõ địa điểm đón/trả xe.</small>
                </div>
            </div>

            <div class="notice-box-info" style="margin-top: 18px;">
                <span class="info-icon">ℹ️</span>
                <span><strong>Quy tắc hệ thống:</strong> Bến xe đang có chuyến đã lên lịch hoặc đang chạy không thể ngừng hoạt động để bảo vệ quyền lợi hành khách.</span>
            </div>

            <div class="form-footer">
                <a asp-action="Index" class="button button-outline">Hủy bỏ</a>
                <button type="submit" class="button button-primary" style="padding-inline: 24px;">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>
                    @(isEdit ? "Lưu thay đổi bến xe" : "Tạo bến xe mới")
                </button>
            </div>
        </form>
    </div>
</div>



@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin-stations-edit.css" asp-append-version="true" />
}
