@model IReadOnlyList<BusGoSmartTicket.Models.DTOs.Catalog.StationDto>
@{
    ViewData["Title"] = "Quản lý Bến xe - Smart Ticket";
    var totalCount = Model.Count;
    var activeCount = Model.Count(x => x.IsActive);
    var inactiveCount = totalCount - activeCount;
}

<div class="admin-page-container">
    <div class="page-heading">
        <div>
            <p class="eyebrow">QUẢN LÝ BẾN XE VÀ TUYẾN ĐƯỜNG</p>
            <h1>Quản lý Bến xe Toàn quốc</h1>
            <p>Bến xe là điểm neo xác định các tuyến vận tải liên tỉnh và phục vụ quy trình xuất bến hợp pháp.</p>
        </div>
        <div class="heading-actions">
            <a class="button button-outline" asp-controller="Home" asp-action="Index">← Trang chủ</a>
            <a class="button button-primary" asp-action="Create">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                Thêm bến xe mới
            </a>
        </div>
    </div>

    @await Html.PartialAsync("_Feedback")

    <!-- THẺ THỐNG KÊ NHANH -->
    <div class="metric-grid" style="grid-template-columns: repeat(3, 1fr); margin-bottom: 24px;">
        <div class="metric-card">
            <div class="metric-icon plum">🏢</div>
            <div>
                <span>Tổng số bến xe</span>
                <strong>@totalCount</strong>
            </div>
        </div>
        <div class="metric-card">
            <div class="metric-icon" style="background: #eaf8f2; color: #14724f;">✓</div>
            <div>
                <span>Đang hoạt động</span>
                <strong style="color: #14724f;">@activeCount</strong>
            </div>
        </div>
        <div class="metric-card">
            <div class="metric-icon" style="background: #f2f0f2; color: #77717c;">⏸</div>
            <div>
                <span>Tạm ngừng</span>
                <strong style="color: #77717c;">@inactiveCount</strong>
            </div>
        </div>
    </div>

    <!-- BẢNG DANH MỤC BẾN XE -->
    <div class="table-card">
        <div class="table-toolbar">
            <div>
                <strong>Danh sách các bến xe trong hệ thống</strong>
                <span>(Lưu lịch sử các bến đã ngừng hoạt động)</span>
            </div>
            <div>
                <input type="text" id="station-filter" placeholder="Lọc theo tên, tỉnh thành..." class="input-filter-table" onkeyup="filterStations()" />
            </div>
        </div>

        <div class="table-scroll">
            <table id="stations-table">
                <thead>
                    <tr>
                        <th style="width: 120px;">Mã bến</th>
                        <th>Tên bến xe</th>
                        <th style="width: 180px;">Tỉnh / Thành phố</th>
                        <th>Địa chỉ chi tiết</th>
                        <th style="width: 140px;">Trạng thái</th>
                        <th class="actions-col" style="width: 280px;">Phân công & Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var station in Model)
                    {
                        <tr>
                            <td>
                                <span class="code-pill">@station.Code</span>
                            </td>
                            <td class="primary-cell">
                                <strong>@station.Name</strong>
                            </td>
                            <td>
                                <span class="province-badge">📍 @station.Province</span>
                            </td>
                            <td>
                                <span class="address-text">@station.Address</span>
                            </td>
                            <td>
                                @if (station.IsActive)
                                {
                                    <span class="status status-active">Đang hoạt động</span>
                                }
                                else
                                {
                                    <span class="status status-inactive">Đã ngừng</span>
                                }
                            </td>
                            <td>
                                <div class="station-actions-wrapper">
                                    <div class="main-actions">
                                        <a asp-action="Edit" asp-route-id="@station.Id" class="action-btn edit-btn">Sửa</a>
                                        <span class="sep">·</span>

                                        @if (station.IsActive)
                                        {
                                            <form asp-action="Deactivate" asp-route-id="@station.Id" method="post" style="display: inline;" onsubmit="return confirm('Bạn có chắc chắn muốn ngừng hoạt động bến xe @station.Name? Bến xe chỉ có thể ngừng khi không có chuyến Scheduled/Running.');">
                                                <button type="submit" class="action-btn text-danger">Ngừng hoạt động</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Reactivate" asp-route-id="@station.Id" method="post" style="display: inline;">
                                                <button type="submit" class="action-btn text-success">Khôi phục</button>
                                            </form>
                                        }
                                    </div>

                                    @if (station.IsActive)
                                    {
                                        <!-- Phân công nhân viên bến xe soát vé -->
                                        <form asp-action="AddStationMember" asp-route-id="@station.Id" method="post" class="assign-member-inline">
                                            <input name="email" type="email" placeholder="Email nhân viên bến" required class="input-assign-email" />
                                            <button type="submit" class="btn-assign-member" title="Phân quyền soát vé tại bến">+ Phân công</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }

                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="empty-state">
                                <div style="font-size: 32px; margin-bottom: 8px;">🏢</div>
                                <strong>Chưa có bến xe nào trong hệ thống.</strong>
                                <p style="margin: 6px 0 16px; font-size: 13px; color: var(--muted, #777486);">Bắt đầu bằng việc thêm bến xe đầu tiên để định nghĩa các tuyến đường.</p>
                                <a asp-action="Create" class="button button-primary" style="display: inline-flex;">+ Thêm bến xe mới</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>





@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin-stations-index.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/pages/admin-stations-index.js" asp-append-version="true"></script>
}
