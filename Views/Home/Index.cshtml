@model BusGoSmartTicket.Models.ViewModels.TripSearchViewModel
@{ ViewData["Title"]="Tìm chuyến xe"; var searched=Model.DepartureStationId.HasValue && Model.ArrivalStationId.HasValue; var today=DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7)); }
@if(!searched){<section class="merge-hero"><div><h1>Chọn chuyến phù hợp.<br />Sẵn sàng lên đường.</h1><p>Tìm chuyến, so sánh giá và chọn chỗ trên cùng một hành trình. Vé điện tử được lưu trong tài khoản của bạn.</p><a href="/journey/help">Tìm hiểu cách đặt vé</a></div><img src="/images/vietnam-dalat.jpg" alt="Phong cảnh Đà Lạt, điểm đến của hành trình" width="600" height="350" /></section>}
<section class="journey-search" aria-label="Tìm chuyến xe"><h2>Bạn muốn đi đâu?</h2>
<form method="get" action="/" id="journey-form"><div class="journey-fields">
<label>Bến đi<select name="departureStationId" id="journey-from" required><option value="">Chọn bến khởi hành</option>@foreach(var s in Model.Stations){<option value="@s.Id" selected="@(s.Id == Model.DepartureStationId)">@s.Name · @s.Province</option>}</select></label>
<button class="button button-outline swap-button" type="button" id="journey-swap" aria-label="Đổi chiều hành trình"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16m-4-4 4 4-4 4M20 17H4m4-4-4 4 4 4"/></svg></button>
<label>Bến đến<select name="arrivalStationId" id="journey-to" required><option value="">Chọn bến đến</option>@foreach(var s in Model.Stations){<option value="@s.Id" selected="@(s.Id == Model.ArrivalStationId)">@s.Name · @s.Province</option>}</select></label>
<label>Ngày khởi hành<input name="travelDate" id="journey-date" type="date" value="@Model.TravelDate.ToString("yyyy-MM-dd")" min="@today.ToString("yyyy-MM-dd")" required /></label><button class="button button-primary">Tìm chuyến</button>
</div><div class="quick-dates"><span>Đi vào</span><button type="button" data-travel-date="@today.ToString("yyyy-MM-dd")">Hôm nay</button><button type="button" data-travel-date="@today.AddDays(1).ToString("yyyy-MM-dd")">Ngày mai</button></div>
@if(searched){<div class="search-filters">
<label>Nhà xe<select name="company"><option value="">Tất cả nhà xe</option>@foreach(var c in Model.Companies){<option selected="@(c==Model.Company)">@c</option>}</select></label>
<label>Loại xe<select name="vehicle"><option value="">Tất cả loại xe</option><option value="limousine" selected="@(Model.Vehicle=="limousine")">Limousine</option><option value="giuong" selected="@(Model.Vehicle=="giuong")">Giường nằm</option><option value="ghe" selected="@(Model.Vehicle=="ghe")">Ghế ngồi</option></select></label>
<label>Giờ đi<select name="period"><option value="">Cả ngày</option><option value="morning" selected="@(Model.Period=="morning")">Sáng 06–12h</option><option value="afternoon" selected="@(Model.Period=="afternoon")">Chiều 12–18h</option><option value="night" selected="@(Model.Period=="night")">Tối / đêm 18–06h</option></select></label>
<label>Sắp xếp<select name="sort"><option value="time">Giờ đi sớm nhất</option><option value="late" selected="@(Model.Sort=="late")">Giờ đi muộn nhất</option><option value="price" selected="@(Model.Sort=="price")">Giá thấp nhất</option><option value="seats" selected="@(Model.Sort=="seats")">Nhiều ghế trống nhất</option></select></label>
<label class="check-filter"><input name="availableOnly" type="checkbox" value="true" checked="@Model.AvailableOnly" />Chỉ chuyến còn chỗ</label><button class="button button-outline">Áp dụng bộ lọc</button>
</div>}
</form></section>
@if(Model.Error is not null){<p role="alert" class="alert-box-warning">@Model.Error</p>}
@if(searched){<section class="journey-results"><h2>@Model.TotalResults chuyến ngày @Model.TravelDate.ToString("dd/MM/yyyy")</h2><p>Giá niêm yết cho một ghế. Ưu đãi hội viên được xác nhận khi giữ chỗ.</p>
@if(Model.Results.Count==0){<div class="empty-state"><h3>Chưa tìm thấy chuyến phù hợp</h3><p>Thử ngày khác hoặc bỏ bớt bộ lọc.</p><a href="/?departureStationId=@Model.DepartureStationId&arrivalStationId=@Model.ArrivalStationId&travelDate=@Model.TravelDate.AddDays(1).ToString("yyyy-MM-dd")">Tìm ngày tiếp theo</a></div>}
@foreach(var trip in Model.Results){var dep=trip.DepartureTimeUtc.AddHours(7);var arr=trip.ArrivalTimeUtc.AddHours(7);<article class="route-result"><div><h3>@trip.Operator</h3><p>@trip.VehicleType</p><p>Còn @trip.AvailableSeats / @trip.TotalSeats ghế</p></div><div class="result-times"><div><strong>@dep.ToString("HH:mm")</strong><span>@trip.DepartureStation</span></div><div><strong>@arr.ToString("HH:mm")</strong><span>@trip.ArrivalStation · @arr.ToString("dd/MM")</span></div></div><div class="result-fare"><strong>@trip.Price.ToString("N0") ₫</strong><span>@((int)(arr-dep).TotalHours) giờ @((arr-dep).Minutes) phút</span></div>@if(trip.AvailableSeats>0){<a class="button button-primary" href="/trips/@trip.TripId/seats">Chọn ghế</a>}else{<button class="button button-outline" disabled>Hết chỗ</button>}</article>}
@if(Model.TotalResults>8){<nav class="pagination-row" aria-label="Trang kết quả">@for(var p=1;p<=Math.Ceiling(Model.TotalResults/8m);p++){<a class="button @(p==Model.Page ? "button-primary" : "button-outline")" asp-action="Index" asp-route-departureStationId="@Model.DepartureStationId" asp-route-arrivalStationId="@Model.ArrivalStationId" asp-route-travelDate="@Model.TravelDate.ToString("yyyy-MM-dd")" asp-route-company="@Model.Company" asp-route-vehicle="@Model.Vehicle" asp-route-period="@Model.Period" asp-route-sort="@Model.Sort" asp-route-availableOnly="@Model.AvailableOnly" asp-route-page="@p">@p</a>}</nav>}</section>}
else{<section><h2 class="section-title">Hành trình tiếp theo của bạn</h2><div class="destination-grid"><article class="destination-card"><img src="/images/vietnam-hanoi.jpg" alt="Hà Nội" loading="lazy" width="400" height="220"/><h3>Hà Nội</h3><p>Tìm bến đi thuận tiện và giờ xuất phát phù hợp.</p></article><article class="destination-card"><img src="/images/vietnam-dalat.jpg" alt="Đà Lạt" loading="lazy" width="400" height="220"/><h3>Đà Lạt</h3><p>So sánh ghế ngồi, giường nằm và limousine.</p></article><article class="destination-card"><img src="/images/vietnam-bay.webp" alt="Vịnh biển Việt Nam" loading="lazy" width="400" height="220"/><h3>Đi cùng sự chủ động</h3><p>Lưu vé trong tài khoản, kiểm tra lại trước giờ lên xe.</p></article></div></section>}
