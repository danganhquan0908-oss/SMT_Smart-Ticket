@model BusGoSmartTicket.Models.ViewModels.TicketLookupViewModel
@{
    ViewData["Title"] = "Vé xe điện tử - Smart Ticket SMT";
    var images = Model.QrImages;
}

<div class="tickets-page-container">
    <!-- TOP HEADER -->
    <div class="ticket-page-header no-print">
        <div class="header-left">
            <span class="booking-verified-badge" data-i18n="ticket_paid_badge">✓ ĐÃ THANH TOÁN THÀNH CÔNG</span>
            <h1 data-i18n="ticket_page_title">Vé Xe Khách Điện Tử (E-Ticket)</h1>
            <p class="ticket-subtitle">
                <span data-i18n="ticket_code_label">Mã đặt chỗ:</span> <strong class="booking-code-highlight">@Model.Booking.BookingCode</strong> · <span data-i18n="ticket_count_label">Số lượng:</span> <strong>@Model.Booking.Tickets.Count vé</strong>
            </p>
        </div>

        <div class="header-actions">
            <button type="button" class="button button-outline" onclick="window.print()">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v8H6v-8z"/></svg>
                <span data-i18n="btn_print_pdf">In vé / Lưu PDF</span>
            </button>
            <a class="button button-primary" asp-controller="Home" asp-action="Index" data-i18n="btn_book_more">
                Đặt thêm chuyến khác →
            </a>
        </div>
    </div>

    @if (Model.Booking.Tickets.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-symbol">🎟️</div>
            <strong>Chưa có vé nào được phát hành</strong>
            <p>Hệ thống đang đối soát lệnh thanh toán với ngân hàng. Vui lòng tải lại trang sau 30 giây hoặc liên hệ Hotline 1900 888 666.</p>
        </div>
    }
    else
    {
        <!-- TICKETS LIST -->
        <div class="tickets-grid">
            @foreach (var ticket in Model.Booking.Tickets)
            {
                var depLocal = ticket.DepartureTimeUtc.AddHours(7); // Giờ Việt Nam chuẩn
                var qrBase64 = images.TryGetValue(ticket.TicketNumber, out var img) ? img : "";

                <article class="e-ticket-boarding-pass">
                    <!-- LEFT / MAIN BOARDING PASS -->
                    <div class="ticket-main-section">
                        <div class="ticket-brand-row">
                            <div class="ticket-logo-mark">
                                <span class="logo-box">SMT</span>
                                <div>
                                    <strong class="ticket-corp-name">SMART TICKET</strong>
                                    <small class="ticket-corp-sub">VÉ ĐIỆN TỬ HỢP PHÁP · BẾN XE LIÊN TỈNH</small>
                                </div>
                            </div>
                            <div class="ticket-num-badge">
                                <span>SỐ VÉ:</span>
                                <strong>#@ticket.TicketNumber</strong>
                            </div>
                        </div>

                        <!-- ROUTE ROW -->
                        <div class="ticket-journey-row">
                            <div class="journey-station">
                                <span class="station-lbl" data-i18n="ticket_route_label">LỘ TRÌNH CHUYẾN ĐI</span>
                                <h2 class="journey-name">@ticket.Trip</h2>
                            </div>
                        </div>

                        <!-- META DATA GRID -->
                        <div class="ticket-meta-grid">
                            <div class="meta-cell">
                                <span class="cell-label" data-i18n="ticket_passenger_label">HÀNH KHÁCH</span>
                                <strong class="cell-val text-truncate">@ticket.PassengerName</strong>
                            </div>

                            <div class="meta-cell">
                                <span class="cell-label" data-i18n="ticket_dep_label">GIỜ KHỞI HÀNH</span>
                                <strong class="cell-val time-val">@depLocal.ToString("HH:mm")</strong>
                                <small class="cell-date">@depLocal.ToString("dd/MM/yyyy")</small>
                            </div>

                            <div class="meta-cell seat-cell">
                                <span class="cell-label" data-i18n="ticket_seat_label">SỐ GHẾ</span>
                                <div class="seat-badge-pill">@ticket.SeatCode</div>
                            </div>

                            <div class="meta-cell">
                                <span class="cell-label" data-i18n="ticket_price_label">GIÁ VÉ NIÊM YẾT</span>
                                <strong class="cell-val price-val">@ticket.Price.ToString("N0") ₫</strong>
                                <small class="vat-sub" data-i18n="ticket_vat_note">(Đã gồm thuế & bảo hiểm)</small>
                            </div>
                        </div>

                        <div class="ticket-footer-legal">
                            <span data-i18n="ticket_legal_note">🛡️ Vé điện tử có giá trị tương đương vé giấy truyền thống theo Thông tư 12/2020/TT-BGTVT.</span>
                        </div>
                    </div>

                    <!-- TEAR-OFF DIVIDER -->
                    <div class="tear-off-line">
                        <span class="notch-top"></span>
                        <span class="dashed-border"></span>
                        <span class="notch-bottom"></span>
                    </div>

                    <!-- RIGHT / QR CHECK-IN STUB -->
                    <div class="ticket-stub-section">
                        <div class="stub-header">
                            <span class="stub-badge">CHECK-IN BẾN XE</span>
                            <span class="jwt-badge">Encrypted JWT</span>
                        </div>

                        <div class="qr-code-frame">
                            @if (!string.IsNullOrWhiteSpace(qrBase64))
                            {
                                <img src="data:image/png;base64,@qrBase64" alt="QR Check-in Vé #@ticket.TicketNumber" class="checkin-qr-img" />
                            }
                            else
                            {
                                <div class="qr-placeholder">Mã QR</div>
                            }
                        </div>

                        <div class="stub-instructions">
                            <strong>Quét mã soát vé</strong>
                            <p>Xuất trình tại cổng kiểm soát Bến xe hoặc trước khi lên xe</p>
                        </div>
                    </div>
                </article>
            }
        </div>
    }

    <!-- IMPORTANT PASSENGER NOTICE -->
    <div class="passenger-notice-card no-print">
        <div class="notice-icon">📋</div>
        <div class="notice-body">
            <strong>Hướng dẫn lên xe cho hành khách Smart Ticket:</strong>
            <ul class="notice-list">
                <li>Vui lòng có mặt tại Bến xe trước giờ khởi hành tối thiểu <strong>20 - 30 phút</strong> để làm thủ tục.</li>
                <li>Không cần in vé ra giấy, bạn chỉ cần mở màn hình điện thoại có mã QR để nhân viên bến hoặc tài xế quét bằng máy quét an ninh.</li>
                <li>Trong trường hợp cần đổi chuyến hoặc trợ giúp khẩn cấp, vui lòng gọi hotline <strong>1900 888 666</strong> và đọc mã đặt chỗ <strong>@Model.Booking.BookingCode</strong>.</li>
            </ul>
        </div>
    </div>
</div>



@section Styles {
    <link rel="stylesheet" href="~/css/pages/payments-tickets.css" asp-append-version="true" />
}
