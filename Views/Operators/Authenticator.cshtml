@model BusGoSmartTicket.Models.ViewModels.OperatorActivationForm
@{
    ViewData["Title"] = "Bật Xác thực Hai lớp (2FA) - Smart Ticket";
}

<section class="login-shell">
    <!-- LEFT BRAND PANEL -->
    <div class="login-brand-panel">
        <div class="login-logo-frame">
            <img src="~/images/favicon.svg" alt="Smart Ticket SMT" asp-append-version="true" />
        </div>
        <p class="eyebrow">SMT PARTNER ONBOARDING</p>
        <h2>Xác thực hai lớp <em>(TOTP)</em></h2>
        <p class="login-brand-copy">
            Để bảo vệ doanh thu bán vé và ngăn chặn rủi ro truy cập trái phép, toàn bộ tài khoản Đối tác nhà xe trên Smart Ticket đều bắt buộc kích hoạt xác thực hai lớp (2FA).
        </p>

        <!-- PROGRESS MILESTONES -->
        <div class="activation-milestones">
            <div class="milestone completed">
                <span class="m-dot">✓</span>
                <div>
                    <strong>Thẩm định hồ sơ</strong>
                    <small>Đã duyệt pháp nhân & MST</small>
                </div>
            </div>
            <div class="milestone completed">
                <span class="m-dot">✓</span>
                <div>
                    <strong>Tạo mật khẩu an toàn</strong>
                    <small>Đã hoàn thành</small>
                </div>
            </div>
            <div class="milestone active">
                <span class="m-dot">3</span>
                <div>
                    <strong>Kích hoạt 2FA</strong>
                    <small>Bước cuối cùng để hoàn tất</small>
                </div>
            </div>
        </div>

        <div class="login-brand-footer">
            <span class="login-foil-line"></span>
            <span>SMART TICKET · BẢO MẬT TÀI KHOẢN</span>
        </div>
    </div>

    <!-- RIGHT FORM CARD -->
    <div class="login-card">
        <div class="login-card-header">
            <p class="eyebrow" style="color: #8c5a36;">BƯỚC 03 / 03 · HOÀN TẤT KÍCH HOẠT</p>
            <h1 style="font-size: 24px; margin: 0 0 6px;">Bật xác thực hai lớp</h1>
            <p class="muted" style="margin-bottom: 18px;">
                Tài khoản: <strong style="color: #5e17eb;">@Model.Email</strong>
            </p>
        </div>

        <!-- INSTRUCTIONS -->
        <div class="totp-setup-guide">
            <div class="guide-step">
                <span class="g-num">1</span>
                <div>
                    <strong>Mở ứng dụng Authenticator</strong>
                    <p>Sử dụng Google Authenticator, Microsoft Authenticator hoặc 1Password trên điện thoại của bạn.</p>
                </div>
            </div>
            <div class="guide-step">
                <span class="g-num">2</span>
                <div>
                    <strong>Thêm tài khoản thủ công bằng Khóa bí mật (Secret Key)</strong>
                    <div class="secret-key-display">
                        <code id="sharedKeyText">@Model.SharedKey</code>
                        <button type="button" class="copy-key-btn" onclick="copySecretKey()" id="copyBtn" title="Sao chép khóa bí mật">
                            📋 Sao chép
                        </button>
                    </div>
                    <small class="field-help">Loại mã: Theo thời gian (Time-based / TOTP) · Nhà cung cấp: Smart Ticket</small>
                </div>
            </div>
            <div class="guide-step">
                <span class="g-num">3</span>
                <div>
                    <strong>Nhập mã 6 chữ số hiển thị trên ứng dụng</strong>
                </div>
            </div>
        </div>

        <form asp-action="VerifyAuthenticator" method="post" class="form-stack" style="margin-top: 18px;">
            <input asp-for="Token" type="hidden" />
            <input asp-for="Email" type="hidden" />
            <input asp-for="SharedKey" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="field">
                <label asp-for="AuthenticatorCode" style="text-align: center; font-size: 13px;">
                    Mã xác thực 6 chữ số
                </label>
                <input asp-for="AuthenticatorCode"
                       class="totp-code-input"
                       inputmode="numeric"
                       pattern="[0-9]*"
                       autocomplete="one-time-code"
                       maxlength="6"
                       placeholder="000 000"
                       autofocus
                       required />
                <span asp-validation-for="AuthenticatorCode" class="field-error" style="text-align: center;"></span>
            </div>

            <div style="margin-top: 14px;">
                <button type="submit" class="button button-primary button-wide" style="height: 48px;">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>
                    Xác nhận & Kích hoạt tài khoản
                </button>
            </div>
        </form>
    </div>
</section>



@section Scripts {
<script src="~/js/pages/operators-authenticator.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/operators-authenticator.css" asp-append-version="true" />
}
