@model IReadOnlyList<BusGoSmartTicket.Models.DTOs.Operators.DriverDto>
@{
    ViewData["Title"] = "Quản lý Tài xế - Smart Ticket";
}

<div class="drivers-page">
    <div class="page-heading">
        <div>
            <p class="eyebrow">NHÂN SỰ VẬN TẢI</p>
            <h1>Quản lý Tài xế</h1>
            <p>Khai báo đội ngũ lái xe chính thức, số điện thoại liên lạc và số giấy phép lái xe để phân công chuyến chạy.</p>
        </div>
        <div class="heading-actions">
            <a class="button button-outline" asp-action="Index">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                Về trung tâm điều hành
            </a>
            <a class="button button-primary" asp-action="CreateTrip">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                Lập lịch chuyến xe
            </a>
        </div>
    </div>

    @await Html.PartialAsync("_Feedback")

    <div class="driver-layout-grid">
        <!-- FORM THÊM TÀI XẾ -->
        <div class="form-card driver-form-card">
            <div class="form-header-bar">
                <div class="brand-sub-badge">HỒ SƠ LÁI XE</div>
                <h2>Thêm tài xế mới</h2>
                <p class="muted">Tài xế phải có giấy phép lái xe phù hợp với loại phương tiện vận hành.</p>
            </div>

            <form asp-action="CreateDriver" method="post" id="createDriverForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="form-grid">
                    <!-- HỌ VÀ TÊN -->
                    <div class="field field-full">
                        <label for="driverFullName">Họ và tên tài xế <span class="required">*</span></label>
                        <input id="driverFullName" name="FullName" class="form-input" required maxlength="160" placeholder="Ví dụ: Nguyễn Văn An" />
                        <small class="field-help">Tên tài xế sẽ hiển thị trên thông tin chuyến đi và vé của hành khách.</small>
                    </div>

                    <!-- SỐ ĐIỆN THOẠI -->
                    <div class="field">
                        <label for="driverPhone">Số điện thoại di động <span class="required">*</span></label>
                        <input id="driverPhone" name="Phone" type="tel" class="form-input" required maxlength="24" placeholder="Ví dụ: 0912 345 678" />
                        <small class="field-help">Dùng để điều phối viên và bến xe liên lạc khẩn cấp.</small>
                    </div>

                    <!-- SỐ GIẤY PHÉP LÁI XE -->
                    <div class="field">
                        <label for="driverLicense">Số giấy phép lái xe (GPLX) <span class="required">*</span></label>
                        <input id="driverLicense" name="LicenseNumber" class="form-input" required maxlength="40" placeholder="Ví dụ: 790123456789 (Hạng E)" />
                        <small class="field-help">Số GPLX còn hạn lưu hành theo quy định Bộ GTVT.</small>
                    </div>
                </div>

                <div class="form-footer">
                    <button type="submit" class="button button-primary">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                        Lưu thông tin tài xế
                    </button>
                </div>
            </form>
        </div>

        <!-- RIGHT INFO CARD -->
        <div class="driver-guide-card">
            <div class="guide-box">
                <div class="guide-icon">👨‍✈️</div>
                <h3>Tiêu chuẩn an toàn tài xế</h3>
                <p>
                    Để đảm bảo chất lượng dịch vụ và tính mạng của hành khách trên mọi cung đường:
                </p>
                <ul class="guide-bullets">
                    <li>
                        <strong>Bằng lái xe hợp lệ:</strong> Xe khách giường nằm và ghế ngồi từ 30 chỗ trở lên yêu cầu GPLX hạng E trở lên.
                    </li>
                    <li>
                        <strong>Phân công độc quyền theo ca:</strong> Một tài xế chỉ được phân công vào 1 chuyến xe trong cùng một khung giờ khởi hành.
                    </li>
                    <li>
                        <strong>Kết nối bến xe & hành khách:</strong> Khi chuyến xe đến bến, nhân viên trạm soát vé sẽ đối soát số điện thoại tài xế để bàn giao lệnh xuất bến.
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- TABLE DRIVERS LISTING -->
    <div class="table-card" style="margin-top: 28px;">
        <div class="table-toolbar">
            <div class="toolbar-left">
                <strong>Danh sách nhân sự lái xe</strong>
                <span id="driverCountLabel">(@Model.Count tài xế)</span>
            </div>
            <div class="search-input-wrap">
                <input type="text" id="driverSearchInput" placeholder="Tìm tên, số điện thoại, GPLX..." oninput="handleDriverSearch()" />
            </div>
        </div>

        <div class="table-scroll">
            <table id="driversTable">
                <thead>
                    <tr>
                        <th>Tài xế & Hồ sơ</th>
                        <th>Số điện thoại liên lạc</th>
                        <th>Số GPLX</th>
                        <th>Trạng thái</th>
                        <th class="actions-col">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var statusClass = item.IsActive ? "status-active" : "status-inactive";

                        <tr class="driver-row" data-keywords="@item.FullName.ToLower() @item.Phone.ToLower() @item.LicenseNumber.ToLower()">
                            <td class="primary-cell">
                                <div class="driver-name-cell">
                                    <div class="driver-avatar-circle">
                                        @(item.FullName.Length > 0 ? item.FullName[0].ToString().ToUpper() : "T")
                                    </div>
                                    <div>
                                        <strong>@item.FullName</strong>
                                        <small style="display:block; color:#777486; font-size:10px;">ID: @item.Id.ToString().Substring(0, 8)...</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <a href="tel:@item.Phone" class="driver-phone-link">
                                    📞 @item.Phone
                                </a>
                            </td>
                            <td>
                                <span class="license-code-badge">GPLX: @item.LicenseNumber</span>
                            </td>
                            <td>
                                <span class="status @statusClass">
                                    @(item.IsActive ? "✓ Hoạt động" : "✕ Đã ngừng")
                                </span>
                            </td>
                            <td class="actions-col">
                                <div class="row-actions">
                                    @if (item.IsActive)
                                    {
                                        <button type="button" class="action-btn edit-btn" onclick="openEditDriverModal('@item.Id', '@item.FullName', '@item.Phone', '@item.LicenseNumber')" title="Chỉnh sửa thông tin tài xế">
                                            ✏ Sửa
                                        </button>
                                        <form asp-action="DeactivateDriver" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn ngừng hoạt động tài xế @item.FullName?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="action-btn deactivate-btn" title="Ngừng hoạt động tài xế này">
                                                Ngừng
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="muted-small">Đã ngừng lái</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }

                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="empty-state">
                                <div class="empty-symbol">👨‍✈️</div>
                                <strong>Chưa có tài xế nào được thêm</strong>
                                <p>Sử dụng biểu mẫu phía trên để thêm tài xế đầu tiên của nhà xe vào hệ thống.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL CHỈNH SỬA TÀI XẾ -->
<div id="editDriverModal" class="reject-modal-backdrop" style="display:none;">
    <div class="reject-modal-card">
        <div class="modal-header">
            <h3>Chỉnh sửa thông tin tài xế</h3>
            <button type="button" class="close-btn" onclick="closeEditDriverModal()">&times;</button>
        </div>
        <form id="editDriverForm" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="field">
                    <label for="editFullNameInput">Họ và tên tài xế <span class="required">*</span></label>
                    <input id="editFullNameInput" name="FullName" class="form-input" required maxlength="160" />
                </div>
                <div class="field" style="margin-top: 12px;">
                    <label for="editPhoneInput">Số điện thoại di động <span class="required">*</span></label>
                    <input id="editPhoneInput" name="Phone" type="tel" class="form-input" required maxlength="24" />
                </div>
                <div class="field" style="margin-top: 12px;">
                    <label for="editLicenseInput">Số giấy phép lái xe <span class="required">*</span></label>
                    <input id="editLicenseInput" name="LicenseNumber" class="form-input" required maxlength="40" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="button button-outline" onclick="closeEditDriverModal()">Hủy bỏ</button>
                <button type="submit" class="button button-primary">Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>



@section Scripts {
<script src="~/js/pages/operators-drivers.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/operators-drivers.css" asp-append-version="true" />
}
