@model IReadOnlyList<BusGoSmartTicket.Models.DTOs.Operators.VehicleDto>
@{
    ViewData["Title"] = "Quản lý Phương tiện - Smart Ticket";
}

<div class="vehicles-page">
    <div class="page-heading">
        <div>
            <p class="eyebrow">ĐỘI XE NHÀ XE</p>
            <h1>Quản lý Phương tiện</h1>
            <p>Khai báo biển kiểm soát, chủng loại xe và gắn kết với mẫu sơ đồ ghế tương ứng để phục vụ điều hành lịch chạy.</p>
        </div>
        <div class="heading-actions">
            <a class="button button-outline" asp-action="Index">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                Về trung tâm điều hành
            </a>
            <a class="button button-outline" asp-action="SeatTemplates">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16m-7 6h7"/></svg>
                Mẫu sơ đồ ghế
            </a>
        </div>
    </div>

    @await Html.PartialAsync("_Feedback")

    <div class="vehicle-layout-grid">
        <!-- FORM THÊM PHƯƠNG TIỆN -->
        <div class="form-card vehicle-form-card">
            <div class="form-header-bar">
                <div class="brand-sub-badge">KHAI BÁO PHƯƠNG TIỆN</div>
                <h2>Thêm xe vào đội vận tải</h2>
                <p class="muted">Mỗi xe khi khai báo cần gắn một mẫu sơ đồ ghế đang có hiệu lực.</p>
            </div>

            <form asp-action="CreateVehicle" method="post" id="createVehicleForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="form-grid">
                    <!-- BIỂN SỐ XE -->
                    <div class="field">
                        <label for="newPlateInput">Biển số đăng ký xe <span class="required">*</span></label>
                        <input id="newPlateInput" name="PlateNumber" class="form-input" required maxlength="16" placeholder="Ví dụ: 51B-123.45 hoặc 29B-999.88" oninput="updatePlatePreview(this.value)" />
                        <small class="field-help">Định dạng chuẩn: Tỉnh/thành + Chữ cái + Số (5-16 ký tự).</small>
                    </div>

                    <!-- PREVIEW BIỂN SỐ -->
                    <div class="field" style="justify-content: flex-end;">
                        <label>Xem trước biển số xe:</label>
                        <div class="plate-preview-badge" id="platePreviewBadge">
                            <span class="plate-dot">●</span>
                            <span id="platePreviewText">51B-123.45</span>
                        </div>
                    </div>

                    <!-- CHỦNG LOẠI XE -->
                    <div class="field field-full">
                        <label for="newVehicleType">Chủng loại phương tiện <span class="required">*</span></label>
                        <input id="newVehicleType" name="VehicleType" class="form-input" required maxlength="80" placeholder="Ví dụ: Limousine Skybus 34 phòng VIP hoặc Xe Hyundai Universe 45 chỗ" />
                    </div>

                    <!-- MẪU SƠ ĐỒ GHẾ -->
                    <div class="field field-full">
                        <label for="newSeatTemplateSelect">Mẫu sơ đồ ghế áp dụng <span class="required">*</span></label>
                        <select id="newSeatTemplateSelect" name="SeatTemplateId" class="form-select" required asp-items="ViewBag.Templates">
                            <option value="">-- Chọn sơ đồ ghế tương thích --</option>
                        </select>
                        <small class="field-help">Chưa có mẫu ghế phù hợp? <a asp-action="SeatTemplates" style="color:#5e17eb; font-weight:700;">Tạo sơ đồ ghế mới ngay ↗</a></small>
                    </div>
                </div>

                <div class="form-footer">
                    <button type="submit" class="button button-primary">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                        Thêm xe vào đội
                    </button>
                </div>
            </form>
        </div>

        <!-- RIGHT INFO CARD -->
        <div class="vehicle-guide-card">
            <div class="guide-box">
                <div class="guide-icon">🚌</div>
                <h3>Nguyên tắc vận hành đội xe</h3>
                <p>
                    Hệ thống Smart Ticket bảo đảm tính nhất quán dữ liệu bán vé và an toàn khai thác:
                </p>
                <ul class="guide-bullets">
                    <li>
                        <strong>Gắn kết sơ đồ cố định:</strong> Sơ đồ ghế xác định tổng số ghế mở bán cho các chuyến của xe này.
                    </li>
                    <li>
                        <strong>Bảo vệ chuyến đang mở bán:</strong> Khi xe đã được gán vào chuyến xe đã phát sinh vé đặt, việc thay đổi hoặc ngừng hoạt động sẽ được kiểm soát chặt chẽ.
                    </li>
                    <li>
                        <strong>Biển số xe minh bạch:</strong> Biển kiểm soát sẽ hiển thị trên vé điện tử của khách và ứng dụng quét vé tại bến xe.
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- TABLE VEHICLES LISTING -->
    <div class="table-card" style="margin-top: 28px;">
        <div class="table-toolbar">
            <div class="toolbar-left">
                <strong>Danh sách phương tiện trong đội</strong>
                <span id="vehicleCountLabel">(@Model.Count xe)</span>
            </div>
            <div class="search-input-wrap">
                <input type="text" id="vehicleSearchInput" placeholder="Tìm biển số, loại xe, mẫu ghế..." oninput="handleVehicleSearch()" />
            </div>
        </div>

        <div class="table-scroll">
            <table id="vehiclesTable">
                <thead>
                    <tr>
                        <th>Biển kiểm soát</th>
                        <th>Chủng loại xe</th>
                        <th>Mẫu sơ đồ ghế</th>
                        <th>Sức chứa</th>
                        <th>Trạng thái</th>
                        <th class="actions-col">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var statusClass = item.IsActive ? "status-active" : "status-inactive";
                        var statusText = item.IsActive ? "Hoạt động" : "Đã ngừng";

                        <tr class="vehicle-row" data-keywords="@item.PlateNumber.ToLower() @item.VehicleType.ToLower() @item.TemplateName.ToLower()">
                            <td class="primary-cell">
                                <div class="plate-badge-cell">
                                    <span class="vn-plate">@item.PlateNumber</span>
                                </div>
                            </td>
                            <td>
                                <strong>@item.VehicleType</strong>
                            </td>
                            <td>
                                <span class="template-name-tag">@item.TemplateName</span>
                            </td>
                            <td>
                                <strong style="color: #5e17eb; font-size: 13px;">@item.SeatCount chỗ</strong>
                            </td>
                            <td>
                                <span class="status @statusClass">
                                    @(item.IsActive ? "✓ Hoạt động" : "✕ Đã ngừng")
                                </span>
                            </td>
                            <td class="actions-col">
                                <div class="row-actions">
                                    @if (item.IsActive)
                                    {
                                        <button type="button" class="action-btn edit-btn" onclick="openEditVehicleModal('@item.Id', '@item.PlateNumber', '@item.VehicleType', '@item.SeatTemplateId')" title="Chỉnh sửa thông tin xe">
                                            ✏ Sửa
                                        </button>
                                        <form asp-action="DeactivateVehicle" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn ngừng hoạt động xe @item.PlateNumber?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="action-btn deactivate-btn" title="Ngừng hoạt động xe này">
                                                Ngừng
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="muted-small">Đã ngừng khai thác</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }

                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="empty-state">
                                <div class="empty-symbol">🚌</div>
                                <strong>Chưa có phương tiện nào trong đội xe</strong>
                                <p>Sử dụng biểu mẫu phía trên để thêm chiếc xe đầu tiên của nhà xe vào hệ thống.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL CHỈNH SỬA XE -->
<div id="editVehicleModal" class="reject-modal-backdrop" style="display:none;">
    <div class="reject-modal-card">
        <div class="modal-header">
            <h3>Chỉnh sửa thông tin phương tiện</h3>
            <button type="button" class="close-btn" onclick="closeEditVehicleModal()">&times;</button>
        </div>
        <form id="editVehicleForm" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="field">
                    <label for="editPlateInput">Biển số xe <span class="required">*</span></label>
                    <input id="editPlateInput" name="PlateNumber" class="form-input" required maxlength="16" />
                </div>
                <div class="field" style="margin-top: 12px;">
                    <label for="editTypeInput">Chủng loại xe <span class="required">*</span></label>
                    <input id="editTypeInput" name="VehicleType" class="form-input" required maxlength="80" />
                </div>
                <div class="field" style="margin-top: 12px;">
                    <label for="editTemplateSelect">Mẫu sơ đồ ghế <span class="required">*</span></label>
                    <select id="editTemplateSelect" name="SeatTemplateId" class="form-select" required asp-items="ViewBag.Templates"></select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="button button-outline" onclick="closeEditVehicleModal()">Hủy bỏ</button>
                <button type="submit" class="button button-primary">Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>



@section Scripts {
<script src="~/js/pages/operators-vehicles.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/operators-vehicles.css" asp-append-version="true" />
}
