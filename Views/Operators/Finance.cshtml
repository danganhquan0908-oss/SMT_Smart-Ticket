@model IReadOnlyList<BusGoSmartTicket.Models.DTOs.Operations.SettlementDto>
@{
    ViewData["Title"] = "Đối soát & Thanh toán Nhà xe - Smart Ticket";
    var totalGross = Model.Sum(x => x.GrossAmount);
    var totalCommission = Model.Sum(x => x.CommissionAmount);
    var totalNet = Model.Sum(x => x.NetAmount);
}

<div class="operator-finance-page">
    <div class="page-heading">
        <div>
            <p class="eyebrow">TÀI CHÍNH & ĐỐI SOÁT DOANH THU</p>
            <h1>Đối soát doanh thu & Tài khoản nhận tiền</h1>
            <p>Minh bạch doanh thu vé, phí nền tảng và quản lý lệnh thanh toán tự động sau khi chuyến xe hoàn tất.</p>
        </div>
        <div class="heading-actions">
            <a class="button button-outline" asp-controller="OperatorPortal" asp-action="Index">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                Về trung tâm điều hành
            </a>
        </div>
    </div>

    @await Html.PartialAsync("_Feedback")

    <!-- SUMMARY METRICS -->
    <div class="metric-grid" style="grid-template-columns: repeat(3, 1fr); margin-bottom: 24px;">
        <div class="metric-card">
            <div class="metric-icon" style="background: #f2edff; color: #5e17eb;">💰</div>
            <div>
                <span>Tổng doanh thu vé (Gross)</span>
                <strong>@totalGross.ToString("N0") ₫</strong>
            </div>
        </div>
        <div class="metric-card">
            <div class="metric-icon" style="background: #fff0f3; color: #c81d4a;">📊</div>
            <div>
                <span>Phí dịch vụ nền tảng (Commission)</span>
                <strong>@totalCommission.ToString("N0") ₫</strong>
            </div>
        </div>
        <div class="metric-card">
            <div class="metric-icon" style="background: #eaf8f2; color: #16825d;">🏦</div>
            <div>
                <span>Thực nhận về tài khoản (Net)</span>
                <strong style="color: #16825d;">@totalNet.ToString("N0") ₫</strong>
            </div>
        </div>
    </div>

    <!-- TÀI KHOẢN NHẬN TIỀN -->
    <section class="form-card" style="margin-bottom: 24px; max-width: 100%;">
        <div class="form-header-bar">
            <div class="brand-sub-badge">TÀI KHOẢN NGÂN HÀNG NHẬN ĐỐI SOÁT</div>
            <h2>Cấu hình tài khoản Payout thụ hưởng</h2>
            <p class="muted">Hệ thống chuyển tiền tự động sau khi chuyến xe hoàn tất xuất bến và xác nhận hành trình.</p>
        </div>

        <form asp-action="PayoutAccount" method="post" class="form-grid">
            @Html.AntiForgeryToken()
            <div class="field">
                <label>Mã BIN Ngân hàng (6 chữ số) <span class="required">*</span></label>
                <input name="BankBin" class="form-input" pattern="[0-9]{6}" maxlength="6" placeholder="Ví dụ: 970422 (MB Bank) hoặc 970436 (Vietcombank)" required />
                <small class="field-help">Mã 6 số định danh ngân hàng theo chuẩn Napas.</small>
            </div>

            <div class="field">
                <label>Số tài khoản ngân hàng <span class="required">*</span></label>
                <input name="AccountNumber" class="form-input" minlength="5" maxlength="28" placeholder="Ví dụ: 0123456789" required />
                <small class="field-help">Số tài khoản chính chủ của doanh nghiệp vận tải.</small>
            </div>

            <div class="field field-full">
                <label>Tên chủ tài khoản thụ hưởng (Không dấu) <span class="required">*</span></label>
                <input name="AccountName" class="form-input" maxlength="100" placeholder="Ví dụ: CONG TY TNHH VAN TAI PHUONG TRANG" required style="text-transform: uppercase;" />
            </div>

            <div class="form-footer field-full" style="margin-top: 12px; padding-top: 14px;">
                <button type="submit" class="button button-primary">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>
                    Lưu thông tin tài khoản nhận tiền
                </button>
            </div>
        </form>
    </section>

    <!-- SETTLEMENTS TABLE -->
    <div class="table-card">
        <div class="table-toolbar">
            <div class="toolbar-left">
                <strong>Lịch sử đối soát các chuyến xe</strong>
                <span>(@Model.Count phiên đối soát)</span>
            </div>
            <div class="live-label"><i></i> Tự động kết toán</div>
        </div>

        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th>Mã chuyến (Trip ID)</th>
                        <th>Doanh thu vé</th>
                        <th>Phí nền tảng</th>
                        <th>Thực nhận</th>
                        <th>Trạng thái</th>
                        <th>Mã giao dịch đối soát</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="primary-cell">
                                <span class="code-pill">@s.TripId.ToString().Substring(0, 8)...</span>
                            </td>
                            <td>
                                <strong>@s.GrossAmount.ToString("N0") ₫</strong>
                            </td>
                            <td>
                                <span style="color: #c81d4a;">-@s.CommissionAmount.ToString("N0") ₫</span>
                            </td>
                            <td>
                                <strong style="color: #16825d; font-size: 14px;">@s.NetAmount.ToString("N0") ₫</strong>
                            </td>
                            <td>
                                @if (s.Status == "Paid")
                                {
                                    <span class="status status-active" style="background: #d1fae5; color: #065f46; font-weight: 750;">✓ ĐÃ GIẢI NGÂN</span>
                                }
                                else if (s.Status == "Processing")
                                {
                                    <span class="status" style="background: #fef3c7; color: #92400e;">⏳ ĐANG XỬ LÝ</span>
                                }
                                else
                                {
                                    <span class="status status-inactive" style="background: #f1ecf9; color: #5e17eb;">@s.Status</span>
                                    <form asp-action="TriggerPayout" asp-route-settlementId="@s.Id" method="post" style="display: inline-block; margin-left: 6px;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="button-mini-update" style="background: #5e17eb; color: #fff; border: 0; padding: 3px 8px; border-radius: 6px; font-size: 10px; font-weight: 750; cursor: pointer;">Giải ngân</button>
                                    </form>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(s.ProviderReference))
                                {
                                    <code style="font-size: 11px; color: #059669; font-weight: 700;">@s.ProviderReference</code>
                                }
                                else
                                {
                                    <span style="color: #8c8699; font-size: 11px;">Chờ thanh toán Napas</span>
                                }
                            </td>
                        </tr>
                    }

                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="empty-state">
                                <div class="empty-symbol">💳</div>
                                <strong>Chưa có chuyến hoàn tất cần đối soát</strong>
                                <p>Khi các chuyến xe kết thúc hành trình an toàn, phiên đối soát và lệnh thanh toán sẽ tự động xuất hiện tại đây.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>



@section Styles {
    <link rel="stylesheet" href="~/css/pages/operators-finance.css" asp-append-version="true" />
}
