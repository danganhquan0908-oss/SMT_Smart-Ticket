@model BusGoSmartTicket.Models.ViewModels.OperatorActivationForm
@{
    ViewData["Title"] = "Thiết lập Mật khẩu Quản trị - Smart Ticket";
}

<section class="login-shell">
    <!-- LEFT BRAND PANEL -->
    <div class="login-brand-panel">
        <div class="login-logo-frame">
            <img src="~/images/favicon.svg" alt="Smart Ticket SMT" asp-append-version="true" />
        </div>
        <p class="eyebrow">SMT PARTNER ONBOARDING</p>
        <h2>Bảo vệ tài khoản <em>Đối tác</em></h2>
        <p class="login-brand-copy">
            Hồ sơ nhà xe của bạn đã được phê duyệt thành công. Vui lòng tạo mật khẩu quản trị bảo mật cao trước khi kích hoạt bảo mật hai lớp (2FA).
        </p>

        <!-- PROGRESS MILESTONES -->
        <div class="activation-milestones">
            <div class="milestone completed">
                <span class="m-dot">✓</span>
                <div>
                    <strong>Thẩm định hồ sơ</strong>
                    <small>Đã duyệt pháp nhân & MST</small>
                </div>
            </div>
            <div class="milestone active">
                <span class="m-dot">2</span>
                <div>
                    <strong>Tạo mật khẩu an toàn</strong>
                    <small>Đang thực hiện</small>
                </div>
            </div>
            <div class="milestone">
                <span class="m-dot">3</span>
                <div>
                    <strong>Bật xác thực hai lớp (2FA)</strong>
                    <small>Bắt buộc cho tài khoản Đối tác</small>
                </div>
            </div>
        </div>

        <div class="login-brand-footer">
            <span class="login-foil-line"></span>
            <span>SMART TICKET · BẢO MẬT DOANH NGHIỆP</span>
        </div>
    </div>

    <!-- RIGHT FORM CARD -->
    <div class="login-card">
        <div class="login-card-header">
            <p class="eyebrow" style="color: #8c5a36;">BƯỚC 02 / 03</p>
            <h1 style="font-size: 24px; margin: 0 0 6px;">Tạo mật khẩu đăng nhập</h1>
            <p class="muted" style="margin-bottom: 20px;">
                Tài khoản đối tác: <strong style="color: #5e17eb;">@Model.Email</strong>
            </p>
        </div>

        <form asp-action="SetPassword" method="post" class="form-stack" id="setPasswordForm">
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="field">
                <label asp-for="Password">Mật khẩu mới <span style="color:#c81d4a;">*</span></label>
                <div class="password-input-wrap">
                    <input asp-for="Password" type="password" id="passwordInput" autocomplete="new-password" class="form-input" placeholder="Tối thiểu 12 ký tự" required />
                    <button type="button" class="eye-toggle-btn" onclick="togglePasswordVisibility('passwordInput', this)" title="Ẩn/hiện mật khẩu">👁</button>
                </div>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="field" style="margin-top: 10px;">
                <label asp-for="ConfirmPassword">Nhập lại mật khẩu mới <span style="color:#c81d4a;">*</span></label>
                <div class="password-input-wrap">
                    <input asp-for="ConfirmPassword" type="password" id="confirmPasswordInput" autocomplete="new-password" class="form-input" placeholder="Nhập lại mật khẩu vừa đặt" required />
                    <button type="button" class="eye-toggle-btn" onclick="togglePasswordVisibility('confirmPasswordInput', this)" title="Ẩn/hiện mật khẩu">👁</button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <!-- SECURITY CHECKLIST -->
            <div class="password-rules-box">
                <span class="rules-title">Yêu cầu bảo mật mật khẩu:</span>
                <ul class="rules-list">
                    <li id="rule-len">○ Tối thiểu 12 ký tự</li>
                    <li id="rule-upper">○ Có chữ cái hoa (A-Z) & thường (a-z)</li>
                    <li id="rule-digit">○ Có ít nhất 1 chữ số (0-9)</li>
                    <li id="rule-special">○ Có ít nhất 1 ký tự đặc biệt (!@@#$%^&*)</li>
                </ul>
            </div>

            <div style="margin-top: 16px;">
                <button type="submit" class="button button-primary button-wide" style="height: 48px;">
                    Tiếp tục thiết lập 2FA →
                </button>
            </div>
        </form>
    </div>
</section>



@section Scripts {
<script src="~/js/pages/operators-setpassword.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/operators-setpassword.css" asp-append-version="true" />
}
