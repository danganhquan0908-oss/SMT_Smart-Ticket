@model IReadOnlyList<BusGoSmartTicket.Models.DTOs.Operators.OperatorTripDto>
@{
    ViewData["Title"] = "Quản lý Chuyến xe - Smart Ticket";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">ĐIỀU HÀNH LỊCH CHẠY</p>
        <h1>Chuyến xe & Giá vé</h1>
        <p>Phân xe, tài xế, quản lý giờ chạy và toàn quyền điều chỉnh giá vé niêm yết của nhà xe.</p>
    </div>
    <div class="heading-actions">
        <a class="button button-outline" asp-action="Index">← Bảng điều hành</a>
        <a class="button button-primary" asp-action="CreateTrip">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
            Tạo chuyến xe mới
        </a>
    </div>
</div>

@await Html.PartialAsync("_Feedback")

<div class="tenant-isolation-banner" style="margin-bottom: 1.5rem; padding: 1rem 1.25rem; border-radius: 14px; background: rgba(59, 130, 246, 0.08); border: 1px solid rgba(59, 130, 246, 0.25); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
    <div style="display: flex; align-items: center; gap: 0.85rem;">
        <span style="font-size: 1.75rem;">🏢</span>
        <div>
            <div style="font-weight: 700; color: var(--text-primary); font-size: 1.1rem;">
                Nhà xe đang điều hành: <span style="color: var(--accent-gold, #D4AF37);">@(ViewBag.OperatorName ?? "SMT Express")</span>
                @if (!string.IsNullOrEmpty(ViewBag.OperatorTaxCode as string))
                {
                    <span style="font-size: 0.85rem; font-weight: normal; opacity: 0.85;">(MST: @ViewBag.OperatorTaxCode)</span>
                }
            </div>
            <div style="font-size: 0.85rem; color: var(--text-muted, #94a3b8); margin-top: 0.2rem;">
                🛡️ <strong>Chính sách cách ly đa nhà xe (Multi-Tenant Isolation):</strong> Bạn chỉ có quyền xem, lên lịch và điều chỉnh giá vé của các chuyến xe thuộc thẩm quyền của <strong>@(ViewBag.OperatorName ?? "nhà xe này")</strong>. Hệ thống tự động ngăn chặn và từ chối mọi quyền can thiệp vào chuyến của các nhà xe đối tác khác.
            </div>
        </div>
    </div>
    <div style="display: flex; gap: 0.5rem; align-items: center;">
        <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #10B981; border: 1px solid rgba(16, 185, 129, 0.3); font-size: 0.8rem; padding: 0.35rem 0.65rem; border-radius: 999px; font-weight: 600;">
            ✓ Đã xác thực phân quyền Nhà xe
        </span>
    </div>
</div>

<div class="table-card">
    <div class="table-toolbar">
        <div>
            <strong>Danh sách các chuyến xe đang khai thác</strong>
            <span>(@Model.Count chuyến xe)</span>
        </div>
        <div class="status-legend-chips">
            <span class="status status-active">Đã lên lịch</span>
            <span class="status status-running">Đang chạy</span>
            <span class="status status-inactive">Hoàn tất</span>
        </div>
    </div>

    <div class="table-scroll">
        <table>
            <thead>
                <tr>
                    <th>Tuyến đường</th>
                    <th>Phương tiện & Tài xế</th>
                    <th>Thời gian khởi hành</th>
                    <th>Giá vé niêm yết & Số vé</th>
                    <th>Trạng thái</th>
                    <th class="actions-col">Điều chỉnh giá vé & Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var trip in Model)
                {
                    var departLocal = trip.DepartureTimeUtc.AddHours(7); // Giờ Việt Nam chuẩn xác và an toàn trên mọi hệ điều hành
                    <tr>
                        <td class="primary-cell">
                            <div class="route-title-cell">@trip.RouteName</div>
                        </td>
                        <td>
                            <strong class="plate-badge">@trip.PlateNumber</strong>
                            <small class="driver-name-sub">Tài xế: @trip.DriverName</small>
                        </td>
                        <td>
                            <div class="time-bold">@departLocal.ToString("HH:mm")</div>
                            <small class="date-sub">@departLocal.ToString("dd/MM/yyyy")</small>
                        </td>
                        <td>
                            <div class="price-bold">@trip.TicketPrice.ToString("N0") ₫</div>
                            <small class="sold-sub">@trip.SoldTicketCount vé đã bán</small>
                        </td>
                        <td>
                            @if (trip.Status == BusGoSmartTicket.Models.Entities.TripStatus.Scheduled)
                            {
                                <span class="status status-active">Scheduled</span>
                            }
                            else if (trip.Status == BusGoSmartTicket.Models.Entities.TripStatus.Running)
                            {
                                <span class="status status-running">Running</span>
                            }
                            else
                            {
                                <span class="status status-inactive">@trip.Status</span>
                            }
                        </td>
                        <td>
                            <div class="trip-action-wrapper">
                                <!-- Form đổi giá vé trực tiếp có Audit Log -->
                                <form class="inline-price-form" asp-action="ChangePrice" asp-route-id="@trip.Id" method="post">
                                    <input name="NewPrice" type="number" min="10000" step="1000" value="@trip.TicketPrice" aria-label="Giá vé mới" class="input-mini-price" />
                                    <button type="submit" class="button-mini-update">Đổi giá</button>
                                </form>

                                <div class="trip-sub-actions">
                                    <a asp-action="EditTrip" asp-route-id="@trip.Id" class="action-link">Sửa lịch</a>
                                    <span class="sep">·</span>
                                    <a asp-action="PriceHistory" asp-route-id="@trip.Id" class="action-link">Lịch sử giá</a>

                                    @if (trip.Status == BusGoSmartTicket.Models.Entities.TripStatus.Running)
                                    {
                                        <span class="sep">·</span>
                                        <form asp-controller="OperatorFinance" asp-action="Complete" asp-route-tripId="@trip.Id" method="post" style="display: inline;">
                                            <button type="submit" class="action-link text-crimson" onclick="return confirm('Xác nhận chuyến xe đã hoàn tất lộ trình?');">Hoàn tất chuyến</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </td>
                    </tr>
                }

                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="empty-state">
                            <div style="font-size: 32px; margin-bottom: 8px;">🚌</div>
                            <strong>Chưa có chuyến xe nào được tạo.</strong>
                            <p style="margin: 6px 0 16px; font-size: 13px; color: var(--muted, #777486);">Vui lòng tạo mẫu sơ đồ ghế, phương tiện và tài xế trước khi tạo chuyến xe.</p>
                            <a asp-action="CreateTrip" class="button button-primary" style="display: inline-flex;">+ Tạo chuyến đầu tiên</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>



@section Styles {
    <link rel="stylesheet" href="~/css/pages/operators-trips.css" asp-append-version="true" />
}
