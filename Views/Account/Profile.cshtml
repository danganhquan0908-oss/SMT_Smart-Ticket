@model BusGoSmartTicket.Models.ViewModels.CustomerProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân & Bảo mật - Smart Ticket";
}

<div class="profile-page-shell">
    <div class="profile-header-banner">
        <div class="profile-header-content">
            <span class="eyebrow">TRUNG TÂM TÀI KHOẢN HÀNH KHÁCH</span>
            <h1>Hồ sơ cá nhân & Bảo mật</h1>
            <p class="muted">Quản lý thông tin liên hệ khi nhận vé điện tử và cập nhật mật khẩu bảo vệ tài khoản.</p>
        </div>
        <div class="profile-quick-nav">
            <a class="button button-primary" asp-controller="Account" asp-action="Tickets">
                🎟️ Xem vé của tôi →
            </a>
        </div>
    </div>

    @if (TempData["ProfileSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>✓ Thành công!</strong> @TempData["ProfileSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["PasswordSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>✓ Thành công!</strong> @TempData["PasswordSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["PasswordError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>⚠️ Lỗi:</strong> @TempData["PasswordError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="profile-grid">
        <!-- CỘT 1: THÔNG TIN CÁ NHÂN -->
        <div class="profile-card">
            <div class="card-header-row">
                <div class="card-icon-badge">👤</div>
                <div>
                    <h2>Thông tin hành khách</h2>
                    <p class="muted">Tên và số điện thoại này sẽ tự động điền khi bạn đặt vé mới.</p>
                </div>
            </div>

            <form asp-action="Profile" method="post" class="form-stack">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="form-group-item">
                    <label asp-for="FullName">Họ và tên hành khách <span class="text-danger">*</span></label>
                    <input asp-for="FullName" class="form-control" placeholder="Ví dụ: Đặng Anh Quân" maxlength="160" required />
                    <span asp-validation-for="FullName" class="field-error"></span>
                </div>

                <div class="form-group-item">
                    <label asp-for="PhoneNumber">Số điện thoại liên hệ</label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="Ví dụ: 0345 588 495" maxlength="24" />
                    <span asp-validation-for="PhoneNumber" class="field-error"></span>
                </div>

                <div class="form-group-item">
                    <label asp-for="Email">Địa chỉ Email (Định danh tài khoản)</label>
                    <div class="input-lock-wrapper">
                        <input asp-for="Email" class="form-control input-readonly" readonly />
                        <span class="lock-shield" title="Email được cố định làm định danh đăng nhập">🔒 Cố định</span>
                    </div>
                    <small class="form-text text-muted">Email dùng để nhận vé điện tử và đăng nhập, không thể thay đổi trực tiếp.</small>
                </div>

                <button type="submit" class="button button-primary button-wide mt-3">
                    Lưu thay đổi thông tin
                </button>
            </form>
        </div>

        <!-- CỘT 2: ĐỔI MẬT KHẨU -->
        <div class="profile-card">
            <div class="card-header-row">
                <div class="card-icon-badge">🔑</div>
                <div>
                    <h2>Đổi mật khẩu bảo mật</h2>
                    <p class="muted">Mật khẩu cần tối thiểu 12 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</p>
                </div>
            </div>

            <form asp-action="ChangePassword" method="post" class="form-stack">
                <div class="form-group-item">
                    <label for="CurrentPassword">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                    <input type="password" id="CurrentPassword" name="CurrentPassword" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu đang dùng" required />
                </div>

                <div class="form-group-item">
                    <label for="NewPassword">Mật khẩu mới <span class="text-danger">*</span></label>
                    <input type="password" id="NewPassword" name="NewPassword" class="form-control" autocomplete="new-password" placeholder="Tối thiểu 12 ký tự mạnh" minlength="12" required />
                </div>

                <div class="form-group-item">
                    <label for="ConfirmPassword">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                    <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" minlength="12" required />
                </div>

                <button type="submit" class="button button-secondary button-wide mt-3">
                    Cập nhật mật khẩu mới
                </button>
            </form>
        </div>
    </div>
</div>



@section Styles {
    <link rel="stylesheet" href="~/css/pages/account-profile.css" asp-append-version="true" />
}
