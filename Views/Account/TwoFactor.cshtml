@model BusGoSmartTicket.Models.ViewModels.TwoFactorViewModel
@{ ViewData["Title"] = "Xác thực hai lớp"; }
<section class="login-shell"><div class="login-card"><div class="brand-mark">SMT</div><p class="eyebrow">BẢO MẬT TÀI KHOẢN</p><h1>Nhập mã xác thực</h1><p class="muted">Nhập mã 6 chữ số từ ứng dụng xác thực của bạn.</p><form asp-action="TwoFactor" method="post" class="form-stack"><input asp-for="ReturnUrl" type="hidden" /><input asp-for="RememberMe" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="Code">Mã xác thực</label><input asp-for="Code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" /><span asp-validation-for="Code" class="field-error"></span><button class="button button-primary button-wide">Xác minh</button></form></div></section>
